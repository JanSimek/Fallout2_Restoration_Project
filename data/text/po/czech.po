msgid "Monitors"
msgstr "Monitory"

#: game/pro_scen.msg:76101 game/pro_scen.msg:76201 game/pro_scen.msg:76301
#: game/pro_scen.msg:76401
msgid "You cannot read anything on the monitor due to the amount of goo splashed across the screens."
msgstr "Kvůli podivnému slizu rozteklému přes obrazovky nedokážeš z monitoru nic přečíst."

#: game/pro_scen.msg:76500 game/pro_scen.msg:76600
msgid "UNUSED ART"
msgstr "UNUSED ART"

#: game/pro_scen.msg:76800
msgid "Bomb"
msgstr "Bomba"

#: game/pro_scen.msg:76801
msgid "This is a nuclear bomb. It looks very dangerous just sitting there."
msgstr "Toto je atomová bomba. Vypadá nebezpečně už jenom tím, jak si tu tiše leží."

#: game/pro_scen.msg:76900
msgid "Support Base"
msgstr "Stojan"

#: game/pro_scen.msg:76901
msgid "This base cradles the nuclear bomb that is sitting on it."
msgstr "Stojan na atomovou bombu."

#: game/pro_scen.msg:77001
msgid "This is a nuclear access computer. The computer looks very secure. There is a slot for a strangely shaped key."
msgstr "Toto je ovládací počítač atomové bomby. Vypadá velmi zabezpečeně. Je tu také drážka pro klíč podivného tvaru."

#: game/pro_scen.msg:77100
msgid "Wires"
msgstr "Kabely"

#: game/pro_scen.msg:77101
msgid "These wires are connecting the bomb to the computer."
msgstr "Tyto kabely propojují bombu s počítačem."

#: game/pro_scen.msg:77201 game/pro_scen.msg:77301 game/pro_scen.msg:77401
#: game/pro_scen.msg:77501 game/pro_scen.msg:77601 game/pro_scen.msg:77701
#: game/pro_scen.msg:77801 game/pro_scen.msg:77901
msgid "There is nothing unusual about this chair."
msgstr "Na této židli není nic zvláštního."

#: game/pro_scen.msg:78000 game/pro_scen.msg:78100 game/pro_scen.msg:78200
#: game/pro_scen.msg:78300 game/pro_scen.msg:82900 game/pro_wall.msg:84400
#: game/pro_wall.msg:198700
msgid "Pillar"
msgstr "Sloup"

#: game/pro_scen.msg:78001 game/pro_scen.msg:78101 game/pro_scen.msg:78201
#: game/pro_scen.msg:78301
msgid "A support pillar."
msgstr "Opěrný pilíř."

#: game/pro_scen.msg:78401
msgid "This bed is in wretched condition."
msgstr "Tato postel je v ubohém stavu."

#: game/pro_scen.msg:78501
msgid "This bed is in very poor condition."
msgstr "Tato postel je ve velmi bídném stavu."

#: game/pro_scen.msg:78601
msgid "This bed is in poor condition."
msgstr "Tato postel je v bídném stavu."

#: game/pro_scen.msg:78701
msgid "This bed is in pretty bad condition."
msgstr "ato postel je v docela špatném stavu."

#: game/pro_scen.msg:78801 game/pro_scen.msg:78901 game/pro_scen.msg:79001
#: game/pro_scen.msg:79101
msgid "These monitors are broken and cannot function."
msgstr "Tyto monitory jsou rozbité a nefungují."

#: game/pro_scen.msg:79201
msgid "Very little fresh air is coming from this vent."
msgstr "Z ventilace vychází jen slabý závan čerstvého vzduchu."

