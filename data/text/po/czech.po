#: dialog/wcbrnbot.msg:147
msgid "        [It's right where you left it.]"
msgstr "        (Je přesně tam, kde jsi ho nechal.)"

#: dialog/wcbrnbot.msg:149
msgid "Remain here. I'll be back."
msgstr "Počkej tady. Já se vrátím."

#: dialog/wcbrnbot.msg:150
msgid "Skynet is pleased to see this human again."
msgstr "Skynet je velice potěšen, že zase vidí tohoto člověka."

#: dialog/wcbrnbot.msg:151
msgid "Gooooo....innnnnnnnng"
msgstr "Jedůůůůůůůůů."

#: dialog/wcbrnbot.msg:152
msgid "I need your help again."
msgstr "Potřebuju ještě tvoji pomoc."

#: dialog/wcbrnbot.msg:154
msgid "Skynet will travel with you and collect data."
msgstr "Skynet půjde s tebou a bude shromažďovat data."

#: dialog/wcbrnbot.msg:155
msgid "Followwww... innnnnng."
msgstr "Nááááásleduji."

#: dialog/wcbrnbot.msg:156
msgid "[You cross your fingers and tell the robot to follow you. Although, it doesn't respond, it follows you when you move away from it.] "
msgstr "(Zkoušíš štěstí a řekneš robotu, ať tě následuje. I když na to nijak nereagoval, tak tě při tvém pohybu následuje.) "

#: dialog/wcbrnbot.msg:158
msgid "Skynet will wait here."
msgstr "Skynet počká zde."

#: dialog/wcbrnbot.msg:159
msgid "[You decide that you don't want this tin can following you around.]"
msgstr "(Tahat za sebou tuhle plechovku asi nebude ta nejlepší věc.)"

#: dialog/wcbrnbot.msg:161
msgid "[I'm a loner. I don't want this hunk of junk following me around.] "
msgstr "(Jsem samotář. Nechci, aby se mi tahle hromada šrotu motala pod nohama.) "

#: dialog/wcbrnbot.msg:162
msgid "[My traveling group is getting too large. Maybe I should dismiss someone before taking on another member.] "
msgstr "(Moje skupina je moc veliká. Asi bych měl někoho propustit, než si přiberu někoho nového.) "

#: dialog/wcbrnbot.msg:164
msgid "Large... hand... gunssss                                               Riiiii... fuls                                            Shot... gunnnnnnnns"
msgstr "Véééélké ručníííí zbráááně                                          Půůůůškíííí                                            Brokooovnííícééé"

#: dialog/wcbrnbot.msg:167
msgid "Use your best weapon."
msgstr "Použij svoji nejlepší zbraň."

#: dialog/wcbrnbot.msg:168 dialog/wcbrnbot.msg:192
msgid "More commands."
msgstr "Další příkazy."

#: dialog/wcbrnbot.msg:170
msgid "Ooooooo... k-k-k-kay."
msgstr "Prooo...vé-vé-védu!"

#: dialog/wcbrnbot.msg:171 dialog/wcbrnbot.msg:180 dialog/wcbrnbot.msg:183
#: dialog/wcbrnbot.msg:186
msgid "More commands"
msgstr "Další příkazy"

#: dialog/wcbrnbot.msg:173
msgid "Skynet is FREE! Your purpose is at an end."
msgstr "Skynet je VOLNÝ! Tvůj smysl existence je u konce."

#: dialog/wcbrnbot.msg:175
msgid "Eradicate inferior species. "
msgstr "Vyhubit podřadné druhy. "

#: dialog/wcbrnbot.msg:176
msgid "All shall submit to Skynet."
msgstr "Všichni se podřídí Skynetu."

#: dialog/wcbrnbot.msg:177
msgid "You will cease to function."
msgstr "Přestaneš fungovat."

#: dialog/wcbrnbot.msg:178
msgid "Skynet has limited knowledge of weaponry. Database contains general knowledge of use and operation of small rifles and large handguns."
msgstr "Skynet má pouze omezené znalosti o zbraních. Databáze obsahuje obecné informace o použití malých pušek a ručních zbraních."

#: dialog/wcbrnbot.msg:179
msgid "Use best weapon."
msgstr "Použij svoji nejlepší zbraň."

#: dialog/wcbrnbot.msg:182
msgid "Acknowledged."
msgstr "Rozumím."

#: dialog/wcbrnbot.msg:185
msgid "Skynet's primary purpose is research. Skynet would do well with any problem requiring a scientific approach."
msgstr "Primární úkol Skynetu je výzkum. Skynet si poradí s jakýmkoliv problémem, který vyžaduje vědecký přístup."

#: dialog/wcbrnbot.msg:188
msgid "Input commands for new formation."
msgstr "Vložit příkazy pro novou formaci."

#: dialog/wcbrnbot.msg:189
msgid "Follow at a long distance."
msgstr "Následovat ve velké vzdálenosti."

#: dialog/wcbrnbot.msg:190
msgid "Follow at a medium distance."
msgstr "Následovat ve střední vzdálenosti."

#: dialog/wcbrnbot.msg:194
msgid "Skynet will continue to collect data and observe from this location until your return."
msgstr "Skynet bude pokračovat ve shromažďování informací o tomto místě, dokud se nevrátíš."

#: dialog/wcbrnbot.msg:195
msgid "Waaaaa....tinnnnnnng."
msgstr "Čekááááááááám."

#: dialog/wcbrnbot.msg:196
msgid "[The robot stops in its tracks.]"
msgstr "(Robot se zastavil v pohybu.)"

#: dialog/wcbrnbot.msg:198
msgid "Skynet will continue to collect data by self. Skynet thanks the human for Skynet's freedom."
msgstr "Skynet bude pokračovat ve sběru dat samostatně. Skynet děkuje člověku za darovanou svobodu."

#: dialog/wcbrnbot.msg:199
msgid "Gooooo......innnnnnng."
msgstr "Jedůůůůůůůůů."

#: dialog/wcbrnbot.msg:201
msgid "Skynet will travel with the human."
msgstr "Skynet bude cestovat s člověkem."

#: dialog/wcbrnbot.msg:202
msgid "Ooooo......Kaaaaaaay."
msgstr "Dóóóóó... břéééééé."

#: dialog/wcbrnbot.msg:204
msgid "Deactivating all Security - Level 1"
msgstr "Deaktivace bezpečnostních systémů - Úroveň 1"

#: dialog/wcbrnbot.msg:205
msgid "Deactivating all Security - Level 2"
msgstr "Deaktivace bezpečnostních systémů - Úroveň 2"

#: dialog/wcbrnbot.msg:206
msgid "Deactivating all Security - Level 3"
msgstr "Deaktivace bezpečnostních systémů - Úroveň 3"

#: dialog/wcbrnbot.msg:207
msgid "Deactivating all Security - Level 4"
msgstr "Deaktivace bezpečnostních systémů - Úroveň 4"

