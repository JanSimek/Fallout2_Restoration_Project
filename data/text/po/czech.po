#: game/pro_wall.msg:48300 game/pro_wall.msg:48400 game/pro_wall.msg:48500
#: game/pro_wall.msg:48600
msgid "Bar"
msgstr "Bar"

#: game/pro_scen.msg:9401
msgid "This bar has a collection of brewed beverages ready to pour."
msgstr "V tomto baru je množství lahví s nejrůznějšími destiláty. Jen je načepovat."

#: game/pro_scen.msg:9501
msgid "A rotting old chair made out of an ancient car seat."
msgstr "Napůl shnilá židle vyrobená ze staré autosedačky."

#: game/pro_scen.msg:9601
msgid "A smelly old chair that used be to a car seat. The springs have lost their spring."
msgstr "Páchnoucí stará židle vyrobená z autosedačky. Pružiny již dávno ztratily svou pružnost."

#: game/pro_scen.msg:9701 game/pro_scen.msg:9801
msgid "A rotting, smelly old chair sitting on bricks for support. Looks pretty uncomfortable."
msgstr "Rozpadající se stará židle postavená na cihlách. Vypadá velice nepohodlně."

#: game/pro_scen.msg:9900 game/pro_scen.msg:10000
msgid "Couch"
msgstr "Pohovka"

#: game/pro_scen.msg:9901 game/pro_scen.msg:10001
msgid "A very uncomfortable looking sitting device, sometimes known as a couch."
msgstr "Velmi nepohodlně vypadající zařízení na sezení známé také jako gauč."

#: game/pro_scen.msg:10100
msgid "Tire"
msgstr "Pneumatika"

#: game/pro_scen.msg:10101
msgid "An old rubber tire sitting in the middle of some weeds."
msgstr "Stará gumová pneumatika pohozená v křoví."

#: game/pro_scen.msg:10200 game/pro_scen.msg:10300 game/pro_scen.msg:10400
#: game/pro_scen.msg:10500
msgid "Scrub"
msgstr "Křoví"

#: game/pro_scen.msg:10201 game/pro_scen.msg:10301 game/pro_scen.msg:10401
#: game/pro_scen.msg:10501
msgid "Some sort of desert weed."
msgstr "Nějaký druh pouštního plevelu."

#: game/pro_scen.msg:10601
msgid "It's a rusted car door leaning on a rusted metal barrel. A whole lot of rust is going on."
msgstr "Zrezivělé dveře od auta opřené o starý zrezivělý sud. To je opravdu hodně rzi."

#: game/pro_scen.msg:10701
msgid "A broken toilet, half-buried in the sand. Life's a pisser, then you die."
msgstr "Rozbitý záchod napůl pohřbený v písku. Život je na hovno a potom umřeš."

#: game/pro_scen.msg:10800
msgid "Weeds"
msgstr "Plevel"

#: game/pro_scen.msg:10801
msgid "Some sort of desert scrub. If it was growing in the recent past, it isn't now."
msgstr "Nějaký druh pouštního křoví. Pokud se tomu někdy dařilo, tak teď už rozhodně ne."

#: game/pro_scen.msg:10901
msgid "A car tire, buried in the sand. Some small pieces of wood are piled up around it."
msgstr "Pneumatika zapadlá v písku. Kolem ní se povalují dřevěné třísky."

#: game/pro_scen.msg:11001
msgid "On closer examination, you think these might actually be pieces of petrified wood."
msgstr "Po podrobnějším prozkoumání konstatuješ, že by to nejspíš mohlo být zkamenělé dřevo."

#: game/pro_scen.msg:11100 game/pro_scen.msg:11200 game/pro_scen.msg:11300
#: game/pro_scen.msg:11400 game/pro_scen.msg:11900 game/pro_scen.msg:12000
