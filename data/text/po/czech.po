msgstr "Radši se tomu chlápkovi nepleťte do cesty."

#: dialog/nccaspat.msg:219 dialog/ncperson.msg:301
msgid "I think he was looking at me."
msgstr "Myslím, že se na mě podíval."

#: dialog/nccaspat.msg:220 dialog/ncperson.msg:302
