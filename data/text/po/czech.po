msgstr "Police"

#: game/pro_item.msg:15101 game/pro_item.msg:15201 game/pro_item.msg:15301
#: game/pro_item.msg:15401 game/pro_item.msg:15501 game/pro_item.msg:15601
msgid "A set of wooden shelves."
msgstr "Řada dřevěných regálů."

#: game/pro_item.msg:15700
msgid "Workbench"
msgstr "Ponk"

#: game/pro_item.msg:15701
msgid "A workbench. Yep, your standard old, run of the mill, workbench. Looks nice sitting there, too."
msgstr "Ponk. Jo, tvůj starý vysloužilý ponk. Vypadá dobře."

#: game/pro_item.msg:15800
msgid "Tool Board"
msgstr "Deska s nářadím"

#: game/pro_item.msg:15801
msgid "This board holds a variety of tools above the popular workbench."
msgstr "Tato deska obsahuje různé nářadí zavěšené nad ponkem."

#: game/pro_item.msg:15900 game/pro_misc.msg:3000
msgid "Molotov Cocktail"
msgstr "Molotovův koktejl"

#: game/pro_item.msg:15901
msgid "A home-made flammable grenade. Min ST: 3."
msgstr "Zápalná láhev domácí výroby. Min. SÍ: 3."

#: game/pro_item.msg:16000
msgid "Cattle Prod"
msgstr "Elektrický obušek"

#: game/pro_item.msg:16001
msgid "A Farmer's Best Friend model cattle prod from Wattz Electronics. Uses small energy cells for power. Min ST: 4."
msgstr "Elektrický obušek model \"Farmářův nejlepší přítel\" od Wattz Electronics. Napájen malými energetickými články. Min. SÍ: 4."

#: game/pro_item.msg:16100
msgid "Red Ryder BB Gun"
msgstr "Vzduchovka RR"

#: game/pro_item.msg:16101
msgid "A Red Ryder BB gun. The classic. Min ST: 3."
msgstr "Vzduchovka Red Ryder. Klasika. Min. SÍ: 3."

#: game/pro_item.msg:16200
msgid "Red Ryder LE BB Gun"
msgstr "Vzduchovka RR LE"

#: game/pro_item.msg:16201
msgid "A limited edition version of the Red Ryder BB gun. A true classic. Min ST: 3."
msgstr "Limitovaná edice vzduchovky Red Ryder. Opravdová klasika. Min. SÍ: 3."

#: game/pro_item.msg:16300
msgid "BB's"
msgstr "Diabolky"

#: game/pro_item.msg:16301
msgid "A package of BB's from before the war. In excellent condition. Stainless steel."
msgstr "Krabice předválečných diabolek. Ve výborném stavu. Nerezová ocel."

#: game/pro_item.msg:16400
msgid "Brotherhood Tape"
msgstr "Páska o Bratrstvu"

#: game/pro_item.msg:16401
msgid "A holodisc from regarding the Brotherhood of Steel."
msgstr "Holodisk o Bratrstvu Oceli."

#: game/pro_item.msg:16500
msgid "Iguana Stand"
msgstr "Stánek s leguány"

#: game/pro_item.msg:16501
msgid "The home of Bob's Iguana Bits. What's not to love about fresh-roasted iguana?"
msgstr "Domov Bobových Leguáních kousků. Existuje snad něco lepšího než čerstvě opečený leguán?"

