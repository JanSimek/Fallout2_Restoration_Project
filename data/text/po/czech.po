msgid "The amount of goo on this computer makes it very difficult to access."
msgstr "Přes všechno to svinstvo se k tomu počítači nedá skoro dostat."

#: game/pro_scen.msg:76100 game/pro_scen.msg:76200 game/pro_scen.msg:76300
#: game/pro_scen.msg:76400 game/pro_scen.msg:78800 game/pro_scen.msg:78900
