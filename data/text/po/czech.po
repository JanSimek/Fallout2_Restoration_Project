#: game/pro_item.msg:100
msgid "Leather Armor"
msgstr "Kožená zbroj"

#: game/pro_item.msg:101
msgid "Your basic all leather apparel. Finely crafted from tanned brahmin hide."
msgstr "Tvoje základní kožená výstroj. Pečlivě vyrobená z brahmíní kůže."

#: game/pro_item.msg:200
msgid "Metal Armor"
msgstr "Kovová zbroj"

#: game/pro_item.msg:201
msgid "Polished metal plates, crudely forming a suit of armor."
msgstr "Vyleštěné kovové pláty nahrubo pospojované do zbroje."

#: game/pro_item.msg:300
msgid "Power Armor"
msgstr "Energo zbroj"

#: game/pro_item.msg:301
msgid "A self-contained suit of advanced technology armor. Powered by a micro-fusion reactor, with enough fuel to last a hundred years."
msgstr "Hi-tech oblek s vlastním pohonem. Je napájen mikro-fúzním reaktorem s dostatkem paliva na sto let."

#: game/pro_item.msg:400
msgid "Knife"
msgstr "Nůž"

#: game/pro_item.msg:401
msgid "A sharp-bladed cutting and stabbing weapon. Min ST: 2."
msgstr "Ostrá bodná a sečná zbraň. Min. SÍ: 2."

#: game/pro_item.msg:500
msgid "Club"
msgstr "Tonfa"

#: game/pro_item.msg:501
msgid "A military or police baton. Heavy wood. Min ST: 3."
msgstr "Univerzální armádní a policejní obušek z tvrdého dřeva. Min. SÍ: 3."

#: game/pro_item.msg:600
msgid "Sledgehammer"
msgstr "Perlík"

#: game/pro_item.msg:601
msgid "A large hammer with big handle. Very popular with the muscular crowd. Min ST: 6."
msgstr "Veliké kladivo s dlouhou rukojetí. Velmi oblíbená zbraň mezi svalovci. Min. SÍ: 6."

#: game/pro_item.msg:700
msgid "Spear"
msgstr "Kopí"

#: game/pro_item.msg:701
msgid "A razor tipped polearm. The shaft is wooden, and the tip is worked steel. Min ST: 4."
msgstr "Tyč s hrotem na konci. Násada je dřevěná a hrot je vyroben z kalené oceli. Min. SÍ: 4."

#: game/pro_item.msg:800
msgid "10mm Pistol"
msgstr "10mm pistole"

#: game/pro_item.msg:801
msgid "A Colt 6520 10mm autoloading pistol. Each pull of the trigger will automatically reload the firearm until the cylinder is empty. Single shot only, using the powerful 10mm round. Min ST: 3."
msgstr "Samonabíjecí pistole Colt 6520 ráže 10mm. Každý stisk spouště automaticky nabije zbraň, dokud se nevyprázdní zásobník. Neumožňuje střelbu dávkou. Používá účinnou 10mm munici. Min. SÍ: 3."

#: game/pro_item.msg:900
msgid "10mm SMG"
msgstr "10mm samopal"

#: game/pro_item.msg:901
msgid "H&K MP9 Submachinegun (10mm variant). A medium-sized SMG, capable of single shot and burst mode. Min ST: 4."
msgstr "Samopal H&K MP9 (10mm verze). Středně veliký samopal schopný střelby jednotlivými ranami nebo dávkou. Min. SÍ: 4."

#: game/pro_item.msg:1000
msgid "Hunting Rifle"
msgstr "Lovecká puška"

#: game/pro_item.msg:1001
msgid "A Colt Rangemaster semi-automatic rifle, in .223 caliber. Single-shot only. Min ST: 5."
msgstr "Poloautomatická puška Colt Rangemaster kalibr .223. Neumožňuje střelbu dávkou. Min. SÍ: 5."

#: game/pro_item.msg:1100
msgid "Flamer"
msgstr "Plamenomet"

#: game/pro_item.msg:1101
msgid "A Flambe 450 model flamethrower, varmiter variation. Fires a short spray of extremely hot, flammable liquid. Requires specialized fuel to work properly. Min ST: 6."
msgstr "Plamenomet model Flambe 450. Chrlí krátké dávky extrémně hořlavé tekutiny. Vyžaduje speciální náplň. Min. SÍ: 6."

#: game/pro_item.msg:1200
msgid "Minigun"
msgstr "Gatling"

#: game/pro_item.msg:1201
msgid "A Rockwell CZ53 Personal Minigun. A multi-barreled chaingun firing 5mm ammunition at over 60,000 RPM. Min ST: 7."
msgstr "Osobní gatling Rockwell CZ53. Několikahlavňový rotační kulomet, který střílí 5mm munici s kadencí více než 60 000 ran za minutu. Min. SÍ: 7."

#: game/pro_item.msg:1300
msgid "Rocket Launcher"
msgstr "Raketomet"

#: game/pro_item.msg:1301
msgid "A Rockwell BigBazooka rocket launcher. With the deluxe 3 lb. trigger. Fires AP or Explosive Rockets. Min ST: 6."
msgstr "Raketomet Rockwell BigBazooka s luxusní 1,5 kg spouští. Odpaluje průbojné nebo výbušné rakety. Min. SÍ: 6."

#: game/pro_item.msg:1400
msgid "Explosive Rocket"
msgstr "Výbušná raketa"

#: game/pro_item.msg:1401
msgid "A rocket with a large explosive warhead."
msgstr "Raketa s vysoce výbušnou hlavicí."

#: game/pro_item.msg:1500
msgid "Plasma Rifle"
msgstr "Plazmová puška"

#: game/pro_item.msg:1501
msgid "A Winchester Model P94 Plasma Rifle. An industrial-grade energy weapon, firing superheated bolts of plasma down a superconducting barrel. Powered by Micro Fusion Cells. Min ST: 6."
msgstr "Plazmová puška Winchester model P94. Tato odolná energetická zbraň vystřeluje částice přehřáté plazmy skrz supravodivou hlaveň. Napájena mikro-fúzními články. Min. SÍ: 6."

#: game/pro_item.msg:1600
msgid "Laser Pistol"
msgstr "Laserová pistole"

#: game/pro_item.msg:1601
msgid "A Wattz 1000 Laser Pistol. Civilian model, so the wattage is lower than military or police versions. Uses small energy cells. Min ST: 3."
msgstr "Laserová pistole Wattz 1000. Jedná se o civilní model, tudíž má nižší výkon než armádní nebo policejní varianty. Napájena pomocí malých energetických článků. Min. SÍ: 3."

#: game/pro_item.msg:1701 game/pro_item.msg:38101
msgid "High tech armor, made out of advanced defensive polymers."
msgstr "Hi-tech zbroj vyrobená z pokročilých defenzívních polymerů."

#: game/pro_item.msg:1800
msgid "Desert Eagle .44"
msgstr "Desert Eagle .44"

#: game/pro_item.msg:1801
msgid "An ancient Desert Eagle pistol, in .44 Magnum. Interest in late 20th century films made this one of the most popular handguns of all times. Min ST: 4."
msgstr "Starobylá pistole Desert Eagle používající munici .44 magnum. Časté používání ve filmech pozdního 20. století z ní udělalo jednu z nejpopulárnějších pistolí všech dob. Min. SÍ: 4."

#: game/pro_item.msg:1900 game/pro_misc.msg:2600 game/pro_scen.msg:46100
#: game/pro_scen.msg:46200 game/pro_scen.msg:46300 game/pro_scen.msg:46400
msgid "Rock"
msgstr "Kámen"

#: game/pro_item.msg:1901
msgid "It's a rock. The Granite-Inc. model is an upgraded version. Min ST: 1."
msgstr "Prostě kámen. Upgradovaný model se vyrábí pod značkou Žula-Inc. Min. SÍ: 1."

#: game/pro_item.msg:2000
msgid "Crowbar"
msgstr "Páčidlo"

#: game/pro_item.msg:2001
msgid "A very solid and heavy piece of metal, specially designed to exert leverage. Or pound heads. Min ST: 5."
msgstr "Masivní kus těžkého kovu vyrobený za účelem využití pákového efektu. Nebo k rozbíjení hlav. Min. SÍ: 5."

#: game/pro_item.msg:2100
msgid "Brass Knuckles"
msgstr "Mosazný boxer"

#: game/pro_item.msg:2101
msgid "Hardened knuckle grip that is actually made out of steel. They protect your hand, and do more damage, in unarmed combat. Min ST: 1."
msgstr "Tvrzený boxer, který je ve skutečnosti vyroben z oceli. Náprstníkové kroužky chrání ruku a způsobují větší poranění v boji beze zbraně. Min. SÍ: 1."

#: game/pro_item.msg:2200
msgid "14mm Pistol"
msgstr "14mm pistole"

#: game/pro_item.msg:2201
msgid "A Sig-Sauer 14mm Auto Pistol. Large, single shot handgun. Excellent craftsmanship. Min ST: 4."
msgstr "Automatická pistole Sig-Sauer 14mm. Veliká zbraň určená pro střelbu jednotlivými ranami. Výtečné zpracování. Min. SÍ: 4."

#: game/pro_item.msg:2300
msgid "Assault Rifle"
msgstr "Útočná puška"

#: game/pro_item.msg:2301
msgid "An AK-112 5mm Assault Rifle. An old military model, out of use around the time of the war. Can fire single-shot or burst, using the high velocity 5mm rounds. Min ST: 5."
msgstr "Útočná puška AK-112 5mm. Stará armádní zbraň vyřazená v průběhu války. Schopná střelby jednotlivými ranami nebo dávkou. Používá vysokorychlostní 5mm munici. Min. SÍ: 5."

#: game/pro_item.msg:2400
msgid "Plasma Pistol"
msgstr "Plazmová pistole"

#: game/pro_item.msg:2401
msgid "Glock 86 Plasma Pistol. Designed by the Gaston Glock AI. Shoots a small bolt of superheated plasma. Powered by a small energy cell. Min ST: 4."
msgstr "Plazmová pistole Glock 86. Navržena v Gaston Glock AI. Střílí malé částice přehřáté plazmy. Napájena malými energetickými články. Min. SÍ: 4."

#: game/pro_item.msg:2500
msgid "Grenade (Frag)"
msgstr "Granát (Tříštivý)"

#: game/pro_item.msg:2501
msgid "A generic fragmentation grenade. Contains a small amount of high explosives, the container itself forming most of the damaging fragments. Explodes on contact. Min ST: 3."
msgstr "Obyčejný tříštivý granát. Obsahuje malé množství výbušniny, která roztrhne plášť na velké množství zraňujících střepin. Vybuchuje při nárazu. Min. SÍ: 3."

#: game/pro_item.msg:2600
msgid "Grenade (Plasma)"
msgstr "Granát (Plazmový)"

#: game/pro_item.msg:2601
msgid "A magnetically sealed plasma delivery unit, with detonating explosives. Creates a blast of superheated plasma on contact. Min ST: 4."
msgstr "Magneticky uzavřená schránka s plazmou a iniciační výbušninou. Při kontaktu vzniká oblak přehřáté plazmy. Min. SÍ: 4."

#: game/pro_item.msg:2700
msgid "Grenade (Pulse)"
msgstr "Granát (Pulzní)"

#: game/pro_item.msg:2701
msgid "An electromagnetic pulse grenade, generating an intense magnetic field on detonation. Doesn't affect biological creatures. Contact fuze. Min ST: 4."
msgstr "Elektromagnetický pulzní granát vytvářející silné elektromagnetické pole v místě exploze. Nemá žádný efekt na živé tvory. Nárazová pojistka. Min. SÍ: 4."

#: game/pro_item.msg:2800
msgid "Gatling Laser"
msgstr "Laserový gatling"

#: game/pro_item.msg:2801
msgid "An H&K L30 Gatling Laser. Designed specifically for military use, these were in the prototype stage at the beginning of the War. Multiple barrels allow longer firing before overheating. Powered by Micro Fusion Cells. Min ST: 6."
msgstr "Rotační laser H&K L30. Určen výhradně pro armádní použití, avšak na začátku války byl teprve ve stádiu prototypu. Větší počet hlavní umožňuje delší střelbu bez přehřívání. Napájen mikro-fúzními články. Min. SÍ: 6."

#: game/pro_item.msg:2900
msgid "10mm JHP"
msgstr "10mm JHP"

#: game/pro_item.msg:2901
msgid "Ammunition. Caliber: 10mm, jacketed hollow-point."
msgstr "Munice. Kalibr: 10mm, plášťová expanzní střela."

#: game/pro_item.msg:3000
msgid "10mm AP"
msgstr "10mm AP"

#: game/pro_item.msg:3001
msgid "Ammunition. Caliber: 10mm, armor piercing."
msgstr "Munice. Kalibr: 10mm, průrazná střela."

#: game/pro_item.msg:3100
msgid ".44 Magnum JHP"
msgstr ".44 Magnum JHP"

#: game/pro_item.msg:3101
msgid "A brick of ammunition, .44 Magnum caliber, jacketed hollow-point."
msgstr "Plášťové expanzní střely, kalibr .44."

#: game/pro_item.msg:3200 game/proto.msg:302
msgid "Flamethrower Fuel"
msgstr "Náplň do plamenometu"

#: game/pro_item.msg:3201
msgid "A cylinder containing an extremely flammable liquid fuel for flamethrowers."
msgstr "Tlaková nádoba obsahující vysoce hořlavou tekutinu pro plamenomet."

#: game/pro_item.msg:3300
msgid "14mm AP"
msgstr "14mm AP"

#: game/pro_item.msg:3301
msgid "Large caliber ammunition. 14mm armor piercing."
msgstr "Velkorážová munice. Průrazná 14mm."

#: game/pro_item.msg:3400
msgid ".223 FMJ"
msgstr ".223 FMJ"

#: game/pro_item.msg:3401
msgid "A case of ammunition, .223 caliber, full metal jacket."
msgstr "Munice. Kalibr .223, celoplášťová expanzní střela."

#: game/pro_item.msg:3500
msgid "5mm JHP"
msgstr "5mm JHP"

#: game/pro_item.msg:3501
msgid "A brick of small, lightweight ammunition. Caliber: 5mm, jacketed hollow-point."
msgstr "Zásobník malé lehké munice. Kalibr: 5mm, plášťová expanzní střela."

#: game/pro_item.msg:3600
msgid "5mm AP"
msgstr "5mm AP"

#: game/pro_item.msg:3601
msgid "A brick of small, lightweight ammunition. Caliber: 5mm, armor piercing."
msgstr "Zásobník malé lehké munice. Kalibr: 5mm, průrazná střela."

#: game/pro_item.msg:3700
msgid "Rocket AP"
msgstr "Raketa AP"

#: game/pro_item.msg:3701
msgid "A rocket shell, with a smaller explosive, but designed to pierce armor plating."
msgstr "Raketa s malým množstvím výbušniny. Navržena k prorážení pancíře."

#: game/pro_item.msg:3800
msgid "Small Energy Cell"
msgstr "Malý energetický článek"

#: game/pro_item.msg:3801
msgid "A small, self-contained energy storage unit."
msgstr "Hermeticky uzavřený zásobník energie."

#: game/pro_item.msg:3900
msgid "Micro Fusion Cell"
msgstr "Mikro-fúzní článek"

#: game/pro_item.msg:3901
msgid "A medium sized energy production unit. Self-contained fusion plant."
msgstr "Středně veliká jednotka na výrobu energie. V podstatě miniaturní fúzní elektrárna."

#: game/pro_item.msg:4001
msgid "A healing chem. When injected, the chem provides immediate healing of minor wounds."
msgstr "Léčící prostředek. Po aplikaci okamžitě vyléčí drobná zranění."

#: game/pro_item.msg:4100
msgid "Money"
msgstr "Peníze"

#: game/pro_item.msg:4101
msgid "Legal tender for the world of the wastes."
msgstr "Legální platidlo postapokalyptického světa."

#: game/pro_item.msg:4200
msgid "Fridge"
msgstr "Lednička"

#: game/pro_item.msg:4201
msgid "A refrigerator. Out of coolant."
msgstr "Lednice. Chladící směs už dávno vyprchala."

#: game/pro_item.msg:4300 game/pro_item.msg:4400
msgid "Ice Chest"
msgstr "Chladící box"

#: game/pro_item.msg:4301 game/pro_item.msg:4401
msgid "On old-style ice chest. The hinges are in good working condition."
msgstr "Starý chladící box. Panty jsou v dobrém stavu."

#: game/pro_item.msg:4500
msgid "Throwing Knife"
msgstr "Vrhací nůž"

#: game/pro_item.msg:4501
msgid "A knife, balanced specifically for throwing. Made of titanium, and laser sharpened. Min ST: 3."
msgstr "Nůž speciálně vyvážený pro vrhání. Vyroben z titanu a laserově naostřen. Min. SÍ: 3."

#: game/pro_item.msg:4600 game/pro_item.msg:9300
msgid "Bag"
msgstr "Vak"

#: game/pro_item.msg:4601 game/pro_item.msg:9301
msgid "An average sized bag. Made from weaved brahmin hairs."
msgstr "Pytel průměrné velikosti. Utkán z brahmíní kůže."

#: game/pro_item.msg:4701
msgid "A small kit containing basic medical equipment. Bandages, wraps, antiseptic spray, and more."
msgstr "Malá souprava obsahující základní lékařské vybavení jako jsou obinadla, náplasti, dezinfekční prostředky apod."

#: game/pro_item.msg:4801
msgid "A chemical solution that bonds with radiation particles and passes them through your system. Takes time to work."
msgstr "Chemický roztok, který na sebe váže radioaktivní částice a přirozenými vylučovacími cestami je odvádí pryč z těla. Plný účinek vyžaduje nějaký čas."

#: game/pro_item.msg:4900
msgid "Antidote"
msgstr "Protijed"

#: game/pro_item.msg:4901
msgid "A bottle containing a home-brewed antidote for poison. A milky liquid with floating pieces of radscorpion flesh."
msgstr "Láhev obsahující podomácku vyrobený protijed. Mléčný roztok s plovoucími kousky radškorpioního masa."

#: game/pro_item.msg:5000
msgid "Reserved Item"
msgstr "Reserved Item"

#: game/pro_item.msg:5001
msgid "This is a reserved item. DO NOT USE."
msgstr "This is a reserved item. DO NOT USE."

#: game/pro_item.msg:5100 game/pro_item.msg:20600 game/scrname.msg:1542
msgid "Dynamite"
msgstr "Dynamit"

#: game/pro_item.msg:5101
msgid "A high explosive, consisting of nitroglycerin mixed with the absorbent substance kieselguhr. Includes a timer."
msgstr "Vysoce výbušný mix nitroglycerinu s hlinkou. Včetně časovače."

#: game/pro_item.msg:5200 game/pro_item.msg:20700
msgid "Geiger Counter"
msgstr "Geigerův počítač"

#: game/pro_item.msg:5201
msgid "A Wattz Electronics C-Radz model Geiger Counter. Detects the presence and strength of radiation fields."
msgstr "Geiger-Müllerův detektor radioaktivních částic. Model Wattz Electronics C-Radz. Detekuje přítomnost a množství radioaktivních částic."

#: game/pro_item.msg:5301
msgid "A pillbox of mind-altering chems. Increases memory related functions, and speeds other mental processes. Highly addictive."
msgstr "Krabička s drogou pozměňujících mozkové procesy. Zlepšuje paměť a urychluje veškeré nervové procesy. Vysoce návykové."

#: game/pro_item.msg:5400 game/pro_item.msg:21000
msgid "Stealth Boy"
msgstr "Mizík"

#: game/pro_item.msg:5401 game/pro_item.msg:21001
msgid "A RobCo Stealth Boy 3001 personal stealth device. Generates a modulating field that transmits the reflected light from one side of an object to the other."
msgstr "Osobní zneviditelňovací zařízení RobCo Mizík 3001. Generuje modulující pole, které přenáší odražené světlo z jedné strany objektu na druhou. Je zapnutý."

#: game/pro_item.msg:5500
msgid "Water Chip"
msgstr "Vodní čip"

#: game/pro_item.msg:5501
msgid "This is a Vault-Tec water chip. They are typically packaged in groups of five to a box."
msgstr "Vodní čip firmy Vault-Tec. Obvykle bývá zabalen po pěti v jedné krabici."

#: game/pro_item.msg:5600
msgid "Dog Tags"
msgstr "Psí známky"

#: game/pro_item.msg:5601
msgid "A set of military dog tags. The name Dickinson and the word Enclave are barely readable."
msgstr "Sada vojenských identifikačních známek. Jméno Dickinson a slovo Enkláva jsou stěží k přečtení."

#: game/pro_item.msg:5700
msgid "Bug"
msgstr "Štěnice"

#: game/pro_item.msg:5701
msgid "A miniature microphone and transmitting device."
msgstr "Miniaturní mikrofon a vysílač."

#: game/pro_item.msg:5800
msgid "Tape"
msgstr "Holopáska"

#: game/pro_item.msg:5801
msgid "A Wattz Electronics Holodisc tape. This particular tape looks to be into very poor condition."
msgstr "Páska Wattz Electronics Holodisc. Je v opravdu špatném stavu."

#: game/pro_item.msg:5900 game/pro_item.msg:20800
msgid "Motion Sensor"
msgstr "Detektor pohybu"

#: game/pro_item.msg:5901
msgid "A Wattz Electronics C-U model motion sensor. Detects the movement of biological material over a distance of meters using a tuned radar device. Having one in your inventory will also help you avoid outdoor encounters (+20% Outdoorsman skill)."
msgstr "Detektor pohybu model Wattz Electronics C-U. Detekuje jakýkoliv pohyb biologického původu v okruhu několika metrů. Máš-li jej ve svém inventáři, vyhneš se častěji náhodným setkáním (+20% ke schopnosti Přežití v pustině)."

#: game/pro_item.msg:6000 game/pro_item.msg:6100 game/pro_item.msg:6200
#: game/pro_item.msg:6300 game/pro_item.msg:6400 game/pro_item.msg:6500
#: game/scrname.msg:566
msgid "Bookcase"
msgstr "Knihovna"

#: game/pro_item.msg:6001 game/pro_item.msg:6101 game/pro_item.msg:6201
#: game/pro_item.msg:6301 game/pro_item.msg:6401 game/pro_item.msg:6501
msgid "A wooden bookcase."
msgstr "Dřevěná knihovna."

#: game/pro_item.msg:6600 game/pro_item.msg:6700 game/pro_item.msg:18100
#: game/pro_item.msg:18200 game/pro_item.msg:18300 game/pro_item.msg:18400
#: game/pro_item.msg:18500 game/pro_item.msg:18600 game/pro_item.msg:18700
#: game/pro_item.msg:21400 game/pro_scen.msg:40400 game/pro_scen.msg:40500
#: game/pro_scen.msg:163600 game/pro_scen.msg:164300 game/pro_scen.msg:164400
#: game/pro_scen.msg:231300 game/pro_scen.msg:231600 game/pro_scen.msg:231700
#: game/pro_scen.msg:231800
msgid "Desk"
msgstr "Stůl"

#: game/pro_item.msg:6601 game/pro_item.msg:6701 game/pro_scen.msg:231301
msgid "A wooden desk."
msgstr "Dřevěný stůl."

#: game/pro_item.msg:6800 game/pro_item.msg:6900 game/pro_item.msg:7000
#: game/pro_scen.msg:231400 game/pro_scen.msg:231500 game/scrname.msg:753
msgid "Dresser"
msgstr "Prádelník"

#: game/pro_item.msg:6801 game/pro_item.msg:6901 game/pro_item.msg:7001
#: game/pro_scen.msg:231401 game/pro_scen.msg:231501
msgid "A wooden dresser."
msgstr "Dřevěný prádelník."

#: game/pro_item.msg:7100
msgid "Fruit"
msgstr "Ovoce"

#: game/pro_item.msg:7101
msgid "A strange piece of fruit. No preservatives and no additional food coloring added."
msgstr "Podivný kus ovoce. Bez konzervačních látek a potravinového barviva."

#: game/pro_item.msg:7200
msgid "Briefcase"
msgstr "Kufřík"

#: game/pro_item.msg:7201
msgid "A briefcase, with a Made-in-the-USA label. Leather. Good condition, but the combination lock is broken."
msgstr "Kufřík s cedulkou 'Made-in-the-USA'. Kožený. V dobrém stavu, ale s rozbitým číselným zámkem."

#: game/pro_item.msg:7300
msgid "Big Book of Science"
msgstr "Velká encyklopedie vědy"

#: game/pro_item.msg:7301
msgid "A set of books, containing information about different scientific fields."
msgstr "Několik knih obsahujících informace z mnoha odlišných vědeckých odvětví."

#: game/pro_item.msg:7400
msgid "Leather Jacket"
msgstr "Kožená bunda"

#: game/pro_item.msg:7401
msgid "A black, heavy leather jacket."
msgstr "Černá bunda z hrubé kůže."

#: game/pro_item.msg:7500
msgid "Tool"
msgstr "Univerzální kleště"

#: game/pro_item.msg:7501
msgid "A tool set, containing various useful tools, including pliers."
msgstr "Sada nářadí obsahující nejrůznější užitečné nástroje včetně kleští."

#: game/pro_item.msg:7600
msgid "Deans Electronics"
msgstr "Skripta elektroniky"

#: game/pro_item.msg:7601
msgid "A study book on the field of electronics. A note on the cover says that it is for the \"budding young electrician in everyone!\""
msgstr "Studijní materiál pro studenty elektroniky. Poznámka na obalu říká - \"Probuďte v sobě mladého elektrotechnika!\""

#: game/pro_item.msg:7700
msgid "Electronic Lockpick"
msgstr "Elektronický paklíč"

#: game/pro_item.msg:7701
msgid "A Wattz Electronics Micromanipulator FingerStuff electronic lockpick. For defeating electronic locks and security devices."
msgstr "Wattz Electronics mikromanipulační elektronický paklíč. Pro odblokování elektronických zámků a bezpečnostních systémů."

#: game/pro_item.msg:7800
msgid "Fuzzy Painting"
msgstr "Rozmazaný obraz"

#: game/pro_item.msg:7801
msgid "An image of a singer. Obviously, very old. The image has a felt coating that is still in good condition."
msgstr "Očividně velmi starý obraz nějakého zpěváka. Rám je stále v dobrém stavu."

#: game/pro_item.msg:7900 game/pro_item.msg:20500 game/pro_misc.msg:2400
msgid "Flare"
msgstr "Světlice"

#: game/pro_item.msg:7901
msgid "A flare. Creates light for a short period of time. The paper is a little worn, but otherwise it is in good condition. Twist the top to activate it."
msgstr "Světlice. Na krátkou dobu vytvoří intenzivní světlo. Papír je trochu opotřebovaný, ale jinak je v dobrém stavu. Aktivuje se pootočením horní části."

#: game/pro_item.msg:8000
msgid "First Aid Book"
msgstr "Příručka první pomoci"

#: game/pro_item.msg:8001
msgid "A study book on the concepts and practical use of first aid skills."
msgstr "Skripta popisující zásady první pomoci včetně praktických ukázek."

#: game/pro_item.msg:8100 game/pro_item.msg:10300
msgid "Iguana-on-a-stick"
msgstr "Leguán na špejli"

#: game/pro_item.msg:8101
msgid "A cooked iguana, roasted in its own skin."
msgstr "Leguán opečený ve vlastní kůži."

#: game/pro_item.msg:8200 game/pro_item.msg:10500 game/proto.msg:156
msgid "Key"
msgstr "Klíč"

#: game/pro_item.msg:8201
msgid "A key. A key will open a particular lock."
msgstr "Klíč. Určitě pasuje do nějakého zámku."

#: game/pro_item.msg:8300
msgid "Key Ring"
msgstr "Svazek klíčů"

#: game/pro_item.msg:8301
msgid "Multiple keys."
msgstr "Několik klíčů."

#: game/pro_item.msg:8400
msgid "Lockpicks"
msgstr "Sada paklíčů"

#: game/pro_item.msg:8401
msgid "A set of locksmith tools. Includes all the necessary picks and tension wrenches to open conventional pin and tumbler locks."
msgstr "Sada zámečnického nářadí. Obsahuje paklíče a šperháky potřebné k otevření všech klasických i dozických zámků."

#: game/pro_item.msg:8500 game/pro_item.msg:20900
msgid "Plastic Explosives"
msgstr "Plastická výbušnina"

#: game/pro_item.msg:8501
msgid "A chunk of Cordex, a military brand of plastic explosives. Highly stable, very destructive. Includes a timer."
msgstr "Kostka Cordexu, vojenské značky plastických trhavin. Velmi ničivá a přitom vysoce stabilní. Včetně časovače."

#: game/pro_item.msg:8600
msgid "Scout Handbook"
msgstr "Skautská příručka"

#: game/pro_item.msg:8601
msgid "A book on the methods and ideals of Scouting. Very practical information regarding outdoor life."
msgstr "Kniha o metodách a idejích skautingu. Plná praktických informací o životě ve volné přírodě."

#: game/pro_item.msg:8701
msgid "Highly advanced steroids. While in effect, they increase strength and reflexes. Very addictive."
msgstr "Velmi účinné steroidy. Po dobu působení zvyšují sílu a zrychlují reflexy. Vysoce návykové."

#: game/pro_item.msg:8800
msgid "Watch"
msgstr "Hodinky"

#: game/pro_item.msg:8801
msgid "An expensive watch. Not really working, but it still looks nice."
msgstr "Drahé hodinky. Sice nefungují, ale stále vypadají velmi dobře."

#: game/pro_item.msg:8900
msgid "Motor"
msgstr "Motor"

#: game/pro_item.msg:8901
msgid "A 40-hp electric motor."
msgstr "Elektrický motor o výkonu 40 koňských sil."

#: game/pro_item.msg:9000
msgid "Back Pack"
msgstr "Batoh"

#: game/pro_item.msg:9001
msgid "A basic backpack, with optional carrying straps."
msgstr "Batoh s několika kapsami."

#: game/pro_item.msg:9101
msgid "This brown bag contains instruments and chems used by doctors in the application of their trade."
msgstr "Tato hnědá brašna obsahuje nástroje a léky, které doktoři používají při výkonu svého povolání."

#: game/pro_item.msg:9200
msgid "Scorpion Tail"
msgstr "Radškorpioní ocas"

#: game/pro_item.msg:9201
msgid "The severed tail of a radscorpion."
msgstr "Oddělený ocas z radškorpiona."

#: game/pro_item.msg:9400
msgid "Shotgun"
msgstr "Brokovnice"

#: game/pro_item.msg:9401
msgid "A Winchester Widowmaker double-barreled 12-gauge shotgun. Short barrel, with mahogany grip. Min ST: 4."
msgstr "Dvouhlavňová brokovnice Winchester Ovdovovač ráže 12. S krátkou hlavní a mahagonovou pažbou. Min. SÍ: 4."

#: game/pro_item.msg:9500
msgid "12 ga. Shotgun Shells"
msgstr "Brokové náboje ráže 12"

#: game/pro_item.msg:9501
msgid "Shotgun ammunition. This particular ammo is marked: \"12-gauge shells, not for use by children under the age of 3.\""
msgstr "Munice do brokovnice. Toto střelivo je označeno: \"broky ráže 12, nevhodné pro děti do tří let.\""

#: game/pro_item.msg:9600
msgid "Red Pass Key"
msgstr "Červená přístup. karta"

#: game/pro_item.msg:9601 game/pro_item.msg:30601 game/pro_item.msg:37301
msgid "An electronic security key, color coded red."
msgstr "Bezpečnostní elektronický klíč označený červenou barvou."

#: game/pro_item.msg:9700
msgid "Blue Pass Key"
msgstr "Modrá přístupová karta"

#: game/pro_item.msg:9701
msgid "An electronic security key, color coded blue."
msgstr "Elektronický bezpečnostní klíč označený modrou barvou."

#: game/pro_item.msg:9800 game/pro_scen.msg:10600 game/pro_scen.msg:10700
#: game/pro_scen.msg:10900 game/pro_scen.msg:11600 game/pro_scen.msg:11700
#: game/pro_scen.msg:11800 game/pro_scen.msg:25200 game/pro_scen.msg:25300
#: game/pro_scen.msg:25400 game/pro_scen.msg:25500 game/pro_scen.msg:25600
#: game/pro_scen.msg:27100 game/pro_scen.msg:27200 game/pro_scen.msg:27300
#: game/pro_scen.msg:27400 game/pro_scen.msg:27700 game/pro_scen.msg:41100
#: game/pro_scen.msg:41200 game/pro_scen.msg:41300 game/scrname.msg:1625
msgid "Junk"
msgstr "Haraburdí"

#: game/pro_item.msg:9801
msgid "A pile of junk parts. A little bit of everything."
msgstr "Haraburdí. Ode všeho trochu."

#: game/pro_item.msg:9900
msgid "Gold Locket"
msgstr "Zlatý přívěsek"

#: game/pro_item.msg:9901
msgid "A valuable gold locket."
msgstr "Velice cenný zlatý přívěsek."

#: game/pro_item.msg:10000
msgid "Radio"
msgstr "Vysílačka"

#: game/pro_item.msg:10001
msgid "A model 2043B Radio Communicator, from the fine people at Wattz Electronics. Dependable, rugged, and camouflaged. With the optional RS-121 interface."
msgstr "Radiový komunikátor model 2043B od firmy Wattz Electronics. Robustní, spolehlivý a maskovaný. S doplňkovým rozhraním RS-121."

#: game/pro_item.msg:10100
msgid "Lighter"
msgstr "Zapalovač"

#: game/pro_item.msg:10101
msgid "A silver butane lighter, in good condition."
msgstr "Stříbrný zapalovač na butan. V dobrém stavu."

#: game/pro_item.msg:10200
msgid "Guns and Bullets"
msgstr "Zbraně a střelivo"

#: game/pro_item.msg:10201
msgid "A gun rag. A magazine devoted to the practical use of firearms, and the occasional biased review."
msgstr "Střelecký bulvár. Časopis zaměřený na praktické používání střelných zbraní a občasné zaujaté recenze."

#: game/pro_item.msg:10301
msgid "Some charred meat and vegetables on a cooking stick."
msgstr "Spálené maso se zeleninou na tyči."

#: game/pro_item.msg:10400
msgid "Tape Recorder"
msgstr "Magnetofon"

#: game/pro_item.msg:10401
msgid "A Wattz Electronics Play-It-For-Me tape recorder. Plays and records the standard 30 minute high density Record-It-Once tapes."
msgstr "Magnetofon Zahraj-Mi-To od Wattz Electronics. Nahrává a přehrává standardní 30ti minutové Nahraj-To-Jednou pásky s vysokou hustotou záznamu."

#: game/pro_item.msg:10501
msgid "A special key of some sort."
msgstr "Speciální druh klíče."

#: game/pro_item.msg:10600
msgid "Nuka-Cola"
msgstr "Nuka-Cola"

#: game/pro_item.msg:10601
msgid "A bottle of Nuka-Cola, the flavored softdrink of the post-nuclear world. Warm and flat."
msgstr "Láhev Nuka-Coly, oblíbené sodovky post-nukleárního světa. Nápoj je teplý a zvětralý."

#: game/pro_item.msg:10700 game/pro_item.msg:10800 game/pro_item.msg:21100
#: game/pro_item.msg:25000 game/pro_scen.msg:8200 game/pro_scen.msg:8300
#: game/pro_scen.msg:8400 game/pro_scen.msg:8500 game/pro_scen.msg:8600
#: game/pro_scen.msg:192000 game/pro_scen.msg:192100 game/pro_scen.msg:192200
#: game/pro_scen.msg:192300 game/pro_scen.msg:192400 game/pro_scen.msg:192500
#: game/pro_scen.msg:192600 game/pro_scen.msg:192700 game/pro_scen.msg:192800
#: game/scrname.msg:165
msgid "Bones"
msgstr "Kosti"

#: game/pro_item.msg:10701 game/pro_item.msg:10801
msgid "A collection of strange bones."
msgstr "Hromádka podivných kostí."

#: game/pro_item.msg:10901
msgid "Anti-radiation chems to be taken before exposure. No known side effects."
msgstr "Anti-radiační přípravek určený k aplikaci před ozářením. Bez známých vedlejších účinků."

#: game/pro_item.msg:11001
msgid "An unique delivery system filled with strange and unknown chemicals of probably military origin. It is supposed to increase the combat potential of a soldier."
msgstr "Prostředek s unikátním aplikačním systémem obsahujícím neznámé chemikálie pravděpodobně vojenského původu. Všeobecně se má za to, že jeho použití zvyšuje bojové schopnosti vojáků."

#: game/pro_item.msg:11100
msgid ".44 Magnum FMJ"
msgstr ".44 magnum FMJ"

#: game/pro_item.msg:11101
msgid "A brick of ammunition, .44 Magnum caliber, full metal jacket."
msgstr "Zásobník munice ráže .44 magnum, celoplášťová expanzní střela."

#: game/pro_item.msg:11200
msgid "Urn"
msgstr "Urna"

#: game/pro_item.msg:11201
msgid "A beautiful golden urn, with the name \"Harriet\" inscribed on the front and ashes inside."
msgstr "Nádherná zlatá urna s nápisem \"Harriet\"."

#: game/pro_item.msg:11300
msgid "Robes"
msgstr "Róba"

#: game/pro_item.msg:11301
msgid "Worn-looking robes."
msgstr "Opotřebovaně vypadající roucha."

#: game/pro_item.msg:11400
msgid "Tangler's Hand"
msgstr "Tanglerova ruka"

#: game/pro_item.msg:11401
msgid "A cybernetic manipulator, in the shape and form of a hand. Damaged due to the sloppy nature of the removal process."
msgstr "Robotický manipulátor ve tvaru a podobě ruky. Byl poškozen při neodborném pokusu o rozebrání."

#: game/pro_item.msg:11501
msgid "A Super Sledgehammer, manufactured by the Brotherhood of Steel, using the finest weapons technology available. Includes a kinetic energy storage device, to increase knockback. Min ST: 5."
msgstr "Mohutný perlík vyrobený v dílnách Bratrstva Oceli za použití nejmodernější dostupné technologie. Obsahuje zásobník kinetické energie, který umocňuje úder. Min. SÍ: 5."

#: game/pro_item.msg:11601
msgid "A Ripper(tm) vibroblade. Powered by a small energy cell, the chainblade rips and tears into it's target. Min ST: 4."
msgstr "Vibrační nůž značky Trhač(tm). Napájen malými energetickými články. Jeho vibrující řetězová čepel je schopna roztrhat a rozpárat svůj cíl během několika sekund. Min. SÍ: 4."

#: game/pro_item.msg:11701
msgid "A beautiful flower."
msgstr "Nádherná květina."

#: game/pro_item.msg:11800
msgid "Laser Rifle"
msgstr "Laserová puška"

#: game/pro_item.msg:11801
msgid "A Wattz 2000 Laser Rifle. Uses micro fusion cells for more powerful lasers, and an extended barrel for additional range. Min ST: 6."
msgstr "Laserová puška model Wattz 2000. Mikro-fúzní články poskytují laseru vyšší výkon a prodloužená hlaveň umožňuje delší dostřel. Min. SÍ: 6."

#: game/pro_item.msg:11900
msgid "Necklace"
msgstr "Náhrdelník"

#: game/pro_item.msg:11901
msgid "An expensive looking necklace, made from silver, gold and pressed diamonds."
msgstr "Luxusně vypadající náhrdelník vyrobený ze zlata, stříbra a broušených diamantů."

#: game/pro_item.msg:12000
msgid "Alien Blaster"
msgstr "Alien Blaster"

#: game/pro_item.msg:12001
msgid "A strange gun of obviously alien origin. Looks like it can support small energy cells, however. Min ST: 2."
msgstr "Podivná zbraň zjevně mimozemského původu. Nicméně se zdá, že může využívat malé energetické články. Min. SÍ: 2."

#: game/pro_item.msg:12100
msgid "9mm ball"
msgstr "9mm náboje"

#: game/pro_item.msg:12101
msgid "A collection of ancient 9x19mm rounds. Heavy grease to preserve them from the environment. Standard bullets."
msgstr "Sada prastarých nábojů 9x19mm. Jsou chráněné tlustou vrstvou vazelíny proti působení okolního prostředí. Standardní náboje."

#: game/pro_item.msg:12200
msgid "9mm Mauser"
msgstr "9mm Mauser"

#: game/pro_item.msg:12201
msgid "A Mauser M/96, in 9x19mm Parabellum. In excellent condition. Extremely accurate. Min ST: 3."
msgstr "Pistole Mauser M/96 ráže 9x19mm Parabellum. Ve výborném stavu. Neobyčejně přesná. Min. SÍ: 3."

#: game/pro_item.msg:12300
msgid "Psychic Nullifier"
msgstr "Psychický anulátor"

#: game/pro_item.msg:12301
msgid "A strange device, constructed from an odd technology."
msgstr "Podivné zařízení vytvořené zvláštní technologií."

#: game/pro_item.msg:12400
msgid "Beer"
msgstr "Pivo"

#: game/pro_item.msg:12401
msgid "Some type of home brewed beer."
msgstr "Nějaký druh podomácku vařeného piva."

#: game/pro_item.msg:12500
msgid "Booze"
msgstr "Pálenka"

#: game/pro_item.msg:12501
msgid "An ancient liquor, from the pre-War era."
msgstr "Starodávný likér z předválečné éry."

#: game/pro_item.msg:12600
msgid "Water Flask"
msgstr "Láhev na vodu"

#: game/pro_item.msg:12601
msgid "A container for the holding and preservation of water or other liquids."
msgstr "Nádoba na přechovávání vody a jiných tekutin."

#: game/pro_item.msg:12700 game/pro_scen.msg:91500 game/pro_scen.msg:91600
#: game/pro_scen.msg:91700 game/pro_scen.msg:91800 game/pro_scen.msg:91900
#: game/pro_scen.msg:92000 game/pro_scen.msg:92100 game/pro_scen.msg:92200
#: game/pro_scen.msg:129700 game/pro_scen.msg:143300 game/pro_scen.msg:186900
#: game/pro_scen.msg:187900 game/pro_scen.msg:188000 game/scrname.msg:964
msgid "Rope"
msgstr "Provaz"

#: game/pro_item.msg:12701
msgid "A strong, thick line. About 45 feet in length."
msgstr "Pevné a silné lano. Dlouhé asi 15 metrů."

#: game/pro_item.msg:12800 game/pro_item.msg:12900 game/pro_item.msg:13000
#: game/pro_item.msg:13100 game/scrname.msg:645
msgid "Footlocker"
msgstr "Botník"

