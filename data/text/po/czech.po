msgstr "Otoč se doleva."

#: dialog/gsterm.msg:524
msgid "Turn Right."
msgstr "Otoč se doprava."

#: dialog/gsterm.msg:526
msgid "Move Forward."
msgstr "Jdi rovně."

#: dialog/gsterm.msg:530
msgid "Perform Procedure: Install Hydroelectric Magnetosphere Regulator"
msgstr "Vykonat Proceduru: Nainstaluj hydroelektrický regulátor magnetosféry."

#: dialog/gsterm.msg:531
msgid "Perform Procedure: Turn Main Coolant Valve--Off"
msgstr "Vykonat Proceduru: Vypni hlavní uzávěr chladícího systému."

