#: game/pro_scen.msg:80900 game/pro_scen.msg:81000 game/pro_scen.msg:217400
#: game/pro_scen.msg:217500
msgid "Chair"
msgstr "Židle"

#: game/pro_scen.msg:3901 game/pro_scen.msg:4001 game/pro_scen.msg:4101
#: game/pro_scen.msg:4201 game/pro_scen.msg:5101 game/pro_scen.msg:5201
#: game/pro_scen.msg:5301 game/pro_scen.msg:5401
msgid "It's a chair. Too bad you don't have time to sit down and relax."
msgstr "Židle. Škoda, že nemáš čas si sednout a trochu relaxovat."

#: game/pro_scen.msg:4900 game/pro_scen.msg:4901
msgid "Exit Grid Map Marker"
msgstr "Východ z mapy"

#: game/pro_scen.msg:5000
msgid "Air Processing Unit"
msgstr "Čistička vzduchu"

#: game/pro_scen.msg:5001
msgid "An APU cleans the old air to provide new air for the complex."
msgstr "Zařízení, které čistí starý vzduch a přivádí do komplexu nový vzduch."

#: game/pro_scen.msg:5500 game/pro_scen.msg:5600
msgid "VDU"
msgstr "JVV"

#: game/pro_scen.msg:5501 game/pro_scen.msg:5601
msgid "This Video Display Unit has a variety of computer monitors and other screens. It looks very, very busy."
msgstr "Jednotka video výstupu. Sdružuje několik počítačových a televizních monitorů. Na všech se něco děje."

#: game/pro_scen.msg:5701 game/pro_scen.msg:5801 game/pro_scen.msg:5901
#: game/pro_scen.msg:6001
msgid "It's a chair. It looks mighty comfortable."
msgstr "Židle. Vypadá fakt pohodlně."

#: game/pro_scen.msg:6101
msgid "It's a table. Before tables, people had to keep their stuff on the floor."
msgstr "Stůl. Než ho lidé vynalezli, museli věci pokládat na podlahu."

#: game/pro_scen.msg:6201
msgid "It's definitely a table."
msgstr "Toto je zcela určitě stůl."

#: game/pro_scen.msg:6300
msgid "Tumbleweed"
msgstr "Laskavec"

#: game/pro_scen.msg:6301
msgid "It's a tumbleweed. Of course, you've never seen a real live tumbleweed before. You'd better keep a close eye on it."
msgstr "Bylina zvaná laskavec. Ještě nikdy předtím se ti nepodařilo žádnou živou zahlédnout. Prohlédni si ji tedy pořádně."

#: game/pro_scen.msg:6400 game/pro_scen.msg:6500
msgid "Cactus"
msgstr "Kaktus"

#: game/pro_scen.msg:6401
msgid "You see nothing special about this cactus."
msgstr "Na tomto kaktusu není nic zvláštního."

#: game/pro_scen.msg:6501
msgid "You see nothing important about this cactus."
msgstr "Na tomto kaktusu není nic zajímavého."

#: game/pro_scen.msg:6600 game/pro_scen.msg:31600 game/pro_scen.msg:31700
#: game/pro_scen.msg:31800 game/pro_scen.msg:31900 game/pro_scen.msg:32000
#: game/pro_scen.msg:32100 game/pro_scen.msg:94500 game/pro_scen.msg:94600
#: game/pro_scen.msg:94700 game/pro_scen.msg:184200 game/pro_scen.msg:184300
msgid "Tree"
msgstr "Strom"

#: game/pro_scen.msg:6601
msgid "A dead tree. Nothing grows well here."
msgstr "Mrtvý strom. Tady ostatně nic neroste dobře."

#: game/pro_scen.msg:6700
msgid "Secret Blocking Hex"
msgstr "Tajný blokační hex"

#: game/pro_scen.msg:6701 game/pro_scen.msg:34401
msgid "If you can see this, blame the technical designer."
msgstr "Pokud tohle vidíš, pošli stížnost technickému návrháři."

#: game/pro_scen.msg:6800 game/pro_scen.msg:161900 game/pro_scen.msg:183500
#: game/pro_scen.msg:197900 game/pro_scen.msg:219000 game/pro_scen.msg:219100
#: game/pro_scen.msg:219200 game/proto.msg:201 game/scrname.msg:574
msgid "Stairs"
msgstr "Schody"

#: game/pro_scen.msg:6801
msgid "A set of stairs."
msgstr "Spousta schodů."

#: game/pro_scen.msg:6900 game/pro_scen.msg:7000
msgid "Stalagmite"
msgstr "Stalagmit"

#: game/pro_scen.msg:6901 game/pro_scen.msg:7001
msgid "A natural extension of the rock floor."
msgstr "Přírodní výrůstek z kamenné podlahy."

#: game/pro_scen.msg:7100
msgid "Blood Stain"
msgstr "Krvavá skvrna"

#: game/pro_scen.msg:7101
msgid "There is nothing out of the ordinary with this bloody stain. Except, of course, that someone or something died here."
msgstr "Na této skvrně není nic neobvyklého. Tedy samozřejmě kromě toho, že tu někdo nebo něco zemřelo."

#: game/pro_scen.msg:7200 game/pro_scen.msg:7300
msgid "Rock Column"
msgstr "Kamenný sloup"

#: game/pro_scen.msg:7201
msgid "This thick column of rock extends from floor to ceiling."
msgstr "Tlustý kamenný sloup vedoucí od podlahy ke stropu."

#: game/pro_scen.msg:7301
msgid "This thin column of rock extends from floor to ceiling."
msgstr "Tenký kamenný sloup vedoucí od podlahy ke stropu."

