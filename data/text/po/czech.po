msgstr "::Škrábe se.::"

#: dialog/ncslave.msg:204
msgid "::Brushes away flies::"
msgstr "::Odhání mouchy::"

#: dialog/ncslave.msg:211
msgid "*Giggle*"
msgstr "*Chichi*"

