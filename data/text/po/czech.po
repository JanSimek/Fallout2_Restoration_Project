msgstr "Jasně. Pojďme do tvého pokoje."

#: dialog/ncangbis.msg:460
msgid "I heard about what you did to the Enclave, "
msgstr "Slyšela jsem, co jsi provedl v Enklávě, "

#: dialog/ncangbis.msg:462
