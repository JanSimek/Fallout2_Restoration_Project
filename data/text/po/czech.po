#: game/pro_wall.msg:198600 game/scrname.msg:998
msgid "Wall"
msgstr "Stěna"

#: game/pro_scen.msg:13500 game/pro_scen.msg:13600 game/pro_scen.msg:13700
#: game/pro_scen.msg:13800
msgid "Drain"
msgstr "Stoka"

#: game/pro_scen.msg:13501 game/pro_scen.msg:227401
msgid "There is some sort of rank, disgusting smell coming from this sewer drain. After a few moments, it doesn't smell as bad."
msgstr "Z kanálu vychází jakýsi odporný zápach. Ale po chvíli už to není tak strašné."

#: game/pro_scen.msg:13601
msgid "You can barely make out some movement behind the grate covering this drain. You can see small red eyes peering back at you. Rat eyes."
msgstr "Skrz mříž zahlédneš nějaký pohyb. Ze tmy na tebe zírají malé rudé oči. Krysí oči."

#: game/pro_scen.msg:13701 game/pro_scen.msg:227601
msgid "Gurgling water sounds come from this drain. So does a really vile stench."
msgstr "Z kanálu se line zvuk bublající vody. A také příšerný zápach."

#: game/pro_scen.msg:13801 game/pro_scen.msg:227701
msgid "Gurgling water sounds come from beyond this drain. So does a really vile smell."
msgstr "Z kanálu se line zvuk bublající vody. A také příšerný smrad."

#: game/pro_scen.msg:13900 game/pro_scen.msg:58300 game/pro_scen.msg:58400
#: game/pro_scen.msg:219300 game/pro_scen.msg:224900 game/scrname.msg:803
#: game/scrname.msg:1097
msgid "Ladder"
msgstr "Žebřík"

#: game/pro_scen.msg:13901
msgid "It's an old, fairly rickety ladder. It looks like it will barely support your weight."
msgstr "Starý vratký žebřík. Vypadá to, že tě stěží unese."

#: game/pro_scen.msg:14000
msgid "Sewer Hole"
msgstr "Vstup do kanálu"

#: game/pro_scen.msg:14001
msgid "It looks like an access hole for the sewer system."
msgstr "Vypadá to jako vstup do stok."

#: game/pro_scen.msg:14100
msgid "Light Source"
msgstr "Světelný zdroj"

#: game/pro_scen.msg:14201 game/pro_scen.msg:14301
msgid "This looks like a standard Vault door that has been damaged, perhaps burned. It is still functional, however."
msgstr "Vypadá to jako standardní dveře vaultu, které byly pravděpodobně poškozeny ohněm. I přesto jsou stále funkční."

#: game/pro_scen.msg:14400
msgid "Cover"
msgstr "Poklop"

#: game/pro_scen.msg:14401
msgid "A heavy man-hole cover. It looks like it is in good shape, and that it was recently moved."
msgstr "Těžký poklop. Zdá se, že je v dobrém stavu a nedávno se s ním hýbalo."

#: game/pro_scen.msg:14500 game/pro_scen.msg:14600 game/pro_scen.msg:95000
#: game/pro_scen.msg:99600 game/pro_scen.msg:129800
msgid "Hole"
msgstr "Díra"

#: game/pro_scen.msg:14501 game/pro_scen.msg:14601
msgid "A large hole has been blasted through this door."
msgstr "Velká díra vypálená skrz dveře."

#: game/pro_scen.msg:14700 game/pro_scen.msg:14800 game/pro_scen.msg:14900
#: game/pro_scen.msg:15000 game/pro_scen.msg:172100 game/pro_scen.msg:172200
#: game/pro_scen.msg:172300
msgid "Supposedly Bullet Proof Glass"
msgstr "Údajně neprůstřelné sklo"

#: game/pro_scen.msg:14701 game/pro_scen.msg:14801 game/pro_scen.msg:14901
#: game/pro_scen.msg:15001 game/pro_scen.msg:172101 game/pro_scen.msg:172201
#: game/pro_scen.msg:172301
msgid "Supposedly unbreakable glass. Don't even try!"
msgstr "Údajně nerozbitné sklo. Ani to nezkoušej!"

#: game/pro_scen.msg:15101 game/pro_scen.msg:15201
msgid "This door is a piece of high-technology construction. It opens by dilating as it rotates the three pieces that make up the door."
msgstr "Tyto dveře jsou příkladem vyspělé konstrukční technologie. Skládají se ze tří pohybujících se kovových segmentů, které tvoří samotné dveře."

#: game/pro_scen.msg:15301 game/pro_scen.msg:15401
msgid "This door is emblazoned with the Brotherhood of Steel symbol."
msgstr "Tyto dveře jsou opatřeny znakem Bratrstva Oceli."

#: game/pro_scen.msg:15501 game/pro_scen.msg:15601
msgid "This is the interior of a Brotherhood elevator. It is squeaky clean!"
msgstr "Vnitřek výtahu Bratrstva. Je neuvěřitelně čistý!"

#: game/pro_scen.msg:15700
msgid "Marker"
msgstr "Symbol"

#: game/pro_scen.msg:15701
msgid "This is the symbol of the Brotherhood of Steel. This marker tells the wasteland that this is their area, and to leave immediately."
msgstr "Symbol Bratrstva Oceli. Jeho úkolem je informovat všechny příchozí o tom, že toto je území Bratrstva a že mají ihned odejít."

#: game/pro_scen.msg:15801 game/pro_scen.msg:15901 game/pro_scen.msg:16401
#: game/pro_scen.msg:16501
msgid "You see a computer monitor."
msgstr "Vidíš počítačový monitor."

#: game/pro_scen.msg:16001 game/pro_scen.msg:16101
msgid "This is a computer memory databank."
msgstr "Toto je paměťová databanka."

#: game/pro_scen.msg:16201 game/pro_scen.msg:16301
msgid "A high-tech computer, using modern reel-to-reel storage devices instead of the antiquated punch cards."
msgstr "Špičkový počítač využívající moderního záznamu na pásky namísto zastaralých děrných štítků."

#: game/pro_scen.msg:16600 game/pro_scen.msg:16700 game/pro_scen.msg:16800
#: game/pro_scen.msg:56400 game/pro_scen.msg:56500
msgid "Wire"
msgstr "Kabel"

#: game/pro_scen.msg:16601 game/pro_scen.msg:16701 game/pro_scen.msg:16801
msgid "Some sort of computer wiring."
msgstr "Několik vzájemně spletených počítačových kabelů."

#: game/pro_scen.msg:16901 game/pro_scen.msg:17001
msgid "A support column."
msgstr "Podpůrný sloup."

#: game/pro_scen.msg:17100 game/pro_scen.msg:210400
msgid "Door Entry Computer"
msgstr "Vstupní počítač"

#: game/pro_scen.msg:17101 game/pro_scen.msg:210401
msgid "This computer controls the large vault door. You have to enter a specific access code for the computer to work."
msgstr "Tento počítač ovládá vstupní dveře do vaultu. Před vstupem musíš zadat přístupový kód."

#: game/pro_scen.msg:17200 game/pro_scen.msg:17500 game/pro_scen.msg:126700
#: game/pro_scen.msg:126800 game/pro_scen.msg:126900 game/pro_scen.msg:127000
#: game/pro_scen.msg:127100 game/pro_scen.msg:127200
msgid "Casino Sign"
msgstr "Cedule \"Kasíno\""

#: game/pro_scen.msg:17201
msgid "It looks like an advertisement for Gizmo's Casino."
msgstr "Reklama na Gizmovo kasíno."

#: game/pro_scen.msg:17300 game/pro_scen.msg:17400
msgid "Vault 13 Outer Door"
msgstr "Vnější dveře Vaultu 13"

#: game/pro_scen.msg:17301 game/pro_scen.msg:17401 game/pro_scen.msg:205501
#: game/pro_scen.msg:206001
msgid "This large door is the link between the vault and the outside world."
msgstr "Tyto mohutné dveře jsou jedinou spojnicí mezi vaultem a vnějším světem."

#: game/pro_scen.msg:17501
msgid "This part of the sign contains an electric motor that is slowly spinning the attached neon sign."
msgstr "Neon, kterým pomalu otáčí elektrický motor."

#: game/pro_scen.msg:17600
msgid "Down Arrow"
msgstr "Šipka dolů"

#: game/pro_scen.msg:17700
msgid "Up Arrow"
msgstr "Šipka nahoru"

#: game/pro_scen.msg:18100
msgid "Elevator Top"
msgstr "Vršek výtahu"

#: game/pro_scen.msg:18101
msgid "You are looking at a portion of an elevator."
msgstr "Díváš se na horní část výtahu."

#: game/pro_scen.msg:18200 game/pro_scen.msg:18300 game/pro_scen.msg:77000
#: game/pro_scen.msg:184900
msgid "Computer Console"
msgstr "Počítačová konzole"

#: game/pro_scen.msg:18201 game/pro_scen.msg:18301
msgid "This is a dumb terminal, hooked up by cable to a large computer."
msgstr "Jednoduchý terminál propojený kabelem s hlavním počítačem."

#: game/pro_scen.msg:18400 game/pro_scen.msg:18500 game/pro_scen.msg:85200
msgid "Emblem"
msgstr "Emblém"

#: game/pro_scen.msg:18401 game/pro_scen.msg:18501
msgid "The symbol of the Brotherhood. The gears represent their engineering knowledge, the sword is their will to defend themselves and the wings are the uplifting hope."
msgstr "Erb Bratrstva. Ozubená kola symbolizují technické vědomosti Bratrstva, meč jejich odhodlání se bránit a křídla znamenají naději, která umírá poslední."

#: game/pro_scen.msg:18600
msgid "Level 'One' Sign"
msgstr "Označení 'Jednička'"

#: game/pro_scen.msg:18601
msgid "You think this could mean that you are on level one."
msgstr "Myslíš si, že by to mohlo znamenat, že jsi v prvním patře."

#: game/pro_scen.msg:18700
msgid "Level 'Two' Sign"
msgstr "Označení 'Dvojka'"

#: game/pro_scen.msg:18701
msgid "You are on level two."
msgstr "Jsi ve druhém patře."

#: game/pro_scen.msg:18800
msgid "Level 'Three' Sign"
msgstr "Označení 'Trojka'"

#: game/pro_scen.msg:18801
msgid "This must mean that you are on level three."
msgstr "Určitě to znamená, že jsi ve třetím patře."

#: game/pro_scen.msg:18900
msgid "Level 'Four' Sign"
msgstr "Označení 'Čtyři'"

#: game/pro_scen.msg:18901
msgid "You must be on level four."
msgstr "Nejspíš budeš ve čtvrtém patře."

#: game/pro_scen.msg:19000 game/pro_scen.msg:19100 game/pro_scen.msg:19200
msgid "Bunk Bed"
msgstr "Palanda"

#: game/pro_scen.msg:19001 game/pro_scen.msg:19101 game/pro_scen.msg:19201
#: game/pro_scen.msg:56101 game/pro_scen.msg:56201 game/pro_scen.msg:56301
msgid "A military-style bunk bed. Looks very uncomfortable. Also looks like you could bounce a quarter off of these sheets."
msgstr "Vojenská palanda. Vypadá velmi nepohodlně a prostěradlo je napnuté jako kšandy."

#: game/pro_scen.msg:19400 game/scrname.msg:1373
msgid "Nuka-Cola Machine"
msgstr "Automat na Nuka-Colu"

#: game/pro_scen.msg:19401
msgid "The advertising on the side of this machine promotes their popular soda."
msgstr "Reklama na boku automatu vychvaluje tento populární nápoj."

#: game/pro_scen.msg:19600
msgid "Trapdoor"
msgstr "Padací dveře"

#: game/pro_scen.msg:19601
msgid "It looks like a perfectly good trapdoor."
msgstr "Dokonale funkční padací dveře."

#: game/pro_scen.msg:19700 game/scrname.msg:772 game/scrname.msg:1095
msgid "Manhole"
msgstr "Průlez"

#: game/pro_scen.msg:19701
msgid "The ladder in this manhole leads down into the darkness below. Ohhh, scary."
msgstr "Žebřík vede kamsi dolů do temnoty. Brrr, to je strašidelné."

#: game/pro_scen.msg:19800 game/pro_scen.msg:48400 game/pro_scen.msg:48600
#: game/pro_scen.msg:50500 game/pro_scen.msg:50600 game/pro_scen.msg:50700
#: game/pro_scen.msg:50800 game/pro_scen.msg:52200 game/pro_scen.msg:52300
#: game/pro_scen.msg:52400
msgid "Altar"
msgstr "Oltář"

#: game/pro_scen.msg:19801
msgid "This is an altar."
msgstr "Toto je oltář."

#: game/pro_scen.msg:19900
msgid "Pulpit"
msgstr "Řečnický stolek"

#: game/pro_scen.msg:19901
msgid "People stand behind this and talk. It looks like it has a little place to hold a prepared speech."
msgstr "Za touto věcí lidé obvykle stojí a mluví. Má to dokonce i malý pultík, kam si můžeš položit připravenou řeč."

#: game/pro_scen.msg:20000 game/pro_scen.msg:26200 game/pro_scen.msg:26300
#: game/pro_scen.msg:26400 game/pro_scen.msg:34700 game/pro_scen.msg:52500
msgid "Pew"
msgstr "Lavice"

#: game/pro_scen.msg:20001
msgid "This looks just like you would expect it to. Nothing special about this pew."
msgstr "Lavice vypadá přesně tak, jak se by dalo očekávat. Není na ní nic zvláštního."

#: game/pro_scen.msg:20100 game/pro_scen.msg:20200 game/pro_scen.msg:20300
#: game/pro_scen.msg:20400 game/pro_scen.msg:20500 game/pro_scen.msg:29800
#: game/pro_scen.msg:29900 game/pro_scen.msg:142600
msgid "Signpost"
msgstr "Ukazatel"

#: game/pro_scen.msg:20101 game/pro_scen.msg:20201 game/pro_scen.msg:20301
#: game/pro_scen.msg:20401 game/pro_scen.msg:20501
msgid "The sign on this post looks a little rusty."
msgstr "Písmena na tomto ukazateli jsou trochu rezavá."

#: game/pro_scen.msg:20600 game/pro_scen.msg:20700
msgid "Old Mattress"
msgstr "Stará matrace"

#: game/pro_scen.msg:20601
msgid "An old, beat-up mattress. You think you see some sort of small bug-like critter infesting it."
msgstr "Stará vysloužilá matrace. Máš pocit, že je zamořená nějakým druhem malých brouků."

#: game/pro_scen.msg:20701
msgid "Even if you were to sleep by yourself on this thing, you would not be sleeping alone."
msgstr "I kdybys spal na této věci sám, nespal bys sám."

#: game/pro_scen.msg:20801 game/pro_scen.msg:20901
msgid "A makeshift bed. The material was scavenged from some other source."
msgstr "Provizorní postel. Vyrobená z toho, co bylo zrovna po ruce."

#: game/pro_scen.msg:21001
msgid "This bed has seen better days (and probably nights, too.)"
msgstr "Tato postel už zažila lepší dny (a noci nejspíš taky.)"

#: game/pro_scen.msg:21101 game/pro_scen.msg:227801 game/pro_scen.msg:227901
#: game/pro_scen.msg:228001
msgid "On closer examination, you determine that the sheets have not been changed in a very, very long time."
msgstr "Po bližším prozkoumání docházíš k závěru, že prostěradlo nebylo vyměněno už velmi, velmi dlouho."

#: game/pro_scen.msg:21201
msgid "There are a couple of stains of dubious origin on this well-worn sleeping device."
msgstr "Na tomto velmi opotřebovaném spacím zařízení je několik pochybných skvrn neidentifikovatelného původu."

#: game/pro_scen.msg:21301
msgid "This bed has seen a lot of use and wear. Something must have crawled between the mattresses and died, too."
msgstr "Tato postel už toho zažila opravdu hodně. A taky se zdá, že něco vlezlo mezi matrace a chcíplo tam."

#: game/pro_scen.msg:21700 game/pro_scen.msg:21800 game/pro_scen.msg:21900
#: game/pro_scen.msg:24100 game/pro_scen.msg:24200 game/pro_scen.msg:32200
#: game/pro_scen.msg:51100 game/pro_scen.msg:51200 game/pro_scen.msg:51300
#: game/pro_scen.msg:51400 game/pro_scen.msg:51500 game/pro_scen.msg:153800
#: game/pro_scen.msg:153900 game/pro_scen.msg:154000 game/pro_scen.msg:154100
#: game/pro_scen.msg:154200 game/pro_scen.msg:154300 game/pro_scen.msg:154400
#: game/pro_scen.msg:154500
msgid "UNUSED."
msgstr "UNUSED."

#: game/pro_scen.msg:22000 game/pro_scen.msg:22100 game/pro_scen.msg:22200
#: game/pro_scen.msg:22300 game/pro_scen.msg:27500 game/pro_scen.msg:27600
msgid "Boxes"
msgstr "Krabice"

#: game/pro_scen.msg:22001 game/pro_scen.msg:22301
msgid "These wooden boxes are falling apart from the weather."
msgstr "Dřevěné bedny, které se vlivem počasí takřka rozpadly."

#: game/pro_scen.msg:22101
msgid "You find no details worth mentioning about these wooden boxes."
msgstr "Na těchto dřevěných bednách nenacházíš nic, co by stálo za řeč."

#: game/pro_scen.msg:22201
msgid "You have a lot of time on your hands to be looking closely at this rotten junk."
msgstr "Musíš mít opravdu asi hodně času, když prohledáváš i tento shnilý odpad."

#: game/pro_scen.msg:22400 game/pro_scen.msg:22500 game/pro_scen.msg:22600
#: game/pro_scen.msg:22700 game/pro_scen.msg:22800 game/pro_scen.msg:40800
#: game/pro_scen.msg:40900 game/pro_scen.msg:41000 game/pro_scen.msg:100900
#: game/pro_scen.msg:101100 game/pro_scen.msg:230900 game/pro_scen.msg:231000
#: game/pro_scen.msg:231100 game/pro_scen.msg:231200 game/scrname.msg:404
#: game/scrname.msg:826 game/scrname.msg:827
msgid "Car"
msgstr "Auto"

#: game/pro_scen.msg:22401 game/pro_scen.msg:230901
msgid "This automobile is in terrible shape. You cannot think of a way to restore it."
msgstr "Tento automobil je v naprosto příšerném stavu. Nemáš nejmenší tušení, jak by se dal opravit."

#: game/pro_scen.msg:22501 game/pro_scen.msg:231001
msgid "This rusted piece of scrap-metal cannot be restored."
msgstr "Tento zrezivělý kus šrotu už asi opravit nepůjde."

#: game/pro_scen.msg:22601 game/pro_scen.msg:231101
msgid "You determine that this vehicle will never drive again. Really."
msgstr "Docházíš k závěru, že tento vůz už nebude nikdy jezdit. Opravdu."

#: game/pro_scen.msg:22701 game/pro_scen.msg:231201
msgid "There is no way that this junkyard wannabe will ever drive again."
msgstr "Tento kus šrotu už nebude v žádném případě jezdit."

#: game/pro_scen.msg:22801
msgid "If the Mechanic of the Year suddenly appeared next to you, both of you could not fix this rusty heap."
msgstr "I kdyby se vedle tebe zčistajasna objevil Mechanik Roku, nebylo by ti to nic platné. Stejně byste nebyli schopni tuhle zrezivělou hromadu železa opravit."

#: game/pro_scen.msg:22901
msgid "A comfy chair."
msgstr "Pohodlná židle."

#: game/pro_scen.msg:23001
msgid "This chair looks like it has seen better years."
msgstr "Tato židle už zažila lepší dny."

#: game/pro_scen.msg:23101
msgid "This chair is moldy and gross. As you can guess, it stinks, too."
msgstr "Tato židle je zplesnivělá a odporná. A navíc páchne."

#: game/pro_scen.msg:23201
msgid "This chair is falling apart. Quickly."
msgstr "Tato židle se rozpadá. Hodně rychle."

#: game/pro_scen.msg:23301
msgid "If someone paid you a lot of money, and you could use steel britches, you might consider sitting in this chair."
msgstr "Kdyby ti někdo zaplatil opravdu hodně peněz a navíc bys měl na sobě železné brnění, tak by ses na tuto židli možná i posadil."

#: game/pro_scen.msg:23401
msgid "This looks like an old office chair, still in pretty good shape after all these years."
msgstr "Stará kancelářská židle. Po všech těch letech je kupodivu v docela dobrém stavu."

#: game/pro_scen.msg:23501
msgid "This is an old office chair. It might even support the weight of a person."
msgstr "Stará kancelářská židle. Možná by ještě udržela dospělého člověka."

#: game/pro_scen.msg:23601
msgid "This office chair has seen better days. It's pretty much trash, now."
msgstr "Tato kancelářská židle už zažila lepší dny. Teď už je ale víceméně na vyhození."

#: game/pro_scen.msg:23701
msgid "This looks like a chair you would see in a mortician's office - dead."
msgstr "Tohle vypadá přesně jako židle, kterou můžeš vidět v márnici. Mrtvou."

#: game/pro_scen.msg:24300
msgid "Fire Hydrant"
msgstr "Požární hydrant"

#: game/pro_scen.msg:24301
msgid "This is a fire hydrant. Without Vault ceiling sprinklers, you might need one of these to put out fires."
msgstr "Toto je požární hydrant. Až bude někdy hořet, zapomeň na požární systém ve vaultech a použij tohle."

#: game/pro_scen.msg:24400 game/pro_scen.msg:24500 game/pro_scen.msg:24600
#: game/pro_scen.msg:24700 game/pro_scen.msg:24800 game/pro_scen.msg:24900
#: game/pro_scen.msg:25000 game/pro_scen.msg:88600
msgid "Lamp Post"
msgstr "Lampa"

#: game/pro_scen.msg:24401
msgid "This lamp post looks like it is still in working condition. Imagine that, something that works out here."
msgstr "Tato lampa je kupodivu stále ještě funkční. A vidět tady něco, co funguje, je takřka malý zázrak."

#: game/pro_scen.msg:24501
msgid "This lamp post will never work again."
msgstr "Tato lampa už nikdy nebude fungovat."

#: game/pro_scen.msg:24601
msgid "This is a working lamp post. At night, it casts a pale, gentle light that reminds you of absolutely nothing."
msgstr "Tato lampa v noci vyzařuje jemné tlumené světlo, které ti vůbec nic nepřipomíná."

#: game/pro_scen.msg:24701
msgid "This is a broken lamp post. It cannot be fixed."
msgstr "Toto je rozbitá lampa. Nedá se opravit."

#: game/pro_scen.msg:24801
msgid "This light fixture is operational."
msgstr "Tato lampa je stále ještě funkční."

#: game/pro_scen.msg:24901
msgid "The light in this lamp post is shattered beyond repair."
msgstr "Tato lampa je tak zničená, že už se nedá opravit."

#: game/pro_scen.msg:25001
msgid "This is a functional lamp post."
msgstr "Tato lampa je stále ještě funkční."

#: game/pro_scen.msg:25101
msgid "The lock on this gate has been jammed shut and the bars look very sturdy."
msgstr "Zámek brány je zaseklý a závory vypadají velmi robustně."

#: game/pro_scen.msg:25201 game/pro_scen.msg:25301 game/pro_scen.msg:25401
#: game/pro_scen.msg:25501 game/pro_scen.msg:25601
msgid "Definitely useless junk, no doubt about it."
msgstr "Nepochybně zcela nepoužitelné haraburdí."

#: game/pro_scen.msg:25700
msgid "Mailbox"
msgstr "Poštovní schránka"

#: game/pro_scen.msg:25701
msgid "The mailbox is empty. You get the feeling it's been that way for a while."
msgstr "Schránka je prázdná a máš takový pocit, že už se dlouho nepoužívala."

#: game/pro_scen.msg:25801 game/pro_scen.msg:25901 game/pro_scen.msg:26001
#: game/pro_scen.msg:26101
msgid "A nicely crafted wooden door, in good condition."
msgstr "Kvalitně vyrobené dřevěné dveře v dobrém stavu."

#: game/pro_scen.msg:26201
msgid "This wooden pew is slowly falling apart."
msgstr "Tato dřevěná lavice se pomalu rozpadá."

#: game/pro_scen.msg:26301
msgid "This pew has been neglected, and is showing signs of wear and tear."
msgstr "Tato lavice byla zanedbána a podepisuje se na ní zub času."

#: game/pro_scen.msg:26401
msgid "A wooden pew that has succumbed to the effects of age and abuse."
msgstr "Dřevěná lavice pomalu podléhající vlivu staří a špatného zacházení."

#: game/pro_scen.msg:26500 game/pro_scen.msg:26600 game/pro_scen.msg:26700
#: game/pro_scen.msg:26800 game/pro_scen.msg:26900 game/pro_scen.msg:27000
msgid "Newspaper Machine"
msgstr "Novinový automat"

#: game/pro_scen.msg:26501 game/pro_scen.msg:26601 game/pro_scen.msg:26701
#: game/pro_scen.msg:26801 game/pro_scen.msg:26901
msgid "The newspaper machine is empty."
msgstr "Je prázdný."

#: game/pro_scen.msg:27001
msgid "The newspaper machine is empty. It looks like it once held adult magazines."
msgstr "Je prázdný. Zdá se, že v něm dřív byly časopisy pro pány."

#: game/pro_scen.msg:27101
msgid "A bed mattress in terrible condition. Even the rats won't sleep in or on it."
msgstr "Tato matrace je v příšerném stavu. Ani krysy by v ní, nebo na ní, nespali."

#: game/pro_scen.msg:27201
msgid "A twin bed mattress that has seen many better days than this one."
msgstr "Manželská matrace, která už zažila i lepší dny."

#: game/pro_scen.msg:27301
msgid "A pile of rotted and weathered wood. Not worth it's weight in, well, anything."
msgstr "Hromada shnilého dřeva. Nemá cenu ani své vlastní váhy. Vlastně nemá vůbec žádnou cenu."

#: game/pro_scen.msg:27401
msgid "A pile of wood, with some rusty useless nails imbedded deeply."
msgstr "Hromada dřeva, ze kterého místy vykukují ohnuté zrezivělé hřebíky."

#: game/pro_scen.msg:27501
msgid "A pile of old, cardboard boxes. You cannot believe that they have survived for this long."
msgstr "Kupa starých kartónových krabic. Nechce se ti věřit, že něco takového přežilo tak dlouho."

#: game/pro_scen.msg:27601
msgid "A pile of old, cardboard boxes."
msgstr "Kupa starých kartónových krabic."

#: game/pro_scen.msg:27701
msgid "Some junk that you think might have been a bed mattress before it was destroyed by the environment."
msgstr "Nějaké haraburdí, které kdysi pravděpodobně byla matrace, než ji zničilo počasí."

#: game/pro_scen.msg:28100 game/pro_scen.msg:50900
msgid "Rubble"
msgstr "Suť"

#: game/pro_scen.msg:28101
msgid "A small pile of rubbled stones and rocks. Watch your step!"
msgstr "Spousta úlomků kamenů a kamínků. Dávej si pozor, kam šlapeš!"

#: game/pro_scen.msg:28200 game/pro_scen.msg:28300 game/pro_scen.msg:28400
#: game/pro_scen.msg:28500 game/pro_scen.msg:61500 game/pro_scen.msg:61900
msgid "Sink"
msgstr "Umyvadlo"

#: game/pro_scen.msg:28201
msgid "A porcelain sink that has long lost the ability to function."
msgstr "Porcelánové umyvadlo, které už dávno nefunguje."

#: game/pro_scen.msg:28301 game/pro_scen.msg:28501
msgid "A broken porcelain sink. There is small puddle of brown water in the basin, with a floating dead rat."
msgstr "Rozbité porcelánové umyvadlo. Na dně se drží trocha nahnědlé vody, ve které plave mrtvá krysa."

#: game/pro_scen.msg:28401
msgid "This sink is not functional. You can tell this from the large crack down the middle."
msgstr "Podle té velké díry ve spodní části usuzuješ, že je toto umyvadlo rozbité."

#: game/pro_scen.msg:28600 game/pro_scen.msg:28700
msgid "Stop Sign"
msgstr "Dopravní značka"

#: game/pro_scen.msg:28601
msgid "A red sign with the word STOP written in large block letters."
msgstr "Červená dopravní značka, na které je velkými tiskacími písmeny napsáno slovo STOP."

#: game/pro_scen.msg:28701
msgid "A red sign with the word STOP written in large block letters. The large bullet hole was added after manufacturing."
msgstr "Červená dopravní značka, na které je velkými tiskacími písmeny napsáno slovo STOP. Díry po kulkách nejsou součástí původního výrobního procesu."

#: game/pro_scen.msg:28800 game/pro_scen.msg:28900 game/pro_scen.msg:29000
msgid "Stop Light"
msgstr "Semafor"

#: game/pro_scen.msg:28801 game/pro_scen.msg:28901 game/pro_scen.msg:29001
msgid "This is an ancient automobile traffic control device."
msgstr "Starodávná pomůcka pro řízení dopravy."

#: game/pro_scen.msg:29100 game/pro_scen.msg:29200 game/pro_scen.msg:29300
#: game/pro_scen.msg:29400 game/pro_scen.msg:29500 game/pro_scen.msg:29600
#: game/pro_scen.msg:29700
msgid "Street Light"
msgstr "Pouliční lampa"

#: game/pro_scen.msg:29101 game/pro_scen.msg:29201 game/pro_scen.msg:29301
#: game/pro_scen.msg:29401
msgid "This street light provides illumination after night falls, or in darkened areas."
msgstr "Tato lampa poskytuje osvětlení v noci nebo v temných prostorách."

#: game/pro_scen.msg:29501 game/pro_scen.msg:29601 game/pro_scen.msg:29701
msgid "This street light could provide illumination in darkened areas, if it wasn't completely broken."
msgstr "Tato lampa by mohla osvětlovat tmavou ulici, kdyby ovšem nebyla zcela rozbitá."

#: game/pro_scen.msg:29801 game/pro_scen.msg:29901
msgid "This sign should mark what street it is on, but the letters have faded into obscurity."
msgstr "Tento ukazatel kdysi oznamoval název ulice, ale písmena už dávno vybledla a jsou nečitelná."

#: game/pro_scen.msg:30001 game/pro_scen.msg:30101
msgid "A wooden table, in fair to middling condition."
msgstr "Dřevený stůl ve slušném stavu."

#: game/pro_scen.msg:30201
msgid "A wooden table, in middling to poor condition."
msgstr "Dřevený stůl v podprůměrném stavu."

#: game/pro_scen.msg:30301
msgid "A wooden table, with plastic surface, that has been broken for a while."
msgstr "Dřevěný stůl potažený notně poškrábanou a popraskanou plastikovou deskou."

#: game/pro_scen.msg:30401
msgid "A wooden table, painted a puke green color, that is beyond repair."
msgstr "Dřevěný stůl natřený odporným odstínem zelené barvy. Nelze opravit."

#: game/pro_scen.msg:30501 game/pro_scen.msg:30601
msgid "This looks like an old coffee table, low to the ground for those really short mutants."
msgstr "Nízký kavárenský stolek. Zvláště vhodný pro malé mutanty."

#: game/pro_scen.msg:30700 game/pro_scen.msg:30800 game/pro_scen.msg:30900
#: game/pro_scen.msg:31000 game/pro_scen.msg:61600 game/pro_scen.msg:61800
#: game/pro_scen.msg:69000 game/pro_scen.msg:175400 game/scrname.msg:311
#: game/scrname.msg:1296
msgid "Toilet"
msgstr "Záchod"

#: game/pro_scen.msg:30701
msgid "The sharpened edges around the seat make this a very uncomfortable place to sit."
msgstr "Ostré okraje mísy by ti určitě dokázaly celou proceduru pořádně znepříjemnit."

#: game/pro_scen.msg:30801
msgid "This toilet is broken."
msgstr "Tento záchod je rozbitý."

#: game/pro_scen.msg:30901
msgid "Yuck! Whoever used this last did not flush!"
msgstr "Fuj! Ten, kdo tu byl naposled, po sobě nespláchl!"

#: game/pro_scen.msg:31001
msgid "This toilet is broken and definitely not useable if you're a woman."
msgstr "Tento záchod je rozbitý a pro ženy naprosto nepoužitelný."

#: game/pro_scen.msg:31100 game/pro_scen.msg:31200 game/pro_scen.msg:31300
#: game/pro_scen.msg:31400
msgid "Trash"
msgstr "Odpadky"

#: game/pro_scen.msg:31101
msgid "Some busted pipes half-buried in the dirt. Nothing important to see here. Move along."
msgstr "Trubky napůl zahrabané v zemi. Tady nic zajímavého neuvidíš. Jdi dál."

#: game/pro_scen.msg:31201 game/pro_scen.msg:31301
msgid "Some broken pieces of glass and other ruined pieces of junk."
msgstr "Spousta střepů a jiného odpadu."

#: game/pro_scen.msg:31401
msgid "A pipe that has been snapped in half. It looks like it rusted until it collapsed under it's own weight."
msgstr "Trubka je v půlce zlomená. Vypadá to, že zrezivěla a přelomila se vlastní vahou."

#: game/pro_scen.msg:31500
msgid "Trash Can"
msgstr "Odpadkový koš"

#: game/pro_scen.msg:31501
msgid "A trash can. You can barely read the label: Keep your city streets clean!"
msgstr "Koš na odpadky. Ještě stále na něm lze rozeznat nápis \"Udržujte naše ulice čisté!\""

#: game/pro_scen.msg:31601 game/pro_scen.msg:31801
msgid "It's a dead tree."
msgstr "Uschlý strom."

#: game/pro_scen.msg:31701
msgid "A stump. Nothing really exciting. In fact, this might be the least exciting thing you have ever laid your eyes on."
msgstr "Pařez. Nic vzrušujícího. Ve skutečnosti je to ta nejméně zajímavá věc, na které kdy spočinulo tvé oko."

#: game/pro_scen.msg:32300 game/pro_scen.msg:32400 game/pro_wall.msg:97700
#: game/pro_wall.msg:97800 game/pro_wall.msg:97900 game/pro_wall.msg:98000
#: game/pro_wall.msg:98100 game/pro_wall.msg:98200 game/pro_wall.msg:98300
#: game/pro_wall.msg:98400 game/pro_wall.msg:98500 game/pro_wall.msg:98600
#: game/pro_wall.msg:98700
msgid "Truck"
msgstr "Náklaďák"

#: game/pro_scen.msg:32301
msgid "The ruined remains of a diesel truck. This hunk of metal will never move again."
msgstr "Trosky nákladního auta poháněného dieselovým motorem. Tato hora železa se už nikdy nepohne."

#: game/pro_scen.msg:32401
msgid "This diesel truck is beyond help. Way beyond help."
msgstr "Tomuto dieselovému náklaďáku už není pomoci. Ani ve snu."

#: game/pro_scen.msg:32500 game/pro_scen.msg:32600
msgid "Bath Tub"
msgstr "Vana"

#: game/pro_scen.msg:32501
msgid "This bath tub is broken and cracked."
msgstr "Tato vana je rozbitá a prasklá."

#: game/pro_scen.msg:32601
msgid "On closer examination, you realize that you won't be taking your bath in this tub after all."
msgstr "Po bližším prozkoumání konstatuješ, že se v této vaně asi nevykoupeš."

#: game/pro_scen.msg:32700 game/pro_scen.msg:32800 game/pro_scen.msg:32900
#: game/pro_scen.msg:33000 game/pro_scen.msg:61700 game/pro_scen.msg:62000
msgid "Urinal"
msgstr "Pisoár"

#: game/pro_scen.msg:32701 game/pro_scen.msg:32801
msgid "It's just a urinal."
msgstr "Obyčejný pisoár."

#: game/pro_scen.msg:32901 game/pro_scen.msg:33001
msgid "It's just a urinal. Nothing special."
msgstr "Obyčejný pisoár. Nic zvláštního."

#: game/pro_scen.msg:33100 game/pro_scen.msg:200300 game/pro_wall.msg:114400
#: game/pro_wall.msg:114500 game/pro_wall.msg:114600 game/pro_wall.msg:114700
#: game/pro_wall.msg:114800 game/pro_wall.msg:114900 game/pro_wall.msg:115000
#: game/pro_wall.msg:115100 game/pro_wall.msg:115200 game/pro_wall.msg:115300
msgid "Water Tank"
msgstr "Vodní nádrž"

#: game/pro_scen.msg:33101 game/pro_scen.msg:200301
msgid "A large tank that holds liquids. In this case, you believe that it was designed to store water."
msgstr "Velký zásobník na tekutiny. V tomto případě to bude asi nádrž na vodu."

#: game/pro_scen.msg:33201
msgid "A wooden door. Nothing extremely interesting about it."
msgstr "Dřevěné dveře. Není na nich vůbec nic zajímavého."

#: game/pro_scen.msg:33301
msgid "A wooden door. It provides an entrance and egress from this building."
msgstr "Dřevěné dveře. Umožňují vstup a výstup z budovy."

#: game/pro_scen.msg:33400 game/pro_scen.msg:33500 game/pro_scen.msg:33600
#: game/pro_scen.msg:33700 game/pro_scen.msg:33800 game/pro_scen.msg:33900
#: game/pro_scen.msg:34000 game/pro_scen.msg:34100
msgid "Wall Lamp"
msgstr "Nástěnná lampa"

#: game/pro_scen.msg:33401 game/pro_scen.msg:33601 game/pro_scen.msg:33801
#: game/pro_scen.msg:34001
msgid "This lamp looks it is in good working condition."
msgstr "Tato lampa je v celkem slušném stavu."

#: game/pro_scen.msg:33501 game/pro_scen.msg:33701 game/pro_scen.msg:33901
#: game/pro_scen.msg:34101
msgid "A broken lamp. It is not surprising that it does not work."
msgstr "Rozbitá lampa. Není žádným překvapením, že nefunguje."

#: game/pro_scen.msg:34200 game/pro_scen.msg:34300
msgid "Yield Sign"
msgstr "Dopravní značka"

#: game/pro_scen.msg:34201
msgid "This was a sign to control the flow of traffic."
msgstr "Toto je značka, která se používala k řízení dopravy."

#: game/pro_scen.msg:34301
msgid "The sign is faded, but you can make out the world YIELD."
msgstr "Vybledlá značka na zkorodovaném sloupku."

#: game/pro_scen.msg:34400
msgid "Block Hex Auto Inviso"
msgstr "Block Hex Auto Inviso"

#: game/pro_scen.msg:34500 game/pro_scen.msg:76700 game/pro_scen.msg:122900
#: game/pro_tile.msg:24000 game/pro_tile.msg:24100 game/pro_tile.msg:24200
#: game/pro_tile.msg:24300 game/pro_tile.msg:24400 game/pro_tile.msg:24500
#: game/pro_tile.msg:24600 game/pro_tile.msg:24700 game/pro_tile.msg:24800
#: game/pro_tile.msg:24900 game/pro_tile.msg:25000 game/pro_tile.msg:25100
#: game/pro_tile.msg:37000 game/pro_tile.msg:37100 game/pro_tile.msg:37200
#: game/pro_tile.msg:39800 game/pro_tile.msg:39900 game/pro_tile.msg:40000
#: game/pro_tile.msg:40100 game/pro_tile.msg:40200 game/pro_tile.msg:40300
#: game/pro_tile.msg:40400 game/pro_tile.msg:40500 game/pro_tile.msg:40600
#: game/pro_tile.msg:40700 game/pro_tile.msg:40800 game/pro_tile.msg:40900
#: game/pro_tile.msg:41000 game/pro_tile.msg:41100 game/pro_tile.msg:41200
#: game/pro_tile.msg:41300 game/pro_tile.msg:41500 game/pro_tile.msg:41600
#: game/pro_tile.msg:66100 game/pro_tile.msg:242300 game/pro_tile.msg:242400
#: game/pro_tile.msg:242500 game/pro_tile.msg:242600 game/pro_tile.msg:242700
#: game/pro_tile.msg:242800 game/pro_tile.msg:242900 game/pro_tile.msg:243000
#: game/pro_tile.msg:243100 game/pro_tile.msg:243200 game/pro_tile.msg:243300
#: game/pro_tile.msg:243400 game/pro_tile.msg:243500 game/pro_tile.msg:243600
#: game/pro_tile.msg:243700 game/pro_tile.msg:243800 game/pro_tile.msg:243900
