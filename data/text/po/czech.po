#: dialog/abdoor.msg:417 dialog/door.msg:417
msgid "You see a sturdy door which you may be able to pry open."
msgstr "Vidíš bytelné dveře, které by se daly vypáčit."

#: dialog/abdoor.msg:500 dialog/door.msg:500
msgid "This door is too heavy to pry open."
msgstr "Tyto dveře jsou příliš těžké, než aby šli vypáčit."

#: dialog/abdoor.msg:501 dialog/door.msg:501
msgid "Looks like you need to get the generator working first."
msgstr "Vypadá to, že musíš nejdříve zprovoznit generátor."

#: dialog/abdoor.msg:502 dialog/door.msg:502
msgid "You see: Elevator door."
msgstr "Vidíš dveře od výtahu."

#: dialog/abdoor.msg:503 dialog/door.msg:503
msgid "Looks like you need an electric device to open this lock."
msgstr "Vypadá to, že k otevření tohoto zámku budeš potřebovat nějaké elektrické zařízení."

#: dialog/abelaine.msg:100
msgid "You see a stout nun."
msgstr "Vidíš silnou jeptišku."

#: dialog/abelaine.msg:101
msgid "You see Elaine."
msgstr "Vidíš Elaine."

#: dialog/abelaine.msg:102
msgid "You still see her."
msgstr "Pořád ji vidíš."

#: dialog/abelaine.msg:200
msgid "Greetings!"
msgstr "Zdravím!"

#: dialog/abelaine.msg:201
