#: dialog/vced.msg:153 dialog/vclynett.msg:438 dialog/vcmoore.msg:225
#: dialog/vcsteve.msg:107
msgid "Goodbye."
msgstr "Sbohem."

#: dialog/acfist.msg:116
msgid "Hmmm -- spend a day with me and I'll teach you how to punch harder."
msgstr "Hmmm... zůstaň tu se mnou jeden den a naučím tě, jak rozdávat větší rány."

#: dialog/acfist.msg:117
msgid "Okay. Let's do it."
msgstr "Dobře. Pojďme na to."

#: dialog/acfist.msg:118
msgid "Sorry, don't have the time right now."
msgstr "Promiň, zrovna teď nemám čas."

#: dialog/acfist.msg:119
msgid "You know all I can teach you, Chosen One. Good luck to you on your quest."
msgstr "Umíš už všechno, co vím, Vyvolený. Hodně štěstí při tvém poslání."

#: dialog/acfist.msg:120 dialog/acfist.msg:122 dialog/acfist.msg:124
#: dialog/acfist.msg:126 dialog/bcdalia.msg:147 dialog/dccaesar.msg:261
#: dialog/dclara.msg:241 dialog/gcbrain.msg:462 dialog/rcsavine.msg:147
#: dialog/rcstanwl.msg:147 dialog/rcwade.msg:147 dialog/vcvltgrd.msg:139
msgid "Oh, okay."
msgstr "Aha, dobře."

#: dialog/acfist.msg:121
msgid "Ha! Chosen One, you aren't graceful enough for me to teach you anything."
msgstr "Hm. Vyvolený, nejsi dost obratný. Nemůžu tě nic naučit."

#: dialog/acfist.msg:123
msgid "You are not quick enough in combat for my training to help you, Chosen One."
msgstr "Vyvolený, chybí ti rychlost pohybu. Můj trénink ti nepomůže."

#: dialog/acfist.msg:125
msgid "You need to learn more about combat before I can help you, little brother."
msgstr "Musíš se zlepšit v boji, než tě budu moct začít trénovat."

#: dialog/acfist.msg:127
msgid "I can teach you a more powerful kick. It will take us all of one day."
msgstr "Můžu tě naučit jeden velmi mocný kop. Potrvá nám to jeden celý den."

#: dialog/acfist.msg:128 dialog/acfist.msg:130 dialog/actemvil.msg:124
