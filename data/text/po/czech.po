#: game/cmbatai2.msg:1507 game/combatai.msg:1507
msgid "Your magic is powerful."
msgstr "Tvoje magie být silná."

#: game/cmbatai2.msg:1508 game/combatai.msg:1508
msgid "You cannot steal my soul that way."
msgstr "Ty mně neukradneš duši. Takhle ne."

