#: dialog/vcskeeve.msg:230 dialog/vcstark.msg:134 dialog/vcstark.msg:362
#: dialog/vcwalace.msg:113 dialog/vcwalace.msg:120 dialog/vcwalace.msg:137
#: dialog/vcwalace.msg:143 dialog/vcwalace.msg:150 dialog/vcwalace.msg:208
#: dialog/vcwalace.msg:248 dialog/vicencom.msg:170 dialog/vicencom.msg:180
#: dialog/vicencom.msg:183 dialog/vicencom.msg:186
msgid "Shamble off"
msgstr "Odbelhat se."

#: dialog/ecdogmet.msg:123
msgid "I'll come back and get you when I have some room in my party."
msgstr "Přijdu si pro tebe až budu mít víc místa v partě."

#: dialog/ecdogmet.msg:124 dialog/ecdogmet.msg:130
msgid "Stick close to me. All right, boy?"
msgstr "Drž se při mně. Jasný, hochu?"

#: dialog/ecdogmet.msg:125 dialog/ecdogmet.msg:131
msgid "Keep a medium distance, Dogmeat."
msgstr "Drž se v přiměřené vzdálenosti, Dogmeate."

#: dialog/ecdogmet.msg:126 dialog/ecdogmet.msg:132
msgid "Stay far away from me, Dogmeat. Watch my back."
msgstr "Zůstaň daleko ode mne, Dogmeate. Hlídej mi záda."

#: dialog/ecdogmet.msg:127 dialog/ecdogmet.msg:133
msgid "Stay, Dogmeat. Stay!"
msgstr "Zůstaň, Dogmeate. Zůstaň!"

#: dialog/ecdogmet.msg:128
msgid "I think I'll just leave Dogmeat alone."
msgstr "Myslím, že nechám Dogmeata na pokoji."

#: dialog/ecdogmet.msg:129
msgid "Dogmeat gives a sharp bark, then a low growl."
msgstr "Dogmeat ostře vyštěkne a slabě zavrčí."

#: dialog/ecdogmet.msg:134
msgid "Thanks, Dogmeat. You kick ass."
msgstr "Díky, Dogmeate. Jsi hustej."

#: dialog/ecdogmet.msg:135 dialog/ecdogmet.msg:136
msgid "Awooooooooooo"
msgstr "Hauuuuuuuuuuu"

#: dialog/ecdogmet.msg:137
msgid "Ey'e mate, you screwen with me dog."
msgstr "Hej, kámo, obtěžuješ mýho psa."

#: dialog/ecdogmet.msg:138
msgid "Grrrrr...."
msgstr "Grrrrr..."

#: dialog/ecdogmet.msg:139
msgid "(I wonder if I can get Dogmeat to follow me differently?)"
msgstr "(Zajímalo by mě, jestli dokážu přimět Dogmeata, aby mě následoval jiným způsobem.)"

#: dialog/ecdogmet.msg:150 dialog/generic.msg:905 dialog/mcladdie.msg:151
#: dialog/slvcc3.msg:103 game/misc.msg:9064
msgid "Woof! Woof!"
msgstr "HAF! HAF!"

#: dialog/ecdogmet.msg:200
msgid "Here boy, I got something for you! Let's see somebody mess with you now! (You place the K-9 Kevlar on Dogmeat.)"
msgstr "Podívej co pro tebe mám, hochu! A teď si na tebe může někdo něco zkusit! (Oblečeš K-9 Kevlar na Dogmeata.)"

#: dialog/ecdogmet.msg:201
msgid "Is the armor weighting you down, boy? Here, let's take that thing off. (You remove the K-9 Kevlar from Dogmeat.) "
msgstr "Není ta zbroj na tebe moc těžká, hochu? Ukaž, sundám ti ji. (Sundáš K-9 Kevlar z Dogmeata.)"

#: dialog/ecdogmet.msg:300
msgid "*Wimper*"
msgstr "*kňučení*"

#: dialog/ecdogmet.msg:301
msgid "Awooooooooooo! *wimper*"
msgstr "Hauuuuuuuuuuu! *kňučení*"

#: dialog/ecdogmet.msg:1110
msgid "The dog greedily swallows the contents of the can of dog food, then looks at you expectantly."
msgstr "Pes hladově spolyká obsah plechovky psího žrádla a pak se na tebe s očekáváním zadívá."

#: dialog/ecelron.msg:100 dialog/hcguard.msg:110
msgid "You see a Hubologist."
msgstr "Vidíš Hubologistu."

#: dialog/ecelron.msg:101
msgid "Do you think you can escape the wrathful eye of the Hub?"
msgstr "Myslíš si, že můžeš uniknout rozhněvaným očím Hubu?"

#: dialog/ecelron.msg:102
msgid "You are raw meat. You are recruits. Pray you do not become enemies."
msgstr "Jste špinavci. Jste rekruti. Modlete se, aby se z vás nestali nepřátelé."

#: dialog/ecelron.msg:103
msgid "Perhaps you would like to join the Hubologists?"
msgstr "Nechceš se přidat k Hubologistům?"

#: dialog/ecelron.msg:104
msgid "Walk carefully here. We have Shi in the town. Harm nothing in our city."
msgstr "Pohybuj se opatrně. Shi jsou ve městě. Ničemu a nikomu ve městě neubližuj."

#: dialog/ecelron.msg:105
msgid "Perhaps you will be permitted to gaze upon our project."
msgstr "Možná tě necháme nahlédnout do našeho projektu."

#: dialog/ecelvpat.msg:100
msgid "You see an Enclave Patrolman."
msgstr "Vidíš člena Enklávské patroly."

#: dialog/ecelvpat.msg:200
msgid ""
"You're an illegal alien on Enclave territory. Proposition 312 orders us to shoot on sight.\n"
" Sorry, boy!"
msgstr "Jsi neoprávněně na území Enklávy. Podle vyhlášky číslo 312 máme nařízeno střílet bez výstrahy. Promiň, kámo!"

#: dialog/ecelvpat.msg:201
msgid "He's a mutant spy! Take him out, team!"
msgstr "To je špión mutantů! Sundejte ho!"

#: dialog/ecelvpat.msg:202 dialog/ecelvpat.msg:303
msgid "As a loyal soldier of the Enclave, I got orders to kill you. Hope you don't mind."
msgstr "Jako oddaný voják Enklávy jsem dostal rozkaz tě zastřelit. Doufám, že ti to nevadí."

#: dialog/ecelvpat.msg:203
msgid "Base we got an intruder, sector 3; awaiting orders... Kill him? Roger that base."
msgstr "Základno, v sektoru 3 máme narušitele. Čekám na další rozkazy... zabít? Rozumím, základno."

#: dialog/ecelvpat.msg:204
msgid ""
"Now I suppose you're going to tell me you're just out looking for a water chip. Do I look dumb?\n"
" Get him!"
msgstr "Teď mi určitě budeš chtít tvrdit, že tady jenom hledáš vodní čip. Myslíš, že jsem blbej? Dostaňte ho!"

#: dialog/ecelvpat.msg:205
msgid "Die, wasteland scum!"
msgstr "Chcípni, špíno z pustiny!"

#: dialog/ecelvpat.msg:206 dialog/ecelvpat.msg:304
msgid "You! It's your kind that destroyed this once mighty nation. You're gonna pay!"
msgstr "Ty! Tobě podobní zničili náš kdysi mocný národ. Za to zaplatíš!"

#: dialog/ecelvpat.msg:207
msgid "Hey, Louie! You ever seen what one of these babies does to soft tissue? Watch!"
msgstr "Hej, Louie! Už jsi viděl, co dokážou tyhle hračičky? Tak sleduj!"

#: dialog/ecelvpat.msg:300
msgid "Geez, I hate having to kill a woman. Let's make this quick, okay?"
msgstr "Ježíš, nesnáším, když musím zabít ženskou. Uděláme to rychle, jo?"

#: dialog/ecelvpat.msg:301
msgid "Alarm! Alarm!"
msgstr "Poplach! Poplach!"

#: dialog/ecelvpat.msg:302
msgid "Looks like you come a long way for nothing, lady. "
msgstr "Zdá se, že jsi urazila takovou dálku pro nic za nic, dámo."

#: dialog/ecelvpat.msg:305
msgid "Don't worry, it's only some wasteland bimbo. She won't put up much of a fight."
msgstr "Neboj. Je to jenom nějaká ženská z pustiny. Ta se nezmůže na nějakej větší odpor."

#: dialog/ecelvpat.msg:306
msgid "It's a shame we couldn't have met under different circumstances."
msgstr "Škoda, že jsme se nemohli setkat za jiných okolností."

#: dialog/ecelvpat.msg:307
msgid "Don't talk to me! You'll not corrupt me with your feminine temptations! Die!"
msgstr "Nemluv na mě. Já nepodlehnu tvým ženským svodům. Zemři!"

#: dialog/eceric.msg:101
msgid "This is Eric."
msgstr "To je Eric."

#: dialog/ecfarmer.msg:100 dialog/echomest.msg:100
msgid "You see a lean, tan looking man."
msgstr "Vidíš štíhlého, opáleného muže."

#: dialog/ecfarmer.msg:101 dialog/ecfarmer.msg:201 dialog/echomest.msg:101
#: dialog/echomwfe.msg:101
msgid "You see a farmer."
msgstr "Vidíš farmářku."

#: dialog/ecfarmer.msg:102 dialog/echomest.msg:102
msgid "You notice he has a farmer's tan."
msgstr "Všimneš si, že je opálený jako farmář."

#: dialog/ecfarmer.msg:103 dialog/echomest.msg:103
msgid ""
"You arrived just in the nick of time. If you hadn't gotten here when you did... Well, let's just\n"
" be thankful that you came when you did. We don't have much, but I'd like you to accept this as a\n"
" reward for helping us. [He hands you something.]"
msgstr "Přišel jsi v pravou chvíli. Kdyby nebylo tebe... no, řekněme, že jsme vděční za to, že jsi přišel včas. Moc toho nemáme, ale přijmi toto prosím jako odměnu za tvou pomoc. (Něco ti podá.)"

#: dialog/ecfarmer.msg:105 dialog/ecfshrmn.msg:109 dialog/echomest.msg:105
#: dialog/wcbrnbot.msg:133 dialog/wsterm3a.msg:117 dialog/wsterm3c.msg:112
msgid "Ug"
msgstr "Eh..."

#: dialog/ecfarmer.msg:106 dialog/echomest.msg:106
msgid "Thanks again for helping us."
msgstr "Ještě jednou děkujeme za pomoc."

#: dialog/ecfarmer.msg:109
msgid ""
"You just keep your hands where I can see them. We've been plagued by bandits lately and I think\n"
" you just might be one of them. What do you want?"
msgstr "Drž ty ruce tak, aby na ně bylo vidět. V poslední době nás obtěžuje hodně banditů a ty vypadáš jako oni. Co chceš?"

#: dialog/ecfarmer.msg:110 dialog/echomest.msg:110
msgid "I just wanted to trade for supplies."
msgstr "Chci jenom vyměnit nějaké zásoby."

#: dialog/ecfarmer.msg:111 dialog/echomest.msg:111
msgid "I'm just passing through. I'll be on my way."
msgstr "Jenom tudy procházím. Brzy odejdu."

#: dialog/ecfarmer.msg:113 dialog/echomest.msg:113
msgid "Well, I guess there's no harm in that. Here's what I got to trade."
msgstr "No, myslím, že z toho žádné nebezpečí nehrozí. Tady je moje nabídka."

#: dialog/ecfarmer.msg:115 dialog/echomest.msg:115
msgid "OK, now git!"
msgstr "Dobře, tak vypadni!"

#: dialog/ecfarmer.msg:117 dialog/echomest.msg:117
msgid "I said git!"
msgstr "Řekl jsem běž!"

#: dialog/ecfarmer.msg:119 dialog/echomest.msg:119
msgid "[He relaxes a bit.] You're too stupid to be a bandit. Do you need supplies?"
msgstr "(Trochu se uklidní.) Na banditu jsi příliš velký hlupák. Potřebuješ zásoby?"

#: dialog/ecfarmer.msg:121 dialog/echomest.msg:121
msgid "Eh eh."
msgstr "Eh eh."

#: dialog/ecfarmer.msg:122 dialog/echomest.msg:122
msgid "Well then, we got no business. You just keep moving, then."
msgstr "V tom případě není důvod, proč bysme se spolu měli dál bavit. Jdi si po svých."

#: dialog/ecfarmer.msg:124 dialog/echomest.msg:124
msgid "Leave my farm!"
msgstr "Odejděte z mojí farmy!"

#: dialog/ecfarmer.msg:125 dialog/echomest.msg:125
msgid "Nobody is going to take my home from me."
msgstr "Nikdo mi můj domov nevezme."

#: dialog/ecfarmer.msg:126 dialog/echomest.msg:126
msgid "Filthy bandits."
msgstr "Proradní banditi."

#: dialog/ecfarmer.msg:127 dialog/echomest.msg:127
msgid "Get off my land."
msgstr "Zmizte z mé půdy."

#: dialog/ecfarmer.msg:128 dialog/echomest.msg:128 dialog/ectravlr.msg:145
msgid "Can't trust anyone these days."
msgstr "Dneska už nemůžeš věřit nikomu."

#: dialog/ecfarmer.msg:129 dialog/ecfrmwfe.msg:101 dialog/echomest.msg:129
#: dialog/echomwfe.msg:201
msgid "Damn bandits."
msgstr "Zatracení banditi."

#: dialog/ecfarmer.msg:130 dialog/echomest.msg:130
msgid "I've worked too hard to give up now."
msgstr "Pracoval jsem příliš tvrdě na to, abych to teď vzdal."

#: dialog/ecfarmer.msg:131 dialog/echomest.msg:131
msgid "Maybe I'll farm elsewhere."
msgstr "Možná půjdu farmařit jinam."

#: dialog/ecfarmer.msg:132 dialog/echomest.msg:132
msgid "I'm just a poor farmer."
msgstr "Jsem jen chudý farmář."

#: dialog/ecfarmer.msg:133 dialog/echomest.msg:133
msgid "Please, don't burn my farm down."
msgstr "Prosím, nevypaluj moji farmu."

#: dialog/ecfarmer.msg:134 dialog/echomest.msg:134
msgid "I didn't like farming anyway."
msgstr "Stejně jsem farmaření nesnášel."

#: dialog/ecfarmer.msg:136 dialog/echomest.msg:136
msgid "Take my wife - please..."
msgstr "Vezměte si moji ženu... prosím..."

#: dialog/ecfarmer.msg:200
msgid "You see a lean, tanned woman."
msgstr "Vidíš štíhlou opálenou ženu."

#: dialog/ecfarmer.msg:202 dialog/echomwfe.msg:102
msgid "You notice she has a farmer's tan."
msgstr "Vypadá jako farmářka."

#: dialog/ecfrmkid.msg:100 dialog/echomkid.msg:100
msgid "Plbbt. Can't get me."
msgstr "Hehe. Mě nedostaneš."

#: dialog/ecfrmkid.msg:101 dialog/echomkid.msg:101
msgid "My pa's gonna whip you."
msgstr "Táta tě zbičuje."

#: dialog/ecfrmkid.msg:102 dialog/echomkid.msg:102
msgid "Take this."
msgstr "Dostaneš."

#: dialog/ecfrmkid.msg:103 dialog/echermit.msg:123 dialog/echomkid.msg:103
#: dialog/ecoutcst.msg:106 dialog/mcgrisha.msg:153
msgid "Go away!"
msgstr "Jdi pryč!"

#: dialog/ecfrmkid.msg:104 dialog/echomkid.msg:104
msgid "Pblbbt!"
msgstr "Héhé!"

#: dialog/ecfrmkid.msg:105 dialog/echomkid.msg:105
msgid "Whaaa!"
msgstr "Áááá!"

#: dialog/ecfrmkid.msg:107 dialog/echomkid.msg:107 dialog/mcmiria.msg:400
msgid "Daddy!"
msgstr "Tatínku!"

#: dialog/ecfrmkid.msg:200 dialog/echomkid.msg:200
msgid "You see a young child."
msgstr "Vidíš malé dítě."

#: dialog/ecfrmkid.msg:201 dialog/echomkid.msg:201
msgid "It's a little boy."
msgstr "Je to malý chlapec."

#: dialog/ecfrmkid.msg:202 dialog/echomkid.msg:202
msgid "It's a little girl."
msgstr "Je to holčička."

#: dialog/ecfrmwfe.msg:100 dialog/echomwfe.msg:200
msgid "This is my house."
msgstr "To je můj dům."

#: dialog/ecfrmwfe.msg:102 dialog/echomwfe.msg:202
msgid "Leave us alone!"
msgstr "Nech nás na pokoji!"

#: dialog/ecfrmwfe.msg:103 dialog/echomwfe.msg:203
msgid "I hate bandits."
msgstr "Nenávidím bandity."

#: dialog/ecfrmwfe.msg:104 dialog/echomwfe.msg:204
msgid "We have nothing for you to steal."
msgstr "Nemáme nic cenného."

#: dialog/ecfrmwfe.msg:105 dialog/echomwfe.msg:205
msgid "Don't kill me."
msgstr "Nezabíjej mě."

#: dialog/ecfrmwfe.msg:106 dialog/echomwfe.msg:206
msgid "I've had enough."
msgstr "Už toho mám dost."

#: dialog/ecfrmwfe.msg:107 dialog/echomwfe.msg:207
msgid "Take what you want."
msgstr "Vezmi si co chceš."

#: dialog/ecfrmwfe.msg:108 dialog/echomwfe.msg:208
msgid "Please, don't kill me."
msgstr "Prosím, nezabíjej mě."

#: dialog/ecfrmwfe.msg:109 dialog/echomwfe.msg:209
msgid "I hated farming anyway."
msgstr "Stejně nenávidím farmaření."

#: dialog/ecfrmwfe.msg:110
msgid "Please don't burn the house down."
msgstr "Prosím, nevypaluj mi můj dům."

#: dialog/ecfshrmn.msg:100
msgid "You see a Fisherman."
msgstr "Vidíš rybáře."

#: dialog/ecfshrmn.msg:101
msgid "You are just in time to witness the blessings of the Goddess of the Sea."
msgstr "Přišel jsi právě včas, aby ses stal svědkem požehnání Bohyně moře."

#: dialog/ecfshrmn.msg:104
msgid ""
"Just before a big storm we hurl spears into the sea to show our bravery against the elements.\n"
" If we have proven ourselves worthy, the Goddess rewards us with fruit."
msgstr "Těsně před velkou bouří vrhneme své kopí do moře, abychom prokázali svou odvahu proti živlům. Pokud prokážeme, že jsme toho hodni, Bohyně nás odmění plody."

#: dialog/ecfshrmn.msg:105
msgid ""
"When the season of storms begins, we throw Broc flowers out on the sea with the tide. After\n"
" the Goddess works her magic, she returns the Broc flowers as the rare Xander root. "
msgstr "Když začne období bouří, házíme do moře květiny Broc během přílivu. Bohyně je svými kouzly přemění na vzácný kořen Xander."

#: dialog/ecfshrmn.msg:106
msgid ""
"We offer tribute to the Goddess of the Sea each year in the form of Xander root. If the\n"
" Goddess deems us worthy, she will turn the Xander root into Broc flowers. "
msgstr "Každý rok vzdáváme hold Bohyni moře kořenem Xander. Pokud bohyně usoudí, že jsme toho hodni, promění kořen Xander na květinu Broc. "

#: dialog/ecfshrmn.msg:107
msgid ""
"After a bountiful harvest, we give tribute to the Goddess of the Sea that she might watch over\n"
" and protect us.  Every year she has rewarded our piety by sending spears on the tide as sign that she\n"
" is watching over us."
msgstr "Po vydatné sklizni vzdáváme hold Bohyni moře, aby nás ochraňovala a opatrovala. Každý rok odměňuje naši poslušnost tak, že nám s přílivem pošle kopí jako znamení, že na nás dohlíží."

#: dialog/ecfshrmn.msg:108
msgid "May I see what the Goddess has bestowed upon you?"
msgstr "Můžu vidět, co vám bohyně věnovala?"

#: dialog/ecfshrmn.msg:110
msgid ""
"Here is what the great Goddess has given us this year. We will gladly share her blessings with\n"
" you, for a price."
msgstr "Zde je to, co nám velká bohyně seslala tento rok. Rádi se s tebou o její požehnané dary rozdělíme... za peníze."

#: dialog/ecfshrmn.msg:111
msgid "Junk [$10]"
msgstr "Haraburdí [$10]"

#: dialog/ecfshrmn.msg:112
msgid "Laser Pistol [$10000]"
msgstr "Laserová pistole [$10000]"

#: dialog/ecfshrmn.msg:113
msgid "Sharpened sticks [$40]"
msgstr "Naostřené tyče [$40]"

#: dialog/ecfshrmn.msg:114
msgid "Fruit [$5]"
msgstr "Ovoce [$5]"

#: dialog/ecfshrmn.msg:115
msgid "Xander [$20]"
msgstr "Kořen Xander [$20]"

#: dialog/ecfshrmn.msg:116
msgid "Broc [$10]"
msgstr "Květina Broc [$10]"

#: dialog/ecfshrmn.msg:118
msgid ""
"[He points you in the direction of the sea.] Just keep walking. The Goddess wishes to meet you\n"
" personally."
msgstr "(Ukáže směrem na moře.) Pokračuj dál. Bohyně si přeje s tebou setkat osobně."

#: dialog/ecfshrmn.msg:119 dialog/ecfshrmn.msg:121 dialog/ecfshrmn.msg:123
#: dialog/ecprospe.msg:108 dialog/ecravpty.msg:110 dialog/ecravpty.msg:112
#: dialog/ecravpty.msg:114 dialog/ecravpty.msg:116 dialog/ecravpty.msg:118
#: dialog/ecravpty.msg:129 dialog/ecravpty.msg:131 dialog/ectrader.msg:117
#: dialog/ectrader.msg:119
msgid "[End]"
msgstr "[Konec]"

#: dialog/ecfshrmn.msg:120
msgid "May the blessing of the Goddess of the Sea go with you."
msgstr "Nechť tě provází požehnání Bohyně moře."

#: dialog/ecfshrmn.msg:122
msgid "[He frowns as you fail to produce the required sum of money.] Perhaps another time, then."
msgstr "(Zamračí se na tebe, protože nemáš dostatek peněz.) Snad někdy jindy."

#: dialog/ecgalaha.msg:101
msgid "This is Sir Galahad."
msgstr "Tohle je Sir Galahad."

#: dialog/ecgalaha.msg:102
msgid "He blushes when he notices you staring at him."
msgstr "Červená se, když zjistí, že na něj civíš."

#: dialog/ecgalaha.msg:103
msgid "Sir Galahad, at the ready!"
msgstr "Sir Galahad, k tvým službám!"

#: dialog/ecgalaha.msg:104
msgid "I once was a prisoner of Castle Anthrax."
msgstr "Kdysi jsem byl vězněm v zámku Anthrax."

#: dialog/ecgalaha.msg:105
msgid "Sir Lancelot rescued me. Damn him!"
msgstr "Sir Lancelot mě zachránil. K čertu s ním!"

#: dialog/ecgalaha.msg:106
msgid "I could have been a prisoner. [Sniff]"
msgstr "Mohl jsem být vězněm. *popotáhne nosem*"

#: dialog/ecgangs.msg:100
msgid "Get off our turf!"
msgstr "Zmiz z našeho revíru!"

#: dialog/ecgangs.msg:101
msgid "You're on the wrong side of the tracks, fella."
msgstr "Jseš na špatný straně, kámo."

#: dialog/ecgangs.msg:102
msgid "This is gonna hurt."
msgstr "Tohle tě bude bolet."

#: dialog/ecgangs.msg:103
msgid "Whatcha' doing in my hood?"
msgstr "Co děláš na mým území?"

#: dialog/ecgangs.msg:104
msgid "You ever had a knuckle sandwich?"
msgstr "Už jsi někdy dostal nakládačku?"

#: dialog/ecgangs.msg:105
msgid "Scram!"
msgstr "Táhni!"

#: dialog/ecgangs.msg:106
msgid "You'll regret this!"
msgstr "Tohle tě bude mrzet!"

#: dialog/ecgangs.msg:107
msgid "Tough cookie!"
msgstr "Tvrdý oříšek!"

#: dialog/ecgangs.msg:108 dialog/ecscaven.msg:106
msgid "Next time."
msgstr "Příště."

#: dialog/ecgrdtrm.msg:100
msgid "You see a terminal with a functioning water chip."
msgstr "Vidíš terminál s funkčním vodním čipem."

#: dialog/ecgrdtrm.msg:101
msgid "You see a terminal with a malfunctioning water chip."
msgstr "Vidíš terminál s nefunkčním vodním čipem."

#: dialog/ecgrdtrm.msg:102
msgid ""
"You have broken the water chip... it might be anywhere from 100 to 150 days before this\n"
" Vault runs out of water. For some reason, this thought comforts you."
msgstr "Rozbil jsi vodní čip... Vault vydrží bez vody asi 100 až 150 dní. To tě do určité míry uklidňuje."

#: dialog/ecgrdtrm.msg:103
msgid "Whoops."
msgstr "Jejda."

#: dialog/ecgrdtrm.msg:104 dialog/vimedcom.msg:203 dialog/vimedcom.msg:207
#: dialog/viterm.msg:102
msgid "*Beep*"
msgstr "*Píp*"

#: dialog/ecgrdtrm.msg:105 dialog/vimedcom.msg:206
msgid "*Bee-Oop*"
msgstr "*Pí... Oop*"

#: dialog/ecgrdtrm.msg:106
msgid "*Beep* *Bee-Oop*"
msgstr "*Píp* *Pí... Oop*"

#: dialog/ecgrunde.msg:100
msgid "Here mousy, mousy."
msgstr "Myšičko myš, pojď ke mně blíž."

#: dialog/ecgrunde.msg:101
msgid "Grundel need you to make stew."
msgstr "Grundel tě potřebuje na pečínku."

#: dialog/ecgrunde.msg:102
msgid "Come here, wittle mousy."
msgstr "Pojď sem, myško."

#: dialog/ecgrunde.msg:103
msgid "Kind Grundel no hurt you."
msgstr "Hodný Grundel ty neublížit."

#: dialog/ecgrunde.msg:104
msgid "Tasty little ones."
msgstr "Maličké, chutňoučké."

#: dialog/ecgrunde.msg:105
msgid "Come on, mousy. Me hungry."
msgstr "Pojď, pojď, myšičko. Já mít hlad."

#: dialog/ecgrunde.msg:106
msgid "Squeek, Squeeeek. SQUEEEEK!"
msgstr "Písk, písk. PÍÍÍÍSK!"

#: dialog/ecgrunde.msg:107
msgid "OK, OK, me lied, me gonna to eat you."
msgstr "Dobrá, dobrá, já lhát. Já ty teď sníst."

#: dialog/ecgrunde.msg:110
msgid "Oooh! You a big mousy. Make good dinner for Grundel."
msgstr "Óóó! Ty velká myška. Být dobrá večeře pro Grundela."

#: dialog/ecguard.msg:100
msgid "You see a scarred traveler."
msgstr "Vidíš vyděšeného pocestného."

#: dialog/ecguard.msg:101
msgid "You see the merchant's guard."
msgstr "Vidíš obchodníkova strážce."

#: dialog/ecguard.msg:200
msgid "No drawn weapons near the boss."
msgstr "Žádné zbraně v blízkosti šéfa."

#: dialog/ecguard.msg:201
msgid "No one comes to the boss armed."
msgstr "Nikdo nesmí k šéfovi ozbrojen."

#: dialog/ecguard.msg:202
msgid "Put your weapon away before we shoot you."
msgstr "Odlož tu zbraň, než to do tebe napálím."

#: dialog/ecguard.msg:203
msgid "Put 'em away or get away."
msgstr "Odlož ty zbraně, nebo vypadni."

#: dialog/ecguard.msg:250
msgid "You were warned -- now you will pay."
msgstr "Varoval jsem tě... teď zaplatíš."

#: dialog/ecguard.msg:300
msgid "Talk to the boss, 'e'll set you up right."
msgstr "Promluv si se šéfem, ten ti pomůže."

#: dialog/ecguard.msg:301
msgid "I take my job seriously. Mess with the boss, and you die."
msgstr "Beru svou práci vážně. Začni si něco s mým šéfem a je po tobě."

#: dialog/ecguard.msg:302
msgid "The boss is a good guy for the most part."
msgstr "Většinou se s mým šéfem dá vyjít."

#: dialog/ecguard.msg:303
msgid "Don't even think of stealing from the boss."
msgstr "Neopovaž se něco šéfovi ukrást."

#: dialog/echermit.msg:100 dialog/echermit.msg:101
msgid "You see a hermit."
msgstr "Vidíš poustevníka."

#: dialog/echermit.msg:102
msgid "It looks as if he hasn't washed in years."
msgstr "Vypadá to, že už se léta nemyl."

#: dialog/echermit.msg:103
msgid "Can guess you why I hermit? [It seems he hasn't spoken to anyone in years.]"
msgstr "Chceš vědět proč já poustevník? (Zdá se, že už léta s nikým nepromluvil.)"

#: dialog/echermit.msg:105 dialog/ectrappr.msg:105
msgid "Just passing through."
msgstr "Jenom tudy procházím."

#: dialog/echermit.msg:107
msgid "Me want left alone."
msgstr "Já chtít být nechat na pokoji."

#: dialog/echermit.msg:108
msgid "Since I'm here, maybe we can barter. I'm sure I have something you might want."
msgstr "Když už jsem tady, mohli bychom udělat nějaký obchod. Určitě mám něco, co bys mohl potřebovat."

#: dialog/echermit.msg:109
msgid "I'll leave you alone then."
msgstr "V tom případě tě nechám na pokoji."

#: dialog/echermit.msg:110
msgid "Trade. Then leave you will."
msgstr "Obchodovat. Pak odejít ty muset."

#: dialog/echermit.msg:111
msgid "OK, here's what I have to trade."
msgstr "Dobře, tady je moje nabídka."

#: dialog/echermit.msg:112
msgid "I best leave."
msgstr "Raději půjdu."

#: dialog/echermit.msg:113
msgid "Leave now."
msgstr "Odejít."

#: dialog/echermit.msg:115
msgid "Hmm... I like you. No ear talk off. Stay, trade me and you."
msgstr "Hmm... líbíš se. Nechtít mluvit. Zůstaň a obchoduj ty a já."

#: dialog/echermit.msg:116
msgid "K'"
msgstr "Dobře."

#: dialog/echermit.msg:118
msgid "Nice talk. Go now. Tired am I."
msgstr "Dobrá řeč. Teď jít. Já unavený jsem."

#: dialog/echermit.msg:120
msgid "Talk give pain in head. Go."
msgstr "Řeč dělá bolest hlavy. Jít."

#: dialog/echermit.msg:121
msgid "Done me talk to you."
msgstr "Skončil já řeč s tebou."

#: dialog/echermit.msg:122
msgid "No talk. Go."
msgstr "Neříkat nic. Jít."

#: dialog/echermit.msg:124
msgid "Leave home!"
msgstr "Ty domů jít!"

#: dialog/echermit.msg:125
msgid "How you dare me attack!"
msgstr "Jak odvážit útok na mě!"

#: dialog/echermit.msg:126
msgid "Leave alone me."
msgstr "Nech na pokoji mě."

#: dialog/echlyppl.msg:100
msgid "How dare you interrupt my meditation!"
msgstr "Jak se opovažuješ mě vyrušit při meditaci!"

#: dialog/echlyppl.msg:101
msgid "Spirits of the land, attack!"
msgstr "Duchové země, do útoku!"

#: dialog/echlyppl.msg:102
msgid "Great Spirit, protect me."
msgstr "Velký duchu, ochraňuj mě."

#: dialog/echlyppl.msg:103
msgid "My bones nourish the earth... many years from now."
msgstr "Moje kosti poskytnou zemi živiny... za mnoho let."

#: dialog/echlyppl.msg:104
msgid "Screw the spirits; I'm outta here."
msgstr "Do hajzlu s duchy. Padám odsud."

#: dialog/echlyppl.msg:105
msgid "You see a holy man."
msgstr "Vidíš svatého muže."

#: dialog/echomest.msg:109
msgid ""
"You just keep your hands where I can see them. We've been plagued by bandits lately, and I\n"
" think you just might be one of them. What do you want?"
msgstr "Drž ty ruce tak, aby na ně bylo vidět. V poslední době nás obtěžuje hodně banditů a ty vypadáš jako oni. Co chceš?"

#: dialog/echomest.msg:200
msgid "Thanks fer your help."
msgstr "Děkuju ti za pomoc."

#: dialog/echomest.msg:201
msgid "Bout time some order was brought to these here lands."
msgstr "Bylo na čase, aby už v těchto končinách zavládla spravedlnost."

#: dialog/echomles.msg:100 dialog/echomles.msg:105
msgid "Food!"
msgstr "Jídlo!"

#: dialog/echomles.msg:101
msgid "Give us food!"
msgstr "Dej nám jídlo!"

#: dialog/echomles.msg:102
msgid "We're hungry!"
msgstr "Máme hlad!"

#: dialog/echomles.msg:103
msgid "Some money for those less fortunate."
msgstr "Nemáš nějaké peníze pro ty méně šťastné?"

#: dialog/echomles.msg:107
msgid "My children are starving."
msgstr "Moje děti hladoví."

#: dialog/echomles.msg:108
msgid "Nobody cares about us."
msgstr "Nikoho nezajímáme."

#: dialog/echomles.msg:109 game/combatai.msg:2009
msgid "Don't kill me!"
msgstr "Nezabíjej mě!"

#: dialog/echomles.msg:110
msgid "I just wanted some food."
msgstr "Chtěl jsem jenom něco k jídlu."

#: dialog/echomles.msg:111
msgid "Forgive me."
msgstr "Odpusť mi."

#: dialog/echomles.msg:112
msgid "The beggar takes the item."
msgstr "Žebrák bere předmět."

#: dialog/echomwfe.msg:100
msgid "You see a lean, tan looking woman."
msgstr "Vidíš hubenou, snědou ženu."

#: dialog/echomwfe.msg:210
msgid "Please, don't burn the house down."
msgstr "Prosím, nevypaluj mi můj dům."

#: dialog/echomwfe.msg:220 dialog/hcfemale.msg:209 dialog/hcmale.msg:209
#: dialog/rcmodjes.msg:104 dialog/scmrkgrd.msg:108 dialog/vcconnar.msg:500
msgid "Don't bother me."
msgstr "Neobtěžuj mě."

#: dialog/echomwfe.msg:230 dialog/mcslag.msg:301 dialog/tribec3.msg:207
#: dialog/tribec8.msg:207
msgid "Thank you for helping us."
msgstr "Děkuji za pomoc."

#: dialog/echomwfe.msg:231
msgid "I wish there were more people like you in this world."
msgstr "Kéž by na světě bylo více takových jako ty."

#: dialog/echunter.msg:100
msgid "You see a hunter."
msgstr "Vidíš lovce."

#: dialog/echunter.msg:101
msgid "You are welcome here, Chosen One."
msgstr "Jsi tady vítán, Vyvolený."

#: dialog/echunter.msg:102
msgid "Have you found the holy GECK?"
msgstr "Už se ti podařilo najít svatý GECK?"

#: dialog/echunter.msg:103
msgid "Return with the GECK soon."
msgstr "Vrať se brzy i s GECKem."

#: dialog/echunter.msg:104
msgid "May your travels be without pain."
msgstr "Ať jsou tvé cesty bez bolesti."

#: dialog/echunter.msg:105
msgid "Return to us that which is owed."
msgstr "Vrať nám to, co je nám dluženo."

#: dialog/echunter.msg:106
msgid "You must hurry, Chosen One."
msgstr "Musíš si pospíšit, Vyvolený."

#: dialog/echunter.msg:107
msgid "Our prayers are with you, Chosen One."
msgstr "Naše modlitby jsou s tebou, Vyvolený."

#: dialog/ecirrad.msg:100
msgid "You receive a dose of radiation."
msgstr "Dostal jsi dávku radiace."

#: dialog/ecjohn.msg:101
msgid "This is John."
msgstr "To je John."

#: dialog/ecjoshua.msg:100
msgid "You see a man strumming a lute."
msgstr "Vidíš muže, který brnká na loutnu."

#: dialog/ecjoshua.msg:101
msgid "This is Joshua."
msgstr "To je Joshua."

#: dialog/ecjoshua.msg:102
msgid "He is a traveling minstrel."
msgstr "Je to potulného barda."

#: dialog/ecjoshua.msg:103
msgid "Brave Sir Robin ran away..."
msgstr "Hrdinný Sir Robin utekl..."

#: dialog/ecjoshua.msg:104
msgid "Bravely ran away, away..."
msgstr "Hrdinně z boje utekl..."

#: dialog/ecjoshua.msg:105
msgid "When danger reared its ugly head, he bravely turned his tail and fled..."
msgstr "Když nebezpečí ukázalo svoji hnusnou tvář, hrdinně stáhl ocas mezi nohy a utekl..."

#: dialog/ecjoshua.msg:106
msgid "Yes, Brave Sir Robin turned about..."
msgstr "Ano, je to tak. Hrdina Sir Robin se otočil..."

#: dialog/ecjoshua.msg:107
msgid "And gallantly he chickened out. Bravely taking to his feet..."
msgstr "A galantně se vypařil. Hrdinně práskl do bot..."

#: dialog/ecjoshua.msg:108
msgid "He beat a very brave retreat..."
msgstr "Hrdinně troubil na ústup..."

#: dialog/ecjoshua.msg:109
msgid "Oh, Brave Sir Robin."
msgstr "Ó, Hrdinný Sir Robin."

#: dialog/eckaga1.msg:100
msgid "You see a man wearing minimal clothing."
msgstr "Vidíš polonahého muže."

#: dialog/eckaga1.msg:101 dialog/eckaga2.msg:101 dialog/eckaga3.msg:101
msgid "You see Kaga."
msgstr "Vidíš Kagu v kovové zbroji."

#: dialog/eckaga1.msg:103
msgid "He is wearing pants and looks like he came from a tribe."
msgstr "Má na sobě kalhoty a vypadá, jako by pocházel z nějakého kmene."

#: dialog/eckaga1.msg:104 game/cmbatai2.msg:36120 game/combatai.msg:36120
msgid "I should have been the Chosen One!"
msgstr "Já jsem měl být Vyvoleným!"

#: dialog/eckaga1.msg:105
msgid "How dare Arroyo cast me out of the tribe."
msgstr "Jak se mohlo Arroyo opovážit vyhnat mě z kmene."

#: dialog/eckaga1.msg:106
msgid "I will have my revenge on you!"
msgstr "Vykonám na tobě svou pomstu!"

#: dialog/eckaga1.msg:107
msgid "Kaga will send you to the next life."
msgstr "Kaga tě pošle na onen svět."

#: dialog/eckaga1.msg:108 dialog/eckaga4.msg:108 game/cmbatai2.msg:36100
#: game/cmbatai2.msg:36200 game/combatai.msg:36100 game/combatai.msg:36200
msgid "We will meet again!"
msgstr "Ještě se uvidíme!"

#: dialog/eckaga1.msg:109 game/cmbatai2.msg:36102 game/combatai.msg:36102
msgid "I have never been beaten before!"
msgstr "Ještě nikdy jsem nebyl poražen!"

#: dialog/eckaga1.msg:110
msgid "I will dedicate myself to your destruction."
msgstr "Udělám vše pro to, abych tě zničil."

#: dialog/eckaga1.msg:150 dialog/eckaga2.msg:150 dialog/eckaga3.msg:150
#: dialog/eckaga4.msg:150 dialog/eckaga5.msg:150
msgid "[A tall and powerfully built warrior stands before you, his eyes blaze with hatred as he looks you over.] So, they cast out Kaga, then deem YOU the Chosen One? Ha! You think being the grandchild of the Vault Dweller makes you special?! You think you are better than I, Kaga the Great?!"
msgstr "(Před tebou stojí vysoký a dobře stavěný válečník. Jeho oči prahnou nenávistí, když si tě prohlíží.) Takže potom, co vyhnali Kagu, zvolili Vyvoleným tebe? Haha! Myslíš, že když jsi vnuk Zakladatele, že jsi výjimečný?! Myslíš, že jsi lepší než já, velký Kaga?!"

#: dialog/eckaga1.msg:151 dialog/eckaga2.msg:151 dialog/eckaga3.msg:151
#: dialog/eckaga4.msg:151 dialog/eckaga5.msg:151
msgid "Well, I AM the Chosen One, aren't I?"
msgstr "No, já JSEM přece Vyvolený, nebo ne?"

#: dialog/eckaga1.msg:152 dialog/eckaga2.msg:152 dialog/eckaga3.msg:152
#: dialog/eckaga4.msg:152 dialog/eckaga5.msg:152
msgid "Hey now, hold on a second. I never said I was better than you."
msgstr "Hej hej, počkej vteřinku. Nikdy jsem neřekl, že jsem lepší než ty."

#: dialog/eckaga1.msg:160 dialog/eckaga2.msg:160 dialog/eckaga3.msg:160
#: dialog/eckaga4.msg:160 dialog/eckaga5.msg:160
msgid "That title will mean nothing when Kaga rips the head from your shoulders!"
msgstr "Ten titul nebude znamenat nic až ti Kaga utrhne hlavu!"

#: dialog/eckaga1.msg:161 dialog/eckaga2.msg:161 dialog/eckaga3.msg:161
#: dialog/eckaga4.msg:161 dialog/eckaga5.msg:161
msgid "No words can save your hide. With your death, Kaga's honor shall be restored. Kaga will now take his vengeance!"
msgstr "Žádné řeči ti kůži nezachrání. Tvou smrtí bude Kagovi navrácena čest. Kaga se teď pomstí!"

#: dialog/eckaga1.msg:200 dialog/eckaga2.msg:200 dialog/eckaga3.msg:200
#: dialog/eckaga4.msg:200 dialog/eckaga5.msg:200
msgid "Ooglie?"
msgstr "*Chichi*"

#: dialog/eckaga1.msg:201 dialog/eckaga2.msg:201 dialog/eckaga3.msg:201
#: dialog/eckaga4.msg:201 dialog/eckaga5.msg:201
msgid "What!? They picked *you* to be the Chosen One? Oh my, they've become desperate."
msgstr "Cože!? Ty jsi nový Vyvolený? No teda, ti už musí být vážně zoufalí."

#: dialog/eckaga1.msg:202 dialog/eckaga2.msg:202 dialog/eckaga3.msg:202
#: dialog/eckaga4.msg:202 dialog/eckaga5.msg:202
msgid "Me no likie. U lookie bad."
msgstr "Já ty nelíbit. Ty vypadat zlá."

#: dialog/eckaga1.msg:203 dialog/eckaga2.msg:203 dialog/eckaga3.msg:203
#: dialog/eckaga4.msg:203 dialog/eckaga5.msg:203
msgid "Kaga won't even bother speaking with you further. Prepare to die at the hands of Kaga!"
msgstr "Kaga se ani nebude namáhat s tebou dál mluvit. Připrav se na smrt rukou Kagy!"

#: dialog/eckaga2.msg:100
msgid "You see a man wearing leather armor."
msgstr "Vidíš muže v kožené zbroji."

#: dialog/eckaga2.msg:102
msgid "He is wearing leather armor and has an annoying habit of talking about himself in the third person."
msgstr "Má na sobě koženou zbroj a má protivný zlozvyk mluvit o sobě v třetí osobě."

#: dialog/eckaga2.msg:103
msgid "This will be the last time Kaga meets you."
msgstr "To bude naposledy, kdy tě Kaga potkává."

#: dialog/eckaga2.msg:104
msgid "After Kaga kill you, he will burn Arroyo to the ground."
msgstr "Až tě Kaga zabije, spálí Arroyo na prach."

#: dialog/eckaga2.msg:105 game/cmbatai2.msg:36240 game/cmbatai2.msg:36340
#: game/cmbatai2.msg:36440 game/cmbatai2.msg:36540 game/combatai.msg:36240
#: game/combatai.msg:36340 game/combatai.msg:36440 game/combatai.msg:36540
msgid "Feel the wrath of Kaga!"
msgstr "Pocítíš Kagův hněv!"

#: dialog/eckaga2.msg:106
msgid "I am the great Kaga!"
msgstr "Jsem velký Kaga!"

#: dialog/eckaga2.msg:107
msgid "Kaga is to be feared by all."
msgstr "Před Kagou se musí všichni třást."

#: dialog/eckaga2.msg:108
msgid "Kaga will have your head for a trophy."
msgstr "Kaga si z tvé hlavy udělá trofej."

#: dialog/eckaga2.msg:109
msgid "Surrender and your death will be quick."
msgstr "Vzdej se a tvoje smrt bude rychlá."

#: dialog/eckaga2.msg:110
msgid "Kaga will be back!"
msgstr "Kaga se vrátí!"

#: dialog/eckaga2.msg:111
msgid "You cannot kill the great Kaga!"
msgstr "Nemůžeš zabít velkého Kagu!"

#: dialog/eckaga2.msg:112
msgid "You are lucky Kaga has business elsewhere."
msgstr "Máš štěstí, že má Kaga něco jiného na práci."

#: dialog/eckaga2.msg:113
msgid "Kaga will meet you again."
msgstr "Kaga se s tebou ještě setká."

#: dialog/eckaga2.msg:120
msgid "It's that Kaga guy again."
msgstr "To je zase ten Kaga."

#: dialog/eckaga3.msg:100
msgid "You see a man wearing metal armor."
msgstr "Vidíš muže v kovové zbroji."

#: dialog/eckaga3.msg:102
msgid "Yep, it's Kaga the not-so-great. He has metal armor and wants to kill you."
msgstr "Jo, je to Kaga, ne-až-tak-velký. Má kovovou zbroj a chce tě zabít."

#: dialog/eckaga3.msg:103
msgid "You again!"
msgstr "Zase ty!"

#: dialog/eckaga3.msg:104
msgid "I grow tired of our constant meetings."
msgstr "Už mě ta neustálá setkání začínají unavovat."

#: dialog/eckaga3.msg:105
msgid "Chosen One - hmph!"
msgstr "Vyvolený - hmm!"

#: dialog/eckaga3.msg:106 game/combatai.msg:36321
msgid "Let's end this."
msgstr "Skončeme to."

#: dialog/eckaga3.msg:107
msgid "You will regret you ever heard the name Kaga!"
msgstr "Bude tě mrzet, že jsi kdy slyšel jméno Kaga!"

#: dialog/eckaga3.msg:108 game/cmbatai2.msg:36323 game/combatai.msg:36323
msgid "My skills have increased since we last met."
msgstr "Mé schopnosti doznaly velkého zlepšení od doby, co jsme se naposled setkali."

#: dialog/eckaga3.msg:109 game/cmbatai2.msg:36300 game/cmbatai2.msg:36400
#: game/combatai.msg:36300 game/combatai.msg:36400
msgid "This is getting to be a bad habit."
msgstr "Stává se z toho zlozvyk."

#: dialog/eckaga3.msg:110
msgid "Kaga needs to train a little more."
msgstr "Kaga musí ještě trochu trénovat."

#: dialog/eckaga3.msg:111
msgid "Kaga will return."
msgstr "Kaga se vrátí."

#: dialog/eckaga3.msg:120
msgid "So we meet again, Kaga."
msgstr "Takže se opět setkáváme, Kago."

#: dialog/eckaga4.msg:100
msgid "You see a man wearing combat armor."
msgstr "Vidíš muže v kevlarové zbroji."

#: dialog/eckaga4.msg:101
msgid "You see Kaga in combat armor."
msgstr "Vidíš Kagu v kevlarové zbroji."

#: dialog/eckaga4.msg:102
msgid "He is wearing combat armor and seems to have some decent weapons."
msgstr "Má kevlarovou zbroj a zdá se, že má i docela slušné zbraně."

#: dialog/eckaga4.msg:103
msgid "This time I'm prepared for you."
msgstr "Tentokrát jsem na tebe připraven."

#: dialog/eckaga4.msg:104 game/cmbatai2.msg:36420 game/combatai.msg:36420
msgid "The Chosen One will never return to Arroyo!"
msgstr "Vyvolený se nikdy do Arroya nevrátí!"

#: dialog/eckaga4.msg:105 game/cmbatai2.msg:36421 game/combatai.msg:36421
msgid "Kaga will crush you!"
msgstr "Kaga tě rozdrtí!"

#: dialog/eckaga4.msg:106 game/cmbatai2.msg:36422 game/combatai.msg:36422
msgid "Kaga fears no one!"
msgstr "Kaga se nikoho nebojí!"

#: dialog/eckaga4.msg:107
msgid "Hold still, so Kaga can get a good shot."
msgstr "Stůj klidně, ať může Kaga pořádně zamířit."

#: dialog/eckaga4.msg:109 game/combatai.msg:36402
msgid "This is not the last you will see of Kaga."
msgstr "Nevidíš Kagu naposled."

#: dialog/eckaga4.msg:110
msgid "Kaga definitely needs more training."
msgstr "Kaga nutně potřebuje víc trénovat."

#: dialog/eckaga4.msg:120
msgid "Go away Kaga!"
msgstr "Odejdi, Kago!"

#: dialog/eckaga5.msg:100
msgid "You see a man wearing MKII power armor. He doesn't look friendly."
msgstr "Vidíš muže ve zdokonalené energo zbroji Mark II. Nevypadá přátelsky."

#: dialog/eckaga5.msg:101
msgid "You see Kaga in MKII power armor."
msgstr "Vidíš Kagu ve zdokonalené energo zbroji Mark II."

#: dialog/eckaga5.msg:102
msgid "A big hunk of metal with arms and guns."
msgstr "Je to obrovská hora železa s rukama a zbraněma."

#: dialog/eckaga5.msg:103
msgid "I tire of the chase. Let's finish this."
msgstr "Už mě to pronásledování unavuje. Skončeme to."

#: dialog/eckaga5.msg:104
msgid "This is the last time you will meet Kaga."
msgstr "To je naposled, kdy potkáváš Kagu."

#: dialog/eckaga5.msg:105 game/cmbatai2.msg:36521 game/combatai.msg:36521
msgid "You are no match for Kaga."
msgstr "Kagovi se nemůžeš rovnat."

#: dialog/eckaga5.msg:106
msgid "I look forward to sending you on your next life."
msgstr "Těším se jak tě pošlu na onen svět."

#: dialog/eckaga5.msg:107
msgid "You have been a worthy enemy."
msgstr "Byl jsi dobrým soupeřem."

#: dialog/eckaga5.msg:108
msgid "This part of the wastes doesn't need a do-gooder like you."
msgstr "V této části pustiny není potřeba dobráka, jako jsi ty."

#: dialog/eckaga5.msg:109
msgid "After I kill you, I will be the most feared person in this part of the wastes."
msgstr "Až tě zabiju, budu nejobávanější osobou zdejší pustiny."

#: dialog/eckaga5.msg:110
msgid "I am looking forward to going home to Arroyo - to burn it down."
msgstr "Těším se domů do Arroya... abych ho spálil na popel."

#: dialog/eckaga5.msg:111
msgid "Kaga will be famous for killing you."
msgstr "Kaga se proslaví tvým zabitím."

#: dialog/eckaga5.msg:120
msgid "Kagaaaaaaaa!"
msgstr "Kagaaaaaaaa!"

#: dialog/ecmel.msg:100 dialog/ecmel.msg:101
msgid "You see a man in black."
msgstr "Vidíš muže v černém."

#: dialog/ecmel.msg:102
msgid "It is a man in black. And he doesn't seem too happy."
msgstr "Je to muž v černém. Nevypadá zrovna šťastně."

#: dialog/ecmelchr.msg:100
msgid "You see a strange beast."
msgstr "Vidíš podivného tvora."

#: dialog/ecmelchr.msg:101
msgid "You see a super-mutant that looks a bit deranged."
msgstr "Vidíš supermutanta. Vypadá dost vyšinutě."

#: dialog/ecmelchr.msg:103
msgid "Approach no further! Melchior the Magnificent commands you!"
msgstr "Dál ani krok! Melchior Vznešený ti nařizuje!"

#: dialog/ecmelchr.msg:104
msgid "Behold, I am the greatest magician in the world!"
msgstr "Já jsem ten největší kouzelník na světě!"

#: dialog/ecmelchr.msg:105
msgid "Tremble before the might of Melchior the Magnificent!"
msgstr "Třes se před mocí Melchiora Vznešeného!"

#: dialog/ecmelchr.msg:106
msgid "My pets will feast on your bones!"
msgstr "Moji mazlíčci si pochutnají na tvých kostech!"

#: dialog/ecmelchr.msg:107
msgid "I warned you! Attack, my pets!"
msgstr "Varoval jsem tě! Vezměte si ho, mazlíčci!"

#: dialog/ecmelchr.msg:1000
msgid "SHAHOOEY!"
msgstr "MACHALAJ!"

#: dialog/ecmelchr.msg:1001
msgid "My claw pets take care you."
msgstr "Mí mazlíčci s pařáty se o tebe postarají."

#: dialog/ecmelchr.msg:1002
msgid "Claw thing attack!"
msgstr "Pařáty do útoku!"

#: dialog/ecmelchr.msg:1010
msgid "ABADABRA!"
msgstr "ABRAKADABRA!"

#: dialog/ecmelchr.msg:1011
msgid "Melchior make fire pets to burn human."
msgstr "Melchior vyčaruje ohnivé mazlíčky, kteří spálí člověka."

#: dialog/ecmelchr.msg:1012
msgid "Burn da HU - MUN!"
msgstr "Spalte toho člověka!"

#: dialog/ecmelchr.msg:1020
msgid "ZIMZOWY!"
msgstr "ČÁRY MÁRY FUK!"

#: dialog/ecmelchr.msg:1021
msgid "Jaw pet tear you up!"
msgstr "Můj jedovatý mazlíček tě roztrhá na kusy!"

#: dialog/ecmelchr.msg:1022
msgid "Chomp him my precious."
msgstr "Trhej, zlatíčko."

#: dialog/ecmelchr.msg:1030
msgid "KALIMAJIGGER!"
msgstr "HOKUS POKUS!"

#: dialog/ecmelchr.msg:1031
msgid "Shit! Me only got fat rats left."
msgstr "Do prdele! Zbyli mi už jenom tlusté krysy."

#: dialog/ecmelchr.msg:1032
msgid "Me running out of pets."
msgstr "Docházejí mi mazlíčci."

#: dialog/ecmelchr.msg:1050
msgid "Uh Oh. Me outta furries to mootate."
msgstr "A sakra. Už nemám z čeho dělat mutantíky."

#: dialog/ecmelkid.msg:100
msgid "You see a little rugrat."
msgstr "Vidíš malého skrčka."

#: dialog/ecmelkid.msg:101
msgid "You see Melchior, Jr."
msgstr "Vidíš malého Melchiora."

#: dialog/ecmelkid.msg:150
msgid "He seems like a smiley, big-eyed kid."
msgstr "Je to usměvavý kluk s velkým kukučem."

#: dialog/ecmelkid.msg:200
msgid "Hello! I'm Melchior, Jr."
msgstr "Ahoj! Jsem Melchior mladší."

#: dialog/ecmelkid.msg:201
msgid "My dad's a miner. His name is Melchior just like mine."
msgstr "Táta je horník. Jmenuje se stejně jako já, Melchior."

#: dialog/ecmelkid.msg:202
msgid "My dad is a good miner, but he wants to be a magician."
msgstr "Táta je dobrý horník, ale chtěl by se stát kouzelníkem."

#: dialog/ecmelkid.msg:203
msgid "Daddy's stage name is Melchior the Magnificent."
msgstr "Tátovo umělecké jméno je \"Melchior Velkolepý\"."

#: dialog/ecmelkid.msg:204
msgid "His best trick was pulling a rat out of a hat."
msgstr "Jeho největším číslem byla krysa z klobouku."

#: dialog/ecmelkid.msg:205
msgid "He went away with some men dressed in metal clothes."
msgstr "Odešel s nějakými muži oděnými do plechové výstroje."

#: dialog/ecmelkid.msg:206
msgid "I hope dad comes back soon. I miss his magic tricks."
msgstr "Doufám, že se táta brzy vrátí. Je mi smutno po jeho kouzlech."

#: dialog/ecmelkid.msg:207
msgid "I'm going to be a great magician like my dad."
msgstr "Chci se stát velkým kouzelníkem jako táta."

#: dialog/ecmercs.msg:100
msgid "You see a mercenary."
msgstr "Vidíš žoldáka."

#: dialog/ecmercs.msg:101
msgid "Practice time, boys!"
msgstr "CVičná střelba, hoši!"

#: dialog/ecmercs.msg:102
msgid "Easy target."
msgstr "Snadnej cíl."

#: dialog/ecmercs.msg:103
msgid "Run... I like moving targets."
msgstr "Utíkej... mám rád pohyblivý cíle."

#: dialog/ecmercs.msg:104
msgid "Kill zone!"
msgstr "Zóna smrti!"

#: dialog/ecmercs.msg:105
msgid "Hostile contact confirmed."
msgstr "Potvrzen nepřátelský kontakt."

#: dialog/ecmobstr.msg:100
msgid "You see a mobster."
msgstr "Vidíš mafiána."

#: dialog/ecmobstr.msg:101
msgid "Well, well - what have we got here?"
msgstr "Ale, ale... copak to tady máme?"

#: dialog/ecmobstr.msg:102
msgid "Simple travelers, eh? Ain't no such thing. You need help with any of your valuables? "
msgstr "Obyčejní pocestní, jo? Něco takovýho neexistuje. Nepotřebujete náhodou někoho, kdo by se vám postaral o vaše cennosti?"

#: dialog/ecmobstr.msg:103
msgid "Watch where you're walking around Reno, or you're gonna get hurt. Stay outta my way."
msgstr "Dávej si pozor, kam v New Reno lezeš, nebo přijdeš k úrazu. Kliď se mi z cesty."

#: dialog/ecmobstr.msg:104 dialog/nccorbro.msg:246 dialog/ncnikki.msg:210
#: dialog/ncnikki.msg:242 dialog/ncprosti.msg:868 dialog/zidcegrl.msg:215
#: dialog/zidcegrl.msg:261
msgid "Hello, "
msgstr "Ahoj, "

#: dialog/ecmobstr.msg:106
msgid "What are you doing out here, "
msgstr "Co tady děláš, "

#: dialog/ecmobstr.msg:108
msgid "We were just coming out to check on you, "
msgstr "Zrovna jsme se na tebe chtěli podívat, "

#: dialog/ecmobstr.msg:109
msgid ". Nice day today, eh, "
msgstr ". Dneska je ale hezkej den, že, "

#: dialog/ecmobstr.msg:111
msgid "Did you come out here to get away from it all, "
msgstr "Přišel jsi sem, abys od všeho utekl, "

#: dialog/ecmobstr.msg:112 dialog/ncliljes.msg:5560 dialog/ocgoris.msg:1156
msgid "? "
msgstr "? "

#: dialog/ecmobstr.msg:113
msgid " was wondering what you were up to, "
msgstr " zajímá, co máš v plánu, "

#: dialog/ecmonshn.msg:100
msgid "You see a moonshiner."
msgstr "Vidíš překupníka s podomácky pálenou whisky."

#: dialog/ecmonshn.msg:101
msgid "We sell only the highest quality liquor. You interested?"
msgstr "Prodáváme pítí té nejvyšší kvality. Máš zájem?"

#: dialog/ecmonshn.msg:102
msgid "Yes, let's see what you got."
msgstr "Mám. Ukaž mi, co máš."

#: dialog/ecmonshn.msg:105
msgid "Then beat it! We're busy."
msgstr "Tak vystřel. Nemáme čas."

#: dialog/ecmonshn.msg:106
msgid "I make sure the mix of alcohol is just right."
msgstr "Ujišťuju tě, že je poměr alkoholu v pořádku."

#: dialog/ecmonshn.msg:107
msgid "Baka. BAka BAKA!"
msgstr "Baka. BAka BAKA!"

#: dialog/ecmonshn.msg:108
msgid "Thanks for the business."
msgstr "Díky za obchod."

#: dialog/ecmrchnt.msg:100
msgid "You see a well-traveled person."
msgstr "Vidíš zcestovalého člověka."

#: dialog/ecmrchnt.msg:102
msgid "Wow, I rarely see people out here."
msgstr "Páni, v těhlech končinách vidím člověka jen zřídkakdy."

#: dialog/ecmrchnt.msg:103
msgid "Hey! Wait! I have things that could help you along!"
msgstr "Hej! Počkej! Mám věci, který by ti mohly pomoct na tvejch dalších cestách!"

#: dialog/ecmrchnt.msg:104
msgid "Hey! Do you have anything to trade for these?"
msgstr "Ahoj! Máš něco, co bys mohl vyměnit za tohle?"

#: dialog/ecmrchnt.msg:105
msgid "This must be my lucky day. Come, see what I have for sale."
msgstr "Dneska je tvůj šťastnej den. Pojď a podívej se, co mám na prodej."

#: dialog/ecmrchnt.msg:200
msgid ""
"Greetings, traveler! I rarely see many people along this route, but\n"
" am always happy to have new customers. Would you like to trade?"
msgstr "Buď zdráv, poutníku! Na týhle trase moc lidí nepotkávám, ale vždycky mě potěší získat novýho zákazníka. Chceš obchodovat?"

#: dialog/ecmrchnt.msg:201
msgid ""
"Hey there! It's really great that you stopped. Most people along this\n"
" route just keep right on going. Hey, would you like to trade some things?"
msgstr "Zdravím! Je skvělý, že ses u mě zastavil. Většina lidí na týhle trase ani nezastaví. Nechceš něco vyměnit?"

#: dialog/ecmrchnt.msg:202
msgid "Would you be interested in a little trade?"
msgstr "Nemáš zájem o malej obchod?"

#: dialog/ecmrchnt.msg:250
msgid "That'd be good."
msgstr "To by bylo dobré."

#: dialog/ecmrchnt.msg:251
msgid "Sorry, have to keep on moving."
msgstr "Promiň, ale musím pokračovat v cestě."

#: dialog/ecmrchnt.msg:252
msgid "Yah. Me got stuff!"
msgstr "Jo. Já mít zboží!"

#: dialog/ecmrchnt.msg:260
msgid "Good trading with you. Good luck in your travels."
msgstr "Bylo fajn s tebou obchodovat. Ať tě na tvejch cestách doprovází štěstí."

#: dialog/ecmrchnt.msg:270
msgid "Glad to have you back. Can I interest you in something else?"
msgstr "Vítej zpátky. Chceš se podívat, co nabízím?"

#: dialog/ecmstamy.msg:100
msgid "A die-hard soldier from the Master's army."
msgstr "Vidíš nekompromisního člena Vůdcovy armády."

#: dialog/ecmstamy.msg:101
msgid "Master says bring all normies to him."
msgstr "Vůdce řekl, ať přivedeme všechny normálny."

#: dialog/ecmstamy.msg:102
msgid "All normies must be dipped."
msgstr "Všichni normálové musí být ponořeni do kádí."

#: dialog/ecmstamy.msg:103
msgid "Squish the normie!"
msgstr "Rozmáčknout normála!"

#: dialog/ecmstamy.msg:104
msgid "Me want hear you make squish noise."
msgstr "Já chtít slyšet ten čvachtavý zvuk."

#: dialog/ecmststr.msg:100
msgid "You see a helpful stranger."
msgstr "Vidíš ochotného cizince."

#: dialog/ecmststr.msg:101
msgid "You see the mysterious stranger."
msgstr "Vidíš záhadného cizince."

#: dialog/ecmststr.msg:102
msgid "I will help thee."
msgstr "Pomůžu ti."

#: dialog/ecmststr.msg:103
msgid "I don't talk much."
msgstr "Moc nemluvím."

#: dialog/ecmststr.msg:104
msgid "Looks like you could use some assistance."
msgstr "Vypadá to, že potřebuješ trochu pomoct."

#: dialog/ecmststr.msg:105 dialog/qcgranit.msg:110
msgid "Let's rock!"
msgstr "Jdeme na to!"

#: dialog/ecnomad.msg:100 dialog/ecnomchf.msg:100
msgid "You see a nomad."
msgstr "Vidíš nomáda."

#: dialog/ecnomad.msg:101
msgid "Hello, you look new around here."
msgstr "Buď zdráv. Zdá se, že jsi tady nový."

#: dialog/ecnomad.msg:102
msgid "You should talk to the chief."
msgstr "Promluv si s náčelníkem."

#: dialog/ecnomad.msg:103
msgid "I don't think it is as hot today as it was yesterday."
msgstr "Myslím, že není takové horko jako včera."

#: dialog/ecnomad.msg:104
msgid "So what's life like in the city?"
msgstr "Tak co, jak jde život ve městě?"

#: dialog/ecnomad.msg:105 dialog/ecnomchf.msg:116 dialog/ecnomsha.msg:143
msgid "Infidel!"
msgstr "Nevěřící!"

#: dialog/ecnomad.msg:106 dialog/ecnomchf.msg:117 dialog/ecnomsha.msg:144
msgid "Why do you attack us?"
msgstr "Proč na nás útočíš?"

#: dialog/ecnomad.msg:107 dialog/ecnomchf.msg:118 dialog/ecnomsha.msg:145
msgid "I will defend the tribe with my life!"
msgstr "Budu bránit svůj kmen do poslední kapky krve!"

#: dialog/ecnomad.msg:108
msgid "How dare you violate our hospitality!"
msgstr "Jak se opovažuješ zneužít naší pohostinnosti!"

#: dialog/ecnomad.msg:109 dialog/ecnomchf.msg:120 dialog/ecnomsha.msg:147
msgid "Be gone!"
msgstr "Zmiz!"

#: dialog/ecnomad.msg:110 dialog/ecnomchf.msg:121 dialog/ecnomsha.msg:148
msgid "Leave us."
msgstr "Nech nás na pokoji."

#: dialog/ecnomad.msg:111 dialog/ecnomchf.msg:122 dialog/ecnomsha.msg:149
msgid "We are a peaceful tribe."
msgstr "Jsme mírumilovný kmen."

#: dialog/ecnomchf.msg:101
msgid "He appears to be a nomad chieftain."
msgstr "Je to náčelník nomádů."

#: dialog/ecnomchf.msg:102
msgid "By his dress and the way he carries himself, he must be a leader of some sort."
msgstr "Podle toho, co má na sobě a jaké z něj vyzařuje charisma, to musí být nějaký vůdce."

#: dialog/ecnomchf.msg:103
msgid "Ah, a traveler. Be welcome to my humble tent. Take shade from the unending heat of the land."
msgstr "Á, poutník. Vítej v mém skromném stanu. Spočiň ve stínu a ulev si od nekonečného vedra."

#: dialog/ecnomchf.msg:104
msgid "Thank you; I graciously accept your offer of shade."
msgstr "Děkuju. S povděkem přijímám nabídku stínu."

#: dialog/ecnomchf.msg:105
msgid "I must decline your offer. I am just passing through."
msgstr "Musím odmítnout tvoji nabídku. Jenom procházím."

#: dialog/ecnomchf.msg:106 dialog/ecnomsha.msg:108 dialog/generic.msg:302
#: dialog/mccornel.msg:301
msgid "Ooga."
msgstr "Ooga."

#: dialog/ecnomchf.msg:107
msgid ""
"Be welcome, then. We have long been away from the 'civilized' lands. We are in need of\n"
" certain items. Perhaps we might be able to trade?"
msgstr "Vítej. Už dlouho jsme odříznuti od civilizovaných končin. Potřebovali bychom určité zboží. Snad bychom mohli něco vyměnit."

#: dialog/ecnomchf.msg:108 dialog/mcjo.msg:165
msgid "What do you have to trade?"
msgstr "Co máš k obchodování?"

#: dialog/ecnomchf.msg:109
msgid "I have nothing to trade. Sorry."
msgstr "Nemám nic ke směnění. Je mi líto."

#: dialog/ecnomchf.msg:110
msgid "Perhaps another time, then? May your travels be free of danger."
msgstr "Tak snad někdy jindy. Ať jsou tvé cesty prosty nebezpečí."

#: dialog/ecnomchf.msg:112
msgid "How unfortunate. Then rest and be welcome in my camp."
msgstr "Jaká škoda. Odpočiň si tedy a vítej v našem táboře."

#: dialog/ecnomchf.msg:113 dialog/tribec4.msg:641
msgid "Thank you. Bye."
msgstr "Díky. Nashle."

#: dialog/ecnomchf.msg:114
msgid ""
"My offer of shade has come too late for you. The sun must have boiled away words from your\n"
" brain. I must be kind to those less fortunate than I. Stay as long you like in my camp, dimwitted one."
msgstr "Vidím, že moje nabídka stínu přišla příliš pozdě. Slunce ti už nejspíš vypálilo mozek. Musím být přívětivý k těm, kteří v životě nemají tolik štěstí. Zůstaň v mém táboře, jak dlouho budeš chtít, zabedněnče."

#: dialog/ecnomchf.msg:119 dialog/ecnomsha.msg:146
msgid "How dare you violate our hospitality."
msgstr "Jak se opovažuješ zneužít mé pohostinnosti!"

#: dialog/ecnomchf.msg:200
msgid "Ah, a traveler. I am sorry that we have no tent from which you may take shade from the unending heat of the land. Do rest a moment, so that we may talk."
msgstr "Á, poutník. Omlouvám se, že nemáme pro tebe žádný stan, ve kterém by jsi si mohl ulevit od spalujícího vedra. Posečkej chvilku, abychom si mohli promluvit."

#: dialog/ecnomchf.msg:201
msgid "Thank you; I graciously accept your offer."
msgstr "Děkuju. S povděkem přijímám Tvoji nabídku."

#: dialog/ecnomchf.msg:202
msgid "How unfortunate. Rest a moment then; you are welcome among us."
msgstr "Jaká škoda. Odpočiň si tedy, jsi zde vítán."

#: dialog/ecnomchf.msg:203
msgid "I do hope you found what you needed. Anything else?"
msgstr "Doufám, že jsi nalezl to co jsi potřeboval. Ještě něco jiného?"

#: dialog/ecnomchf.msg:204
msgid "Not today. I must be going."
msgstr "Ne dnes. Já teď jít."

#: dialog/ecnomsha.msg:100
msgid "You see a nomad shaman."
msgstr "Vidíš nomádského šamana."

#: dialog/ecnomsha.msg:101
msgid "He appears to be a nomad shaman."
msgstr "Vypadá jako nomádský šaman."

#: dialog/ecnomsha.msg:102
msgid "The strong smell of herbs cling to this one's clothing."
msgstr "Z jeho oblečení je cítit silná vůně bylin."

#: dialog/ecnomsha.msg:103
msgid "Hello, stranger. I am the tribe shaman. I am skilled in the art of healing."
msgstr "Buď zdráv, cizinče. Jsem šaman tohoto kmene. Ovládám léčitelské umění."

#: dialog/ecnomsha.msg:105
msgid "I am in need of healing."
msgstr "Potřebuju vyléčit."

#: dialog/ecnomsha.msg:106
msgid "Can you combine the Xander root and the Broc flower?"
msgstr "Umíš smíchat kořen Xanderu s květinou Broc?"

#: dialog/ecnomsha.msg:109
msgid "Be still and I will examine you."
msgstr "Stůj klidně a já tě vyšetřím."

#: dialog/ecnomsha.msg:110 dialog/ecnomsha.msg:124 dialog/ecnomsha.msg:126
#: dialog/tribec9.msg:207 dialog/tribec9.msg:209
msgid "[Continue]"
msgstr "[Pokračovat]"

#: dialog/ecnomsha.msg:111
msgid "I have found these afflictions."
msgstr "Objevil jsem následující choroby."

#: dialog/ecnomsha.msg:112
msgid "Can you help me?"
msgstr "Můžeš mi pomoct?"

#: dialog/ecnomsha.msg:113
msgid "I can perform the following for a price:"
msgstr "Následující činnosti provádím za poplatek:"

#: dialog/ecnomsha.msg:114
msgid "Please extract the poison from my body."
msgstr "Dostaň jed z mého těla, prosím."

#: dialog/ecnomsha.msg:115
msgid "Please heal me."
msgstr "Prosím, uzdrav mě."

#: dialog/ecnomsha.msg:116
msgid "See what you can do for my broken limb."
msgstr "Podívej se, jestli dokážeš něco udělat s tou zlomeninou."

#: dialog/ecnomsha.msg:118 dialog/ecnomsha.msg:119 dialog/ecnomsha.msg:120
msgid "You have been healed."
msgstr "Tvá zranění byla vyléčena."

#: dialog/ecnomsha.msg:121
msgid "I am in need of more of your skills."
msgstr "Potřebuju tvé dovednosti."

#: dialog/ecnomsha.msg:122
msgid "Thank you; I feel much better. Bye."
msgstr "Děkuju. Cítím se teď o hodně lépe. Nahle."

#: dialog/ecnomsha.msg:123
msgid "My skills are limited, and I cannot help you any further in this area."
msgstr "Mé dovednosti jsou omezené. Víc už ti s tím nepomůžu."

#: dialog/ecnomsha.msg:125
msgid "You do not require this type of healing."
msgstr "Nepotřebuješ tento typ léčení."

#: dialog/ecnomsha.msg:127
msgid ""
"Ahh... You are familiar with the healing properties of these two plants. It will only cost\n"
" you"
msgstr "Ááá...ty znáš léčebné účinky těchto dvou rostlin. Bude tě to stát jenom "

#: dialog/ecnomsha.msg:128
msgid "Please combine the two plants for me."
msgstr "Smíchej pro mě prosím tyto dvě rostliny."

#: dialog/ecnomsha.msg:129
msgid "Maybe later, bye."
msgstr "Možná později. Nashle."

#: dialog/ecnomsha.msg:130
msgid ""
"[You watch as he carefully crushes and combines the two plants, and then hands you precisely\n"
" measured doses of the powder.]"
msgstr "(Díváš se, jak opatrně drtí a smíchá dvě rostliny a poté ti podá přesně odměřené dávky prášku.)"

#: dialog/ecnomsha.msg:132
msgid "You seem to be short on cash. Return later when your purse is fatter."
msgstr "Zdá se, že nemáš dost peněz. Vrať se, až bude tvoje peněženka naditější."

#: dialog/ecnomsha.msg:134
msgid "I do not have time for such nonsense. Leave!"
msgstr "Nemám čas na takové hlouposti. Odejdi!"

#: dialog/ecnomsha.msg:136
msgid "[Poisoned]"
msgstr "[Otrava]"

#: dialog/ecnomsha.msg:137
msgid "[Injured]"
msgstr "[Zranění]"

#: dialog/ecnomsha.msg:138
msgid "[Radiated]"
msgstr "[Ozáření]"

#: dialog/ecnomsha.msg:139
msgid "[Crippled]"
msgstr "[Zmrzačení]"

#: dialog/ecnomsha.msg:140
msgid "Cure poison,"
msgstr "Léčení otrav,"

#: dialog/ecnomsha.msg:141
msgid "Fix crippled limbs,"
msgstr "Vyléčení zmrzačených končetin,"

#: dialog/ecnomsha.msg:142
msgid "Healing $"
msgstr "Uzdravování $"

#: dialog/ecnomsha.msg:150
msgid "and I will combine the two for you."
msgstr "a já vám ty dvě věci spojím."

#: dialog/ecoutcst.msg:100
msgid "Do not run."
msgstr "Neutíkej."

#: dialog/ecoutcst.msg:101
msgid "We are your friends."
msgstr "Jsme tví přátelé."

#: dialog/ecoutcst.msg:102
msgid "Do not attack."
msgstr "Neútoč."

#: dialog/ecoutcst.msg:103
msgid "Sucker."
msgstr "Troubo."

#: dialog/ecoutcst.msg:104
msgid "Leave us!"
msgstr "Nech nás na pokoji!"

#: dialog/ecoutcst.msg:105
msgid "Unclean!"
msgstr "Špinavče!"

#: dialog/ecpariah.msg:100
msgid "You see ragged looking dog that could expire at any moment."
msgstr "Vidíš zpustle vypadajícího psa. Zdá se, že každou chvíli pojde."

#: dialog/ecpariah.msg:101
msgid "It is that damn bad luck dog."
msgstr "To je ten zatracený pes, co přináší smůlu."

#: dialog/ecpariah.msg:102
msgid "This dog has several patches of fur missing and almost seems to be a walking corpse. He also seems to have a glass eye."
msgstr "Tenhle pes nemá na několika místech žádný kožich a vypadá jako chodící mrtvola. Zdá se, že má jedno oko skleněné."

#: dialog/ecpariah.msg:103
msgid "The dog seems to take a liking to you. This can't be good."
msgstr "Zdá se, že si tě pes oblíbil. To nevěští nic dobrého."

#: dialog/ecpatsy.msg:100
msgid "A man."
msgstr "Vidíš nějakého muže."

#: dialog/ecpatsy.msg:101
msgid "Patsy."
msgstr "To je Patsy."

#: dialog/ecpdog.msg:100
msgid "This animal should really be put out of its misery."
msgstr "Tohle zvíře by mělo být utraceno, aby se už dál netrápilo."

#: dialog/ecpdog.msg:101
msgid "It resembles a dog. Too bad the hair on this poor thing is falling off in clumps."
