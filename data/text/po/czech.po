#: dialog/ncnikki.msg:350 dialog/zidcegrl.msg:421
msgid "Winner! You've doubled your money! Well done, sir!"
msgstr "Výhra! Zdvojnásobil jste své peníze! Gratuluji, pane!"

#: dialog/ncnikki.msg:351 dialog/zidcegrl.msg:422
msgid "Winner! You've doubled your money! Well done, ma'am!"
msgstr "Výhra! Zdvojnásobila jste své peníze! Gratuluji, madam!"

#: dialog/ncnikki.msg:352 dialog/zidcegrl.msg:420
msgid "Winner! You've doubled your money!"
msgstr "Výhra! Zdvojnásobil jste své peníze!"

#: dialog/ncnikki.msg:360 dialog/zidcegrl.msg:431
