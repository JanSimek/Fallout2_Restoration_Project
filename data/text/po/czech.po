#: dialog/mcjohnny.msg:170 dialog/mcjonny.msg:170 dialog/ncbigjes.msg:553
#: dialog/tribec2.msg:171
msgid "No, not yet."
msgstr "Ne, ještě ne."

#: dialog/acmynoc.msg:188
msgid ""
"You have? Wonderful! Did you bring back the\n"
" GECK?"
msgstr "Opravdu? To je skvělé! Přinesl jsi nám GECK?"

