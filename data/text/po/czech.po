msgstr "HEJ, FLICKU!"

#: dialog/dcpetey.msg:320
msgid "Hey Tubby, can you hook me up? I've got cash."
msgstr "Hej, Tubby, můžeš mi něco sehnat? Mám prachy."

#: dialog/dcpetey.msg:321
