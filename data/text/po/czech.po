#: game/pro_wall.msg:196800 game/pro_wall.msg:196900 game/pro_wall.msg:197000
msgid "Window"
msgstr "Okno"

#: game/pro_scen.msg:47101 game/pro_scen.msg:47201 game/pro_scen.msg:47301
#: game/pro_scen.msg:47401
msgid "Instead of glass, this window is using wax paper."
msgstr "Toto okno je vyrobené z voskového papíru namísto skla."

#: game/pro_scen.msg:47501 game/pro_scen.msg:47601 game/pro_scen.msg:47801
#: game/pro_scen.msg:47901
msgid "This large metal roll-door has been jammed shut from the inside."
msgstr "Velká garážová vrata. Jsou zablokována zevnitř."

#: game/pro_scen.msg:47701 game/pro_scen.msg:48001
msgid "This large metal roll-door has been jammed shut from the inside. It reads LOADING ONLY."
msgstr "Velká garážová vrata. Jsou zablokována zevnitř. Je na nich nápis POUZE PRO NAKLÁDÁNÍ."

#: game/pro_scen.msg:48101 game/pro_scen.msg:48201
msgid "This door looks suspiciously like the door you would find in a warehouse."
msgstr "Tyto dveře nápadně připomínají dveře do skladiště."

#: game/pro_scen.msg:48300
msgid "Weather Vane"
msgstr "Korouhvička"

#: game/pro_scen.msg:48301
msgid "This simple weather vane helps inhabitants of the wasteland study the weather."
msgstr "Jednoduchá korouhvička, která umožňuje obyvatelům pustin v omezené míře předpovídat počasí."

#: game/pro_scen.msg:48401 game/pro_scen.msg:50501 game/pro_scen.msg:50601
#: game/pro_scen.msg:50701 game/pro_scen.msg:50801
msgid "A simple altar made from painted wood."
msgstr "Jednoduchý oltář ze zdobeného dřeva."

#: game/pro_scen.msg:48500 game/pro_scen.msg:52600
msgid "Podium"
msgstr "Pódium"

#: game/pro_scen.msg:48501
msgid "This is a normal podium for public speaking."
msgstr "Obyčejný řečnický pult."

#: game/pro_scen.msg:48701
msgid "A large monitor, black and white only. The reception is pretty good for being indoors without an antenna."
msgstr "Velká černobílá televize. Příjem je docela ucházející vzhledem k tomu, že je umístěna uvnitř a nemá anténu."

#: game/pro_scen.msg:48801
msgid "A large monitor, black and white only. The robed figure is reciting religious dogma at a feverish pace."
msgstr "Velká černobílá televize. Člověk v rouchu na něm horečnatě přednáší náboženská dogmata."

#: game/pro_scen.msg:48900 game/pro_scen.msg:49000 game/pro_scen.msg:49100
#: game/pro_scen.msg:49200 game/pro_scen.msg:154800 game/pro_scen.msg:154900
#: game/pro_scen.msg:158100 game/pro_scen.msg:158200 game/pro_scen.msg:158300
#: game/pro_scen.msg:158400 game/pro_scen.msg:206600 game/scrname.msg:1532
#: game/scrname.msg:1535 game/scrname.msg:1541
msgid "Forcefield"
msgstr "Silové pole"

#: game/pro_scen.msg:48901 game/pro_scen.msg:49001 game/pro_scen.msg:49101
#: game/pro_scen.msg:49201
msgid "This is a powerful field of energy."
msgstr "Silné energetické pole."

#: game/pro_scen.msg:49301 game/pro_scen.msg:49401 game/pro_scen.msg:49501
#: game/pro_scen.msg:49601 game/pro_scen.msg:49701 game/pro_scen.msg:49801
msgid "A fairly ordinary wooden table."
msgstr "Docela obyčejný dřevěný stůl."

#: game/pro_scen.msg:50901
msgid "A collapsed section of the roof has formed this pile of rubble. Your rope leads back to the surface."
msgstr "Sutiny ze zříceného stropu. Lano vede zpět na povrch."

#: game/pro_scen.msg:51001
msgid "fgfgfg"
msgstr "fgfgfg"

#: game/pro_scen.msg:51601 game/pro_scen.msg:51701 game/pro_scen.msg:51801
#: game/pro_scen.msg:51901 game/pro_scen.msg:52001 game/pro_scen.msg:52101
msgid "This large table looks important. Perhaps they hold meetings here?"
msgstr "Tento velký stůl vypadá důležitě. Že by se tu pořádaly schůze?"

#: game/pro_scen.msg:52201 game/pro_scen.msg:52301 game/pro_scen.msg:52401
msgid "An altar designed and used by the Brotherhood of Steel. Their symbol is brazenly shown."
msgstr "Tento oltář používá Bratrstvo Oceli. Jasně poznáváš jejich symbol."

#: game/pro_scen.msg:52501
msgid "A nicely fashioned, and mighty uncomfortable looking, pew."
msgstr "Sice krásně navržená, ale už na pohled děsně nepohodlná lavice."

#: game/pro_scen.msg:52601
msgid "A nice wooden podium. There is a tele-prompter screen built into it, facing the speaker."
msgstr "Dřevěné pódium se zabudovanou nápovědou."

#: game/pro_scen.msg:53300 game/pro_scen.msg:53400 game/pro_scen.msg:53500
#: game/pro_scen.msg:53600
msgid "Mat"
msgstr "Žíněnka"

#: game/pro_scen.msg:53301 game/pro_scen.msg:53401 game/pro_scen.msg:53501
#: game/pro_scen.msg:53601
msgid "A training mat."
msgstr "Cvičební žíněnka."

#: game/pro_scen.msg:53700 game/scrname.msg:1098
msgid "Punching Bag"
msgstr "Boxovací pytel"

#: game/pro_scen.msg:53701
msgid "This is a StrongMan(tm) punching bag."
msgstr "Boxovací pytel značky Silák Béďa(tm)."

#: game/pro_scen.msg:53800 game/pro_scen.msg:53900
msgid "Stair Stepper"
msgstr "Cvičební stroj"

#: game/pro_scen.msg:53801 game/pro_scen.msg:54001 game/pro_scen.msg:54101
#: game/pro_scen.msg:54201 game/pro_scen.msg:54301
msgid "An exercise machine."
msgstr "Cvičební pomůcka."

#: game/pro_scen.msg:54000 game/pro_scen.msg:54100
msgid "Treadmill"
msgstr "Běžecký pás"

#: game/pro_scen.msg:54200 game/pro_scen.msg:54300
msgid "Bench Press"
msgstr "Lavice na benchpress"

#: game/pro_scen.msg:54400 game/pro_scen.msg:54500
msgid "Wood Planks"
msgstr "Prkna"

#: game/pro_scen.msg:54401 game/pro_scen.msg:54501 game/pro_scen.msg:224701
#: game/pro_scen.msg:224801
msgid "These sturdy wooden planks have been firmly bound together."
msgstr "Silná dřevěná prkna pevně svázaná dohromady."

#: game/pro_scen.msg:54600 game/pro_scen.msg:54700 game/pro_scen.msg:54800
#: game/pro_scen.msg:54900 game/pro_scen.msg:55000
msgid "Roulette Table"
msgstr "Stůl na ruletu"

#: game/pro_scen.msg:55100 game/pro_scen.msg:55200 game/pro_scen.msg:232500
#: game/pro_scen.msg:232600 game/pro_scen.msg:232700 game/pro_scen.msg:232800
msgid "Barrel"
msgstr "Sud"

#: game/pro_scen.msg:55101
msgid "This empty metal barrel has the nuclear trefoil symbol painted on the side in bright yellow paint."
msgstr "Prázdný železný sud, který má na boku namalován jasně žlutý symbol varování před radiací."

#: game/pro_scen.msg:55201
msgid "This barrel contains some green glowing goo. The nuclear trefoil symbol gives a clue to what the goo might be."
msgstr "Tento sud obsahuje podivnou zeleně fosforeskující hmotu. A žlutý nukleární symbol na boku ti napovídá, co by to asi tak mohlo být."

#: game/pro_scen.msg:55301 game/pro_scen.msg:55401
msgid "A very modern looking computer."
msgstr "Velice moderně vypadající počítač."

#: game/pro_scen.msg:55500 game/pro_scen.msg:200200
msgid "Suspension Tank"
msgstr "Suspenzní nádrž"

#: game/pro_scen.msg:55501
msgid "Some sort of medical or experimental apparatus, it looks as if it could contain a human or larger sized body."
msgstr "Nějaký lékařský nebo výzkumný přístroj. Vypadá to, že by se do něj mohlo vejít lidské nebo i větší tělo."

#: game/pro_scen.msg:55600
msgid "Broken Suspension Tank"
msgstr "Rozbitá suspenzní nádrž"

#: game/pro_scen.msg:55601
msgid "A broken piece of equipment. It is beyond repair."
msgstr "Zcela zničené zařízení. Nelze opravit."

#: game/pro_scen.msg:55700
msgid "Mainframe"
msgstr "Hlavní počítač"

#: game/pro_scen.msg:55701
msgid "A large super computer. Probably the fastest looking computer you've ever seen."
msgstr "Veliký superpočítač. Pravděpodobně nejrychlejší počítač jaký existuje."

#: game/pro_scen.msg:55800
msgid "Support Platform"
msgstr "Podpůrná plošina"

#: game/pro_scen.msg:55801
msgid "This platform supports the large super computer over the cooling tanks."
msgstr "Tato plošina udržuje superpočítač nad nádrží s chladícím médiem."

#: game/pro_scen.msg:55900 game/pro_scen.msg:56000
msgid "Don't use"
msgstr "Dont use"

#: game/pro_scen.msg:56401 game/pro_scen.msg:56501
msgid "It looks like a serial cable of some sort."
msgstr "Vypadá to jako nějaký sériový kabel."

#: game/pro_scen.msg:56600 game/pro_scen.msg:58200 game/pro_scen.msg:59800
#: game/pro_scen.msg:59900 game/pro_scen.msg:60000 game/pro_scen.msg:85100
