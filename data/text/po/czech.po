msgstr "Mike rozbít"

#: dialog/nctyson.msg:161
msgid "I really like vanilla ice cream."
msgstr "Hrozně miluju vanilkovou zmrzlinu."

#: dialog/nctyson.msg:162
msgid "Gnarrrr"
msgstr "Gnarrrr"

#: dialog/nctyson.msg:163
msgid "Nrrrurhhh"
msgstr "Nrrrurhhh"

#: dialog/nctyson.msg:164
msgid "Mike like ears."
msgstr "Mike rád ouška."

#: dialog/nctyson.msg:165
msgid "Ears mmmmmmm."
msgstr "Ouška mmmmmmm."

#: dialog/nctyson.msg:166
msgid "Grrrrrr"
msgstr "Grrrrrr."

