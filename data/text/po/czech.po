msgid "Sorry, this table has been closed. Someone has been tampering with the dice."
msgstr "Promiňte, ale tento stůl je uzavřen. Někdo manipuloval s kostkami."

#: dialog/zidcegrl.msg:451
msgid "Sorry sir, this table has been closed. Someone has been tampering with the dice."
msgstr "Promiňte pane, ale tento stůl je uzavřen. Někdo manipuloval s kostkami."

#: dialog/zidcegrl.msg:452
msgid "Sorry ma'am, this table has been closed. Someone has been tampering with the dice."
msgstr "Promiňte madam, ale tento stůl je uzavřen. Někdo manipuloval s kostkami."

#: dialog/zidcegrl.msg:453
msgid "Uhhh, OK."
msgstr "Ehh, dobře."

#: dialog/zidcegrl.msg:454
msgid "Sorry to hear that. Thanks."
msgstr "Tak to mi je líto. Díky."

#: dialog/zidcegrl.msg:2321
msgid ". Place your bets..."
msgstr ". Vaše sázky, prosím..."

#: dialog/zidcegrl.msg:2327
msgid ".] "
msgstr ".] "

#: dialog/zidcegrl.msg:2344
msgid " could always use new inventory item [Leave.]"
msgstr " určitě ocenit nová věc do inventář. [Opustit]"

#: dialog/zidcegrl.msg:2352
msgid "? 'Too rich for your blood?' [Scoffs.] Pal, you're in the wrong town."
msgstr "? 'Na tohle nemáš?' (Zamračí se.) Kámo, tak to jsi ve špatném městě."

#: dialog/zidcegrl.msg:2353
msgid "? 'Too rich for your blood?' [Scoffs.] Girl, you're in the wrong town."
msgstr "? 'Na tohle nemáš?' (Zamračí se.) Holka, tak to jsi ve špatném městě."

#: dialog/zigengrv.msg:100
msgid "You see a grave."
msgstr "Vidíš hrob."

#: dialog/zigengrv.msg:101
msgid "You see an uncovered grave."
msgstr "Vidíš otevřený hrob."

#: dialog/zigengrv.msg:102
msgid "This is a grave site."
msgstr "Hrob."

#: dialog/zigengrv.msg:103
msgid "This grave site has been uncovered."
msgstr "Tento hrob je otevřený."

#: dialog/zigengrv.msg:150
msgid "The grave site has been covered."
msgstr "Tento hrob je zasypaný."

#: dialog/zigengrv.msg:151
msgid "The grave site has been uncovered."
msgstr "Tento hrob je otevřený."

#: dialog/zigengrv.msg:200
msgid "You see a headstone."
msgstr "Vidíš náhrobek."

#: dialog/zigengrv.msg:250
msgid "There are no markings on this headstone."
msgstr "Na tomto náhrobku není nic vyryto."

#: dialog/zigengrv.msg:251
msgid "The name on the headstone has been scratched out."
msgstr "Jméno na tomto náhrobku je seškrabáno."

#: dialog/zigengrv.msg:252
msgid "The name on the headstone reads John Doe."
msgstr "Na náhrobku je jméno John Doe."

#: dialog/zigengrv.msg:261
msgid "The name on the grave marker has been scratched out."
msgstr "Jméno na tomto kříži je seškrabáno."

#: dialog/zigengrv.msg:275
msgid "The headstone reads: "
msgstr "Na náhrobku stojí: "

#: dialog/zigengrv.msg:300
msgid "\"Here lies Chris Avellone, King of the Dance Floor.\""
msgstr "\"Zde leží Chris Avellone, Král parketu.\""

#: dialog/zigengrv.msg:301
msgid "\"Chris Jones. Nightwing.\""
msgstr "\"Chris Jones. Noční pták.\""

#: dialog/zigengrv.msg:302
msgid "\"Christopher Michael Holland, aka 'Chris Holland', aka 'Chris': There are two and a half reasons to read this headstone... Normally you would expect those reasons to be listed.\""
msgstr "\"Christopher Michael Holland, neboli 'Chris Holland', neboli 'Chris': Ke čtení tohoto náhrobku jsou dva a půl důvodu... obvykle se čeká, že budou ty důvody uvedeny.\""

#: dialog/zigengrv.msg:303
msgid "\"Colin McComb: Another pointless life.\""
msgstr "\"Colin McComb: Další nesmyslný život.\""

#: dialog/zigengrv.msg:304
msgid "\"David Hendee: the loudest among the dead. May he rest in peace, quietly.\""
msgstr "\"David Hendee: Nejhlasitější mezi mrtvými. Ať odpočívá v pokoji, a tiše.\""

#: dialog/zigengrv.msg:305
msgid "\"Ed Hyland. He told the world to 'suck it.'\""
msgstr "\"Ed Hyland. Řekl světu, ať mu políbí...\""

#: dialog/zigengrv.msg:306
msgid "\"Eric Demilt. The TRUE Combat Boy.\""
msgstr "\"Eric Demilt. OPRAVDOVÝ bojovný hoch.\""

#: dialog/zigengrv.msg:307
msgid "\"Feargus Urquhart: Made just one damn list too many.\""
msgstr "\"Feargus Urquhart: Jeden zatracený seznam byl pro něj moc.\""

#: dialog/zigengrv.msg:308
msgid "\"Fred Hatch. Died getting Myron's voice recorded.\""
msgstr "\"Fred Hatch. Zemřel při nahrávání Myronova hlasu.\""

#: dialog/zigengrv.msg:309
msgid "\"Gary Platner. Killed for not making more Vault Citizen models.\""
msgstr "\"Gary Platner. Zabit kvůli tomu, že nevytvořil víc modelů obyvatel Vaultu.\""

#: dialog/zigengrv.msg:310
msgid "\"Jason Anderson: no longer a living god.\""
msgstr "\"Jason Anderson: Už není živoucí bůh.\""

#: dialog/zigengrv.msg:311
msgid "\"Jason G. Suinn.\""
msgstr "\"Jason G. Suinn.\""

#: dialog/zigengrv.msg:312
msgid "\"Jason Taylor.\""
msgstr "\"Jason Taylor.\""

#: dialog/zigengrv.msg:313
msgid "\"Jeremy Barnes. The bald headed monkey of Black Isle.\""
msgstr "\"Jeremy Barnes. Malá plešatá opička z Black Isle.\""

#: dialog/zigengrv.msg:314
msgid "\"Jesse Reynolds. Liked ginger snaps. Too much.\""
msgstr "\"Jesse Reynolds. Měl rád zázvorové sušenky. Až moc.\""

#: dialog/zigengrv.msg:315
msgid "\"John Deiley.\""
msgstr "\"John Deiley.\""

#: dialog/zigengrv.msg:316
msgid "\"John Price.\""
msgstr "\"John Price.\""

#: dialog/zigengrv.msg:317
msgid "\"Leonard Boyarski. Exile from Vault City.\""
msgstr "\"Leonard Boyarski. Vyhnán z Vault City.\""

#: dialog/zigengrv.msg:318
msgid "\"Rupert Dinkos, died Winter '00.\""
msgstr "\"Rupert Dinkos, zemřel v zimě '00.\""

#: dialog/zigengrv.msg:319
msgid "\"Matt Norton. He coulda been someone. He coulda been a contenda, instead of a bum, which is what he was.\""
msgstr "\"Matt Norton. Mohl být někdo. Mohl být boss a ne takový pobuda... kterým přesně byl.\""

#: dialog/zigengrv.msg:320
msgid "\"Nick Kesting.\" [There's a small bucket of round copper slugs on top.]"
msgstr "\"Nick Kesting.\" (Leží tu malý kyblík s měděnými kroužky proti slimákům.)"

#: dialog/zigengrv.msg:321
msgid "\"Robert Collier. Silent. Deadly. Rob.\""
msgstr "\"Robert Collier. Tichý. Smrtelný. Chmaták.\""

#: dialog/zigengrv.msg:322
msgid "\"Robert Hertenstein 2. His doctor tried to tell him, but he insisted, 'That's a bit too much information.'\""
msgstr "\"Robert Hertenstein 2. Jeho doktor mu to chtěl říct, ale on trval na tom, že 'To je na mě moc informací.'\""

#: dialog/zigengrv.msg:323
msgid "\"Scott Campbell. Not the soup.\""
msgstr "\"Scott Cambell. Polévku ne.\""

#: dialog/zigengrv.msg:324
msgid "\"Here lies Scott Everts. Late for work. Late for life.\""
msgstr "\"Zde leží Scott Everts. Pozdě do práce. Pozdě do života.\""

#: dialog/zigengrv.msg:325
msgid "\"Scott Rodenhizer. Built 3D heads.\""
msgstr "\"Scott Rodenhizer. Vytvořil 3D hlavy.\""

#: dialog/zigengrv.msg:326
msgid "\"Thomas French: Died while attempting to master the Flying Guillotine.\""
msgstr "\"Thomas French: Zemřel při pokusu ovládnout Flying Quillotine.\""

#: dialog/zigengrv.msg:327
msgid "\"Tim Cain. Founder, Lover, Fighter, Programmer.\""
msgstr "\"Tim Cain. Zakladatel, Milenec, Bojovník, Programátor.\""

#: dialog/zigengrv.msg:328
msgid "\"Tramell Ray Isaac: Hear lies one of the hardest working men in this business. Animator extraordinare(sp?). I think. R.I.P. T.Ray.\""
msgstr "\"Tramell Ray Isaac: Zde leží jeden z nejpilnějších lidí v branži. Neobyčejný animátor. Aspoň myslím. Odpočívej v pokoji, T. Ray.\""

#: dialog/zigengrv.msg:329
msgid "\"Zeb -- Still Older Than Dirt.\""
msgstr "\"Zeb -- starší než hlína sama.\""

#: dialog/zigengrv.msg:330
msgid "\"Dennis Presnell. We can almost hear him now. 'You call that a funeral?! That sucked! You guys are !@#holes! I'm never dying again! Blah blah blah...'\" Scratched below it says, \"God rest 'Cryin' D, shoulda kept on the patch.\""
msgstr "\"Dennis Presnell. Jako bychom ho teď slyšeli říkat: 'Tomu říkáte pohřeb?! Vždyť stál za hovno! Chlapi, vy jste hrozní k!@oti! Už radši nikdy nezemřu! Bla bla bla...'\" Pod tím je načmáráno: \"Odpočívej 'ubrečený' Dennisi, a drž hubu.\""

#: dialog/zigengrv.msg:331
msgid "\"Rupert Diukos, died 9/24/96.\""
msgstr "\"Rupert Diukos, zemřel 24.9.1996.\""

#: dialog/zigengrv.msg:332
msgid "\"Sal De Ban, died 9/24/96.\""
msgstr "\"Sal De Ban, zemřel 24.9.1996.\""

#: dialog/zigengrv.msg:333
msgid "\"Greg Zeschule, Fall '99.\""
msgstr "\"Greg Zeschule, podzim '99.\""

#: dialog/zigengrv.msg:334
msgid "\"Ray Muzyka, Summer '98.\""
msgstr "\"Ray Muzyka, léto '98.\""

#: dialog/zigengrv.msg:335
msgid "\"Evan Chantland, 74-??: He wasn't paranoid, they really were after him.\""
msgstr "\"Evan Chantland, 74-??: Nebyl paranoidní, opravdu po něm šli.\""

#: dialog/zigengrv.msg:336
msgid "\"Here lies Moose, cold and dead. We found him here, without his head.\""
msgstr "\"Zde leží Moose, studený a mrtvý. Našli jsme ho tu... bez hlavy.\""

#: dialog/zigengrv.msg:337
msgid "\"Amy Presnell.\""
msgstr "\"Amy Presnell\""

#: dialog/zigengrv.msg:338
msgid "\"Stephen Bokkes, age 25. Cut down in his prime by the slings and arrows of outrageous fortune.\" "
msgstr "\"Stephen Bokkes, věk 25. V mládí se nechal prostřílet a probodat šípy od té ohavné štěstěny.\" "

#: dialog/zigengrv.msg:339
msgid "\"R.I.P. Doug \"Skully\" Finch (Date does not matter) Killed for smoking in the French Market. Last words - 'Donkey Punches to ya!'\""
msgstr "\"Odpočívej v pokoji. Doug \"Lebkoun\" Finch (Datum není důležité) Zabit za kouření ve French Market. Jeho poslední slova: Aby vás osel nakop!'\""

#: dialog/zigengrv.msg:340
msgid "\"Here lies Donnie Cornwell, good and dead. In an extra large coffin to fit his extra large head.\""
msgstr "\"Zde leží Donnie Cornwell, dobrý a mrtvý muž. Ve speciální rakvi, do které se vešla jeho supervelká makovice.\""

#: dialog/zigengrv.msg:341
msgid "\"Rob Giampa lived his life like he liked his women: fast, cheap, and easy.\""
msgstr "\"Rob Giampa žil svůj život stejně jako miloval ženy: rychle, levně a snadno.\""

#: dialog/zigengrv.msg:342
msgid "\"T. D. Hamilton: Hear lies a stank hoe that should have been dead a long time ago. Rest in hell, BITCH!\""
msgstr "\"T. D. Hamilton: Zde leží ten parchant, který měl umřít mnohem, mnohem dřív. Odpočívej v Pekle, KRETÉNE!\""

#: dialog/zigengrv.msg:343
msgid "\"Another victim of the deadline.\""
msgstr "\"Další z obětí uzávěrky.\""

#: dialog/zigengrv.msg:344
msgid "\"Dogbomb is dead. Long live the Dog.\""
msgstr "\"Pes je mrtev. Ať žije Pes.\""

#: dialog/zigengrv.msg:345
msgid "\"Kris Snider: Too competitive.\""
msgstr "\"Kris Snider: Příliš soutěživý.\""

#: dialog/zigengrv.msg:346
msgid "\"Are you doing anything useful with your life?\""
msgstr "\"Děláš ve svém životě taky něco užitečného?\""

#: dialog/zigengrv.msg:347
msgid "\"Why not just kill yourself and save someone else the hassle?\""
msgstr "\"Proč se prostě rovnou nezabiješ a neušetříš tím někomu práci?\""

#: dialog/zigengrv.msg:348
msgid "\"Charles Cuevas: He once said, 'Give me hockey or give me death.' He didn't quite get hockey.\""
msgstr "\"Charles Cuevas: Jednou řekl: 'Chci hokej nebo smrt!' Hokej nedostal.\""

#: dialog/zigengrv.msg:349
msgid "\"William Lebus.\""
msgstr "\"William Lebus\""

#: dialog/zigengrv.msg:350
msgid "\"Reg Arnedo: we can still hear his voice in the halls.\""
msgstr "\"Reg Arnedo: na chodbách stále slyšíme jeho hlas.\""

#: dialog/zigengrv.msg:351
msgid "\"Shanna SanPaolo.\""
msgstr "\"Shanna SanPaolo\""

#: dialog/zigengrv.msg:352
msgid "\"Brahmin Wrangler.\""
msgstr "\"Honák brahmín.\""

#: dialog/zigengrv.msg:353
msgid "\"Josh Walters, 1971-2011. Died of complications during his fifth liver transplant.\""
msgstr "\"Josh Walters, 1971-2011. Zemřel na následek komplikací při páté transplantaci jater.\""

#: dialog/zigengrv.msg:354
msgid "\"Doug Avery. Hated the war for destroying his trailer park lifestyle.\""
msgstr "\"Doug Avery. Nesnášel válku za to, že zničila jeho životní styl obytných přívěsů stojících v parku.\""

#: dialog/zigengrv.msg:355
msgid "\"Here lies Ezekial Aikle, age 102. The good die young.\""
msgstr "\"Zde leží Ezekial Aikle, věk 102. Dobří lidé umírají mladí.\""

#: dialog/zigengrv.msg:356
msgid "\"Here lies Ann Mann, who lived an old maid but died an old Mann. Dec. 8, 1767\""
msgstr "\"Zde leží Anna Muzat - žila jako stará panna a zemřela jako stará mužatka. 8. Prosinec, 1767.\""

#: dialog/zigengrv.msg:357
msgid "\"The children of Israel wanted bread and the Lord sent them manna, old clerk Wallace wanted a wife, and the Devil sent him Anna.\""
msgstr "\"Děti Izraele chtěli chléb a bůh jim seslal manu. Starý úředník Wallace chtěl ženu a ďábel mu seslal Annu.\""

#: dialog/zigengrv.msg:359
msgid "\"Here lies the body of Jonathan Blake stepped on the gas instead of the brake.\""
msgstr "\"Zde leží tělo Jonathana Ozdy - sešlápl plyn místo brzdy.\""

#: dialog/zigengrv.msg:360
msgid "\"Here lays Butch, we planted him raw. He was quick on the trigger, but slow on the draw.\""
msgstr "\"Zde leží Butch, kterého jsme pohřbili tak, jak zemřel. Rychle mačkal spoušť, ale pomalu tasil.\""

#: dialog/zigengrv.msg:361
msgid "\"Sacred to the memory of my husband John Barnes who died January 3, 1803. His comely young widow, aged 23, has many qualifications of a good wife, and yearns to be comforted.\""
msgstr "\"Na památku mého manžela Johna Barnese, který zemřel 3. ledna 1803. Milá a mladá vdova, věk 23, která dovede být dobrou manželkou, hledá někoho, kdo by ji utěšoval.\""

#: dialog/zigengrv.msg:363
msgid "\"I was somebody. Who, is no business of yours.\""
msgstr "\"Byl jsem někdo. Kdo, po tom ti nic není.\""

#: dialog/zigengrv.msg:364
msgid "\"Here lies Lester Moore, four slugs from a .44, no less, no more.\""
msgstr "\"Zde leží Lester Moore se čtyřmi průstřely z .44. Nic víc, nic míň.\""

#: dialog/zigengrv.msg:365
msgid "\"I told you I was sick!\""
msgstr "\"Říkal jsem, že jsem nemocný!\""

#: dialog/zigengrv.msg:366
msgid "\"Reader if cash thou art in want of any dig 4 feet deep and thou wilt find a Penny.\""
msgstr "\"Toužíš-li mít spoustu peněz, kopej 4 stopy do hloubky a možná tam najdeš penci.\""

#: dialog/zigengrv.msg:367
msgid "\"She always said her feet were killing her but nobody believed her.\""
msgstr "\"Vždycky říkala, že jí ta bolest nohou snad zabije, ale nikdo jí nevěřil.\""

#: dialog/zigengrv.msg:368
msgid "\"On the 22nd of June - Jonathan Fiddle - Went out of tune.\""
msgstr "\"Dvaadvacátého června byl Jonathan Housle rozladěn.\""

#: dialog/zigengrv.msg:369
msgid "\"Here lies the body of our Anna done to death by a banana. It wasn't the fruit that laid her low but the skin of the thing that made her go.\""
msgstr "\"Zde leží tělo naší Anny, jenž dojela na banány. Nebylo to samotné ovoce, které ji zabilo, nýbrž slupka, po které uklouzla.\""

#: dialog/zigengrv.msg:370
msgid "\"Gone away Owen Moore than he could afford.\""
msgstr "\"Tom Daleký je dnes tak daleko, že už se nevrátí.\""

#: dialog/zigengrv.msg:371
msgid "\"In Memory of Little Chris Wood. Here lies one Wood enclosed in wood, one Wood within another. The outer wood is very good, though we cannot praise the other."
msgstr "\"Na památku malého Chrise Woody: Och, jak je nám líto Woody. Dali jsme ti tvoje chůdy, ať netrpí tvoje údy. Škoda, že jsi spadl z té půdy."

#: dialog/zigengrv.msg:372
msgid "\"Under the sod and under the trees lies the body of Jonathan Pease. He is not here, there's only the pod: Pease shelled out and went to God.\""
msgstr "\"Zde pod drnem a pod stromy leží tělo Viléma Pohromy. Za života to byl klasa. Bůh je nyní jeho spása.\""

#: dialog/zigengrv.msg:373
msgid "\"Who was fatally burned March 21, 1870 by the explosion of a lamp filled with \"R.E. Danforth's Non-Explosive Burning Fluid\".\""
msgstr "\"Neznámý muž - zcela spálen 21. března 1870 po explozi lampy naplněné \"R.E. Danforthovým, nevýbušným, hořícím roztokem.\""

#: dialog/zigengrv.msg:374
msgid "\"Born 1903 -- Died 1942. Looked up the elevator shaft to see if the car was on the way down. It was.\""
msgstr "\"Narozen 1903 -- zemřel 1942. Díval se do výtahové šachty, aby zjistil, jestli už jede dolů kabina. Jela.\""

#: dialog/zigengrv.msg:375
msgid "\"Here lies an Atheist all dressed up and no place to go.\""
msgstr "\"Zde leží ateista. Celý vystrojený a nemá kam jít.\""

#: dialog/zigengrv.msg:376
msgid "\"Eileen Suh: Went to W&M Law School, Now it's Eileen Sue.\""
msgstr "\"Vilém Mucha: Vystudoval práva na W&M univerzitě. Zemřel jako Vilém Mrcha.\""

#: dialog/zigengrv.msg:377
msgid "\"Sarah Smart: Orator, Author, Professor, De Amicitia.\""
msgstr "\"Sarah Smart: Řečník, Autorka, Profesorka. Znala cenu přátelství.\""

#: dialog/zigengrv.msg:378
msgid "\"Tim Winkle - I abide no hypocrisy but my own.\""
msgstr "\"Tim Winkle - Neuznávám žádného pokrytectví kromě svého.\""

#: dialog/zigengrv.msg:379
msgid "\"Jughead - King of Queen Archie's World.\""
msgstr "\"Dutohlav - Král Světa královny Pavoučnatky.\""

#: dialog/zigengrv.msg:380
msgid "\"R.I.P Casey Donahue. Died 8/6/98. Killed by Mutated Ill-Tempered Sea Bass.\""
msgstr "\"R.I.P Casey Donahue zemřel 6.8.1998 Byl zabit zmutovaným a nevrlým mořským okounem.\""

#: dialog/zigengrv.msg:381
msgid "\"Christopher 'Nightwing' Jones: administrator of the mushroom bruise.\""
msgstr "\"Christopher 'Noční pták' Jones: správce modřin po úderu penisem.\""

#: dialog/zigengrv.msg:382
msgid "\"Jay \"Potato Feet\" Nielson. Musician. Passed on at the age of 104, during a drum solo.\""
msgstr "\"Jay \"Bramborová noha\" Nielson. Hudebník. Zemřel ve věku 104 let, při bubnovém sólu.\""

#: dialog/zigengrv.msg:383
msgid "\"Nitsa - The reason Charles didn't quite get hockey.\""
msgstr "\"Nitsa - příčina toho, proč Charles nikdy nepochopil hokej.\""

#: dialog/zigengrv.msg:384
msgid "\"Thuy Dang. May God have mercy on his name.\""
msgstr "\"Thuy Dang. Bůh se smiluj nad jeho jménem.\""

#: dialog/zigengrv.msg:500
msgid "You skillfully set a trap in the grave."
msgstr "Zkušeně umisťuješ past na hrob."

#: dialog/zigengrv.msg:501
msgid "You fail to properly set the trap in the grave."
msgstr "Nepovedlo se ti umístit past na hrob."

#: dialog/zigengrv.msg:510
msgid " skillfully sets a trap in the grave."
msgstr " zkušeně umisťuje past na hrob."

#: dialog/zigengrv.msg:511
msgid " fails to properly set the trap in the grave."
msgstr " nedokáže umístit past na hrob."

#: dialog/zigengrv.msg:515
msgid "You find a trap on the grave."
msgstr "Na hrobě objevuješ past."

#: dialog/zigengrv.msg:516
msgid "You do not find any traps on the grave."
msgstr "Na hrobě neobjevuješ žádné pasti."

#: dialog/zigengrv.msg:520
msgid " finds a trap on the grave."
msgstr " objevuje na hrobě past."

#: dialog/zigengrv.msg:521
msgid " does not find any traps on the grave."
msgstr " neobjevuje na hrobě žádné pasti."

#: dialog/zigengrv.msg:531
msgid " fail to disarm the trap."
msgstr " nedokáže odstranit past."

#: dialog/zilocker.msg:100
msgid "You successfully disable the lock."
msgstr "Úspěšně odemykáš zámek."

#: dialog/zilocker.msg:101
msgid "You fail to disable the lock."
msgstr "Nezdařilo se. Zámek je stále zamčený."

#: dialog/zilocker.msg:102
msgid "You successfully lock the object."
msgstr "Úspěšně zamykáš zámek."

#: dialog/zilocker.msg:103
msgid "You fail to lock the object."
msgstr "Nepodařilo se ti zamknout zámek."

#: dialog/zilocker.msg:200
msgid " successfully disabled the lock."
msgstr " odemyká zámek."

#: dialog/zilocker.msg:201
msgid " fails to disable the lock."
msgstr " byl úspěšný při odemykání zámku."

#: dialog/zilocker.msg:202
msgid " successfully locked the object."
msgstr " zamyká zámek."

#: dialog/zilocker.msg:203
msgid " fails to lock the object."
msgstr " byl úspěšný při zamykání zámku."

#: dialog/zilocker.msg:300
msgid "The explosion destroys the lock on the object."
msgstr "Exploze zničila zámek."

#: dialog/zilocker.msg:301
msgid "The explosion fails to remove the lock from the object."
msgstr "Ani exploze nepomohla odstranit zámek."

#: dialog/zilocker.msg:400
msgid "You successfully pry open the lock on the object."
msgstr "Podařilo se ti vypáčit zámek."

#: dialog/zilocker.msg:401
msgid "You fail to pry the lock on the object open."
msgstr "Nepodařilo se ti vypáčit zámek."

#: dialog/zilocker.msg:500
msgid " successfully pried open the lock on the object."
msgstr " byl úspěšný při páčení zámku."

#: dialog/zilocker.msg:501
msgid " fails to pry the lock on the object open."
msgstr " nebyl úspěšný při páčení zámku."

#: dialog/zinuke.msg:100
msgid "You see a Nuka-Cola machine. You wonder if it still works."
msgstr "Vidíš automat na Nuka-Colu. Zajímalo by tě, jestli ještě funguje."

#: dialog/zinuke.msg:101
msgid "[thunk thunk chaching... sheeew]"
msgstr "(Ťuk klep ciiinnnk... pssssššš)"

#: dialog/zinuke.msg:102
msgid "You get a not so fresh bottle of Nuka-Cola."
msgstr "Dostáváš ne zrovna čerstvou plechovku Nuka-Coly."

#: dialog/zinuke.msg:103
msgid "Dooohhhh!"
msgstr "Uuuuffff!"

