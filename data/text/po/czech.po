#: dialog/gsterm.msg:544
msgid "Delete all commands."
msgstr "Smazat všechny příkazy."

#: dialog/gsterm.msg:545
msgid "Execute program."
msgstr "Spustit program."

#: dialog/gsterm.msg:550
msgid "Back to Main Menu."
msgstr "Zpět do hlavního menu."

#: dialog/gsterm.msg:600
msgid "Select a command:"
msgstr "Vyber příkaz:"

#: dialog/gsterm.msg:601
msgid "Calibrate Uranium-Rod Driver."
msgstr "Zkalibrovat uranové palivové tyče."

#: dialog/gsterm.msg:602
msgid "Amplify Plutonium-Gamma Shield."
msgstr "Zvětšit plutoniový gamma štít."

#: dialog/gsterm.msg:603
msgid "Set Voltage on Saturn-Class Capacitor."
msgstr "Nastavit voltáž saturnového kondenzátoru."

#: dialog/gsterm.msg:604
msgid "Deharmonize Neptunium Impeller."
msgstr "Zharmonizovat neptunový rotor."

#: dialog/gsterm.msg:605
msgid "Test Jupiter Wave Compiler."
msgstr "Otestovat jupiterový vlnový kompilátor."

#: dialog/gsterm.msg:606
msgid "Install Hydroelectric Magnetosphere Regulator."
msgstr "Nainstalovat hydroelektrický regulátor magnetosféry."

#: dialog/gsterm.msg:607
msgid "Turn Main Coolant Valve-Off."
msgstr "Vypnout hlavní uzávěr chladícího systému."

#: dialog/gsterm.msg:608
msgid "Turn Main Coolant Valve-On."
msgstr "Zapnout hlavní uzávěr chladícího systému."

