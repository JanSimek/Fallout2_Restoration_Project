msgid "This large door is the link between the vault and the outside world. It has been scorched by a tremendous blast."
msgstr "Tyto velké dveře jsou jedinou spojnicí mezi vaultem a vnějším světem. Byly sežehnuty obrovským výbuchem."

#: game/pro_scen.msg:210301
msgid "The cave appears to open up into a larger network of caves."
msgstr "Zdá se, že jeskyně ústí do většího komplexu jeskyní."

#: game/pro_scen.msg:210500 game/pro_scen.msg:210600 game/pro_scen.msg:211400
#: game/pro_scen.msg:212900
msgid "Rusting Boat"
msgstr "Rezivějící loď"

