#: dialog/csvent.msg:101
msgid "You see a camouflaged ventilation shaft."
msgstr "Zamaskovaná ventilační šachta."

#: dialog/csvent.msg:102 game/proto.msg:493
msgid "You see nothing out of the ordinary."
msgstr "Nic zvláštního nevidíš."

#: dialog/csvent.msg:120
