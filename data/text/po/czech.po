#: dialog/cctech2.msg:139 dialog/dcsmitty.msg:501 dialog/ockerith.msg:122
#: dialog/rcjane.msg:204
msgid "I understand."
msgstr "Rozumím."

#: dialog/actemvil.msg:133
msgid "Very well. Shall we begin?"
msgstr "Výborně. Můžeme začít?"

#: dialog/actemvil.msg:134
msgid "Me ready."
msgstr "Já chtít bojovat."

#: dialog/actemvil.msg:136
msgid "I'm ready."
msgstr "Můžeme začít."

#: dialog/actemvil.msg:137
msgid "No, I need some time to prepare."
msgstr "Ne, potřebuju trochu času na přípravu."

#: dialog/actemvil.msg:138
msgid "Very well. Return and tell me when you are ready for your challenge."
msgstr "Tak dobře. Až se připravíš, vrať se sem a dej mi vědět."

#: dialog/actemvil.msg:139
msgid "Are you ready for your challenge, "
msgstr "Můžeme začít s tvojí zkouškou, "

#: dialog/actemvil.msg:140 dialog/dcmetzge.msg:1361 dialog/dcmetzge.msg:1365
