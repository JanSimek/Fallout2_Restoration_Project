#: game/pro_scen.msg:225601
msgid "A large pile of glowing rocks."
msgstr "Hromádka zářících kamenů."

#: game/pro_scen.msg:225701
msgid "A very large pile of glowing rocks. They look dangerous just sitting there."
msgstr "Velká hromada zářících kamenů. Vypadají nebezpečně i když jen tak leží."

