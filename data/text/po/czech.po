#: game/pro_scen.msg:67401 game/pro_scen.msg:67501 game/pro_scen.msg:67601
#: game/pro_scen.msg:67701
msgid "A very nice looking chair."
msgstr "Hezká židle."

#: game/pro_scen.msg:67801 game/pro_scen.msg:67901 game/pro_scen.msg:68001
#: game/pro_scen.msg:68101
msgid "A very nice looking bed."
msgstr "Hezká postel."

#: game/pro_scen.msg:68200 game/pro_scen.msg:68300 game/pro_scen.msg:68400
#: game/pro_scen.msg:68500 game/pro_scen.msg:182200 game/pro_scen.msg:182300
#: game/pro_scen.msg:182400 game/pro_scen.msg:182500
msgid "Stove"
msgstr "Kamna"

#: game/pro_scen.msg:68201 game/pro_scen.msg:68301 game/pro_scen.msg:68401
#: game/pro_scen.msg:68501
msgid "A functional wood-burning stove."
msgstr "Funkční kamna na dřevo."

#: game/pro_scen.msg:68600
msgid "Broken Post"
msgstr "Zničený stojan"

#: game/pro_scen.msg:68700 game/pro_wall.msg:115500 game/pro_wall.msg:115600
msgid "Destroyed Entrance"
msgstr "Zřícený vchod"

#: game/pro_scen.msg:68801 game/pro_scen.msg:68901
msgid "A large formation of rocks. This was not a natural occurrence."
msgstr "Velká hromada kamení. Tento zával rozhodně nevznikl přirozenou cestou."

#: game/pro_scen.msg:69001
msgid "A crude, but effective, toilet. There are some leaves dropped into the hole to manage the odor."
msgstr "Primitivní, ale provozuschopná toaleta. V díře je položeno několik listů nějaké rostliny na potlačení zápachu."

#: game/pro_scen.msg:69101 game/pro_scen.msg:69201 game/pro_scen.msg:69301
#: game/pro_scen.msg:69401 game/pro_scen.msg:69501 game/pro_scen.msg:69601
#: game/pro_scen.msg:207901 game/pro_scen.msg:208001
msgid "These mountain walls look very inaccessible."
msgstr "Tato skalní stěna vypadá velmi nepřístupně."

