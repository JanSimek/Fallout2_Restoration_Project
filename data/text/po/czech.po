#: dialog/zislots.msg:2101
msgid "Me "
msgstr "Já "

#: dialog/abelaine.msg:701
msgid ". Who you?"
msgstr ". Kdo ty?"

#: dialog/abelaine.msg:710
msgid "Hehe. That pretty name."
msgstr "Hehe. To hezké jméno."

#: dialog/abelaine.msg:711 dialog/bcjones.msg:207 dialog/fcbadger.msg:124
#: dialog/fcgunmer.msg:115 dialog/fcjuavki.msg:117 dialog/fcjuavki.msg:183
#: dialog/hcoutfit.msg:123 dialog/hcphil.msg:183 dialog/hctyphon.msg:118
#: dialog/tribec1.msg:841 dialog/tribec1.msg:851 dialog/tribec6.msg:104
msgid "Bye!"
msgstr "Čau!"

#: dialog/abelaine.msg:720
msgid "You're a special little guy aren't you? Could you do me a BIG favor and be my special helper today?"
msgstr "Ty jsi ale milý klučík, že? Udělal bys mi VELKOU laskavost a byl dnes mým zvláštním pomocníkem?"

#: dialog/abelaine.msg:721
msgid "You're a special little gal aren't you? Could you do me a BIG favor and be my special helper today?"
msgstr "Ty jsi ale milá děvenka, že? Udělala bys mi VELKOU laskavost a byla dnes mým zvláštním pomocníkem?"

#: dialog/abelaine.msg:722
msgid "Me special. Me help."
msgstr "Já zvláštní. Já pomoct."

#: dialog/abelaine.msg:723
msgid "Me no wanna help."
msgstr "Já nechtít pomoct."

#: dialog/abelaine.msg:730
msgid "Really? Great! Please give this machine part to Max in the copying room. He can be found in the BASEMENT. Okay?"
msgstr "Vážně? Skvěle! Prosím, dej tuhle součástku Maxovi v tiskárně. Najdeš ho ve SKLEPĚ. Ano?"

#: dialog/abelaine.msg:731
msgid "I no let you down!"
msgstr "Já tě nezklamat!"

#: dialog/abelaine.msg:740
msgid "You keep on truckin' now."
msgstr "Pokračuj, vedeš si dobře."

#: dialog/abgrave1.msg:100 dialog/abgrave2.msg:100 dialog/abgrave3.msg:100
#: dialog/zigengrv.msg:201
msgid "You see a grave marker."
msgstr "Vidíš náhrobek."

#: dialog/abgrave1.msg:101 dialog/zigengrv.msg:276
msgid "The grave marker reads: "
msgstr "Na kříži stojí: "

#: dialog/abgrave1.msg:102
msgid "\"Here lies Brother Gregory. A man who knew no limits.\""
msgstr "\"Ateista. Celý nastrojený a přitom nemá kam jít.\""

#: dialog/abgrave1.msg:103
msgid "\"Aunt Patty. Good riddance indeed.\""
msgstr "\"Zde leží potulný nožíř Toady. Říkali mu \"Mačeta\". Dostal nabídku, která se neodmítá. Podveden a zrazen, ponechán napospas smrti, stanul tváří tvář deseti nájezdníkům. Měl u sebe jen devět vrhacích nožů.\""

#: dialog/abgrave1.msg:104
msgid "\"Here lies Per Joner. Died one rock too short.\""
msgstr "\"Zde leží Per Joner. Zemřel a chyběl mu jen jediný kámen.\""

#: dialog/abgrave1.msg:105
msgid "\"Here lies Father Michael. Founder, Father, Fighter.\""
msgstr "\"Zde odpočívá otec Paul a sestra Tina. Žili spolu, modlili se spolu a společně i skonali. Byla to siamská dvojčata.\""

#: dialog/abgrave1.msg:106
msgid "\"An Atheist. All dressed up and no place to go.\""
msgstr "\"Bratr Bardun. Muž, který neznal žádné limity. Vypil 5 litrů pálenky a snažil se holýma rukama roztrhat párače. Trvalo týden, než jsme našli něco, co jsme mohli pohřbít.\""

#: dialog/abgrave1.msg:107 dialog/zigengrv.msg:358
msgid "\"Here lies Johnny Yeast. Pardon me for not rising.\""
msgstr "\"To je Johnny Yeast. Omluvte ho, že při vašem příchodu zůstane ležet.\""

#: dialog/abgrave1.msg:108
msgid "\"Mary Jane. Loving wife and mother.\""
msgstr "\"Zde odpočívá bratr Cousino. Celý život se všemu divil. Naposledy se strašně divil tomu, že už umírá. Bylo mu 126 let.\""

#: dialog/abgrave1.msg:109
msgid "\"'Checkmate!' was the call to dear old Jon, On the chessboard of life, He was just a pawn."
msgstr "\"Zde odpočívá Mark Fisherman. Zemřel na vykrvácení, když si pro sušenku nechal vrtat koleno.\""

#: dialog/abgrave1.msg:110 dialog/zigengrv.msg:362
msgid "\"Sir John Strange, here lies an honest lawyer, and that is Strange.\""
msgstr "\"Zde leží Sir John Divný. Byl to čestný právník a to je Divný.\""

#: dialog/abgrave1.msg:111
msgid "\"Tears cannot restore her -- therefore I weep.\""
msgstr "\"Zde leží Petuel Schmink. Miloval svůj kožený plášť, vypelichaného čokla a upilovanou brokovnici. Bohužel ji držel naopak, když vystřelil.\""

#: dialog/abgrave1.msg:112
msgid "\"Every day in every way, I am getting better and better.\""
msgstr "\"Zde leží Johny Slider, nadaný mladý mechanik. Pracoval na zdokonaleném lékařském Auto-Doku. Těsně před dokončením se však na něj zřítil.\""

#: dialog/abgrave1.msg:250 dialog/zigengrv.msg:260
msgid "There are no markings on this grave marker."
msgstr "Na tomto kříži není nic vyryto."

#: dialog/abgrave1.msg:251
msgid "The grave marker is too cracked and broken to be read."
msgstr "Tento náhrobek je příliš rozbitý a popraskaný, než aby se z něho dalo číst."

#: dialog/abgrave1.msg:252 dialog/zigengrv.msg:262
msgid "The name on the grave marker reads John Doe."
msgstr "Na kříži je jméno John Doe."

#: dialog/abgrave1.msg:253 dialog/zigengrv.msg:253 dialog/zigengrv.msg:263
msgid "The name and date on this headstone have been worn off by the weather."
msgstr "Jméno a datum na tomto kříži je zašlé vlivem počasí."

#: dialog/abgrave2.msg:101
msgid "Here lies the great Per: Author, walkthrough creator, rock hoarder. Alas, he died one rock too short."
msgstr "Zde leží velký Per: Autor, tvůrce návodu, sběratel kamenů. Bohužel zemřel, když mu chyběl už jenom jeden kámen."

#: dialog/abgrave3.msg:101
msgid ""
"Here lies the great Per: Author, walkthrough creator, rock hoarder. Alas, he died one rock too short. Last words:\n"
" \"Just one more steal check and I'll have all the rocks in th-.\""
msgstr "Zde leží velký Per: Autor, tvůrce návodu, sběratel kamenů. Bohužel zemřel, když mu chyběl už jenom jeden kámen. Jeho poslední slova: \"Už jenom jedna krádež a budu mít všechny kameny ve...\""

#: dialog/abguard.msg:100
msgid "You see a Tough Guard."
msgstr "Vidíš drsného strážce."

#: dialog/abguard.msg:101
msgid ""
"You see an impressively muscled, but aging guard with sun burnt skin. He must have been quite something in his\n"
" prime. His piercing gaze seems to follow you everywhere."
msgstr "Vidíš stárnoucí stráž s úžasnou muskulaturou a spálenou kůží od slunce. Dřív to musel být někdo. Jeho pronikavý pohled tě všude sleduje."

#: dialog/abguard.msg:200
msgid "Hi there, traveler. Welcome to the Abbey. Keep your nose clean and we'll get along just fine."
msgstr "Zdravím, poutníku. Vítej v Opatství. Nedělej potíže a budeme spolu dobře vycházet."

#: dialog/abguard.msg:201
msgid ""
"I'm watching you, slaver. One wrong move and you'll be tainting our graveyard for the rest of eternity.\n"
" I wouldn't wish that on you, and I'm fairly sure you wouldn't enjoy that either, so don't get any funny ideas in that\n"
" warped brain of yours."
msgstr "Mám tě stále na očích, otrokáři. Jeden špatný pohyb a budeš kazit náš hřbitov na věky věků. Nepřeju ti to a jsem si docela jistý, že ani tobě by se to nelíbilo, takže ať tě nenapadne nějaká blbost v té tvojí pokřivené mysli."

